{
  "name": "argus",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @argus/dashboard dev --host=0.0.0.0",
    "build": "pnpm -r build",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && node --test integrations/nanoclaw/gitea-api.test.mjs integrations/nanoclaw/github-api.test.mjs integrations/nanoclaw/argus-task.test.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "undici": "8.12.3",
    "typescript": "^5.6.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
