{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/.pnpm-store/**",
      "!**/.argus-delegate-runtime/**",
      "!**/.argus-delegate/**",
      "!pnpm-lock.yaml",
      "!uv.lock",
      "!packages/api-client/openapi.json",
      "!packages/api-client/src/schema.d.ts",
      "!apps/api/bench/results/**",
      "!docs/reports/artifacts/**"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "rules": {
      "preset": "none"
    }
  }
}
