ursor\",\napps/api/src/argus_api/tasks/routes.py:410:    Up to 200 lines of 2000 characters (longer ones are cut) and 64 KiB per batch,\napps/api/src/argus_api/tasks/routes.py:411:    one batch per second per source. Secrets are redacted before storing; the\napps/api/src/argus_api/tasks/routes.py:412:    batch is published as a `task.log` event and stored in a ring of 2000 lines\napps/api/src/argus_api/tasks/views.py:352:    \"\"\"A batch read in the order asked; unknown ids come back in `missing`.\npackages/core/src/argus_core/accounts.py:541:    # Idempotency: built by the client from task+agent+engine+start. A repeat adds no row.\npackages/core/src/argus_core/fleet.py:564:    # Required: the pool name is the idempotency key, so a retry cannot create a\npackages/core/src/argus_core/tasks.py:508:        None  # last accepted live-log batch (task-live-log spec)\ndocs/drafts/2026-10-14.worker-lifecycle.draft.md\ndocs/drafts/2026-10-29.task-operations.draft.md\ndocs/research/2026-10-29.bounded-recovery.research.md\ndocs/runbooks/2026-10-17.project-agent-images.ref.md\ndocs/specs/codex-sandbox-profile.spec.md\ndocs/specs/gitea-helper.spec.md\ndocs/specs/task-steering.spec.md\ndocs/specs/worker-launch.spec.md\ndocs/specs/worker-lifecycle.spec.md","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01PyxoMaHiwH5T8eT7LBCRWi","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
