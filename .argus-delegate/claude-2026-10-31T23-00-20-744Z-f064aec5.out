{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CrwUXnCKDyyj2Hhaf3UetQ","type":"tool_result","content":"ADMIN_TOKEN = \"test-admin-token-\" + \"m\" * 32\n_ids = itertools.count(1)\n\n\n@pytest.fixture\ndef client(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> Generator[TestClient]:\n    monkeypatch.setenv(\"ARGUS_DATA_DIR\", str(tmp_path))\n    monkeypatch.setenv(\"ARGUS_ADMIN_TOKEN\", ADMIN_TOKEN)\n    with TestClient(app) as c:\n        yield c\n\n\ndef rpc(\n    client: TestClient, token: str | None, method: str, params: dict | None = None\n) -> dict:\n    # Host must be on the MCP DNS-rebinding allowlist (security-hardening spec).\n    headers = {\"Accept\": \"application/json, text/event-stream\", \"Host\": \"127.0.0.1\"}\n    if token:\n        headers[\"Authorization\"] = f\"Bearer {token}\"\n    res = client.post(\n        \"/mcp\",\n        headers=headers,\n        json={\n            \"jsonrpc\": \"2.0\",\n            \"id\": next(_ids),\n            \"method\": method,\n            \"params\": params or {},\n        },\n    )\n    assert res.status_code == 200, res.text\n    return res.json()[\"result\"]\n\n\ndef tool(client: TestClient, token: str | None, name: str, /, **arguments) -> dict:\n    \"\"\"Call a tool; return {\"error\": text} or the structured result.\"\"\"\n    result = rpc(client, token, \"tools/call\", {\"name\": name, \"arguments\": arguments})\n    text = result[\"content\"][0][\"text\"] if result[\"content\"] else \"\"\n    if result[\"isError\"]:\n        return {\n            \"error\": text.split(\": \", 1)[1]\n            if text.startswith(\"Error executing\")\n            else text\n        }\n    if \"structuredContent\" in result:\n        return result[\"structuredContent\"].get(\"result\", result[\"structuredContent\"])\n    return json.loads(text)\n\n\ndef register(client: TestClient, role: str = \"worker\") -> str:\n    h = {\"Authorization\": f\"Bearer {ADMIN_TOKEN}\"}\n    boot = client.post(\n        \"/api/agents/bootstrap-tokens\", json={\"role\": role}, headers=h\n    ).json()\n    return client.post(\n        \"/api/agents/register\", json={\"bootstrap_token\": boot[\"token\"]}\n    ).json()[\"token\"]\n\n\ndef test_tools_are_listed_with_descriptions(client: TestClient) -> None:\n    orchestrator = register(client, \"orchestrator\")\n    tools = {t[\"name\"]: t for t in rpc(client, orchestrator, \"tools/list\")[\"tools\"]}\n    admin = {t[\"name\"] for t in rpc(client, ADMIN_TOKEN, \"tools/list\")[\"tools\"]}\n    assert set(tools) | admin == set(mcp_server.audiences)  # each has an audience\n    for name, t in tools.items():\n        assert t[\"description\"], name\n    assert \"task_id\" in tools[\"complete_task\"][\"inputSchema\"][\"properties\"]\n\n\ndef listed(client: TestClient, token: str) -> set[str]:\n    return {t[\"name\"] for t in rpc(client, token, \"tools/list\")[\"tools\"]}\n\n\ndef test_tools_are_listed_by_scope(client: TestClient) -> None:\n    by_scope = {\n        Scope.WORKER: listed(client, register(client)),\n        Scope.ORCHESTRATOR: listed(client, register(client, \"orchestrator\")),\n        Scope.ADMIN: listed(client, ADMIN_TOKEN),\n    }\n    for scope, names in by_scope.items():\n        assert names == {n for n, a in mcp_server.audiences.items() if scope in a}\n    assert \"claim_task\" in by_scope[Scope.WORKER]\n# -- HTTP and MCP -------------------------------------------------------------------\n\nADMIN = {\"Authorization\": f\"Bearer {ADMIN_TOKEN}\"}\n\n\n@pytest.fixture\ndef client(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> Generator[TestClient]:\n    monkeypatch.setenv(\"ARGUS_DATA_DIR\", str(tmp_path))\n    monkeypatch.setenv(\"ARGUS_ADMIN_TOKEN\", ADMIN_TOKEN)\n    with TestClient(app) as c:\n        yield c\n\n\ndef test_stuck_dependents_show_in_the_inbox_and_are_released_over_mcp(\n    client: TestClient,\n) -> None:\n    def new(**kw) -> dict:\n        res = client.post(\n            \"/api/tasks\", json={\"project\": \"global\", \"title\": \"t\", **kw}, headers=ADMIN\n        )\n        assert res.status_code == 201, res.text\n        return res.json()\n\n    dep = new()\n    client.post(f\"/api/tasks/{dep['id']}/cancel\", headers=ADMIN).raise_for_status()\n    stuck = new(depends_on=[dep[\"id\"]])\n    new(depends_on=[new()[\"id\"]])  # pending on a ready task: not stuck\n\n    page = client.get(\"/api/inbox\", headers=ADMIN).json()\n    [row] = page[\"items\"]\n    assert (row[\"subject_id\"], row[\"state\"], row[\"failed_dependencies\"]) == (\n        stuck[\"id\"],\n        \"pending\",\n        [dep[\"id\"]],\n    )\n    assert row[\"decision_id\"] is None\n    assert page[\"totals_by_state\"] == {\"pending\": 1}\n    assert page[\"totals_by_decision_kind\"] == {\"none\": 1}\n    only = client.get(\"/api/inbox\", params={\"state\": \"blocked\"}, headers=ADMIN)\n    assert only.json()[\"total\"] == 0\n\n    worker = {\"Authorization\": f\"Bearer {register(client)}\"}\n    body = {\"depends_on\": [], \"expected_version\": row[\"version\"]}\n    refused = client.put(\n        f\"/api/tasks/{stuck['id']}/dependencies\", json=body, headers=worker\n    )\n    assert refused.status_code == 403\n\n    orchestrator = register(client, \"orchestrator\")\n    released = tool(\n        client,\n        orchestrator,\n        \"set_task_dependencies\",\n        task_id=stuck[\"id\"],\n        depends_on=[],\n        expected_version=row[\"version\"],\n    )\n    assert (released[\"state\"], released[\"depends_on\"]) == (\"ready\", [])\n    assert client.get(\"/api/inbox\", headers=ADMIN).json()[\"total\"] == 0\n    events = client.get(\n        \"/api/events\", params={\"subject_id\": stuck[\"id\"]}, headers=ADMIN\n    ).json()\n    changed = next(e for e in events if e[\"kind\"] == \"task.dependencies_changed\")\n    assert changed[\"data\"] == {\"added\": [], \"removed\": [dep[\"id\"]]}\n64-async def test_0004_rebuild_keeps_existing_tokens(tmp_path: Path) -> None:\n65-    path = tmp_path / \"argus.db\"\n66-    migrations = load_migrations()\n67:    db = await Database.open(path, migrations=migrations[:3])\n68-    async with db.write() as tx:\n69-        await tx.conn.execute(\n70-            \"INSERT INTO tokens (id, token_hash, kind, role, created_by, created_at)\"\n71-            \" VALUES ('t1', 'h1', 'bootstrap', 'worker', 'x', 'now')\"\n72-        )\n73-    await db.close()\n74-    db = await Database.open(path, migrations=migrations)\n75-    async with (\n76-        db.read() as conn,\n77-        conn.execute(\"SELECT id, kind, label FROM tokens\") as cur,\n78-    ):\n79-        rows = [tuple(r) for r in await cur.fetchall()]\n80-    await db.close()\n81-    assert rows == [(\"t1\", \"bootstrap\", None)]\n82-\n83-\n84-async def test_0057_marks_pending_steers_dispatched(tmp_path: Path) -> None:\n85-    path = tmp_path / \"argus.db\"\n86-    migrations = load_migrations()\n87:    db = await Database.open(path, migrations=migrations[:56])\n88-    await insert_agent(db, \"a\")\n89-    async with db.write() as tx:\n90-        # claim writes a column that a later migration adds; borrow it for the setup\n91-        await tx.conn.execute(\"ALTER TABLE tasks ADD COLUMN session_gone_at TEXT\")\n92-        await tx.conn.execute(\"ALTER TABLE tasks ADD COLUMN paused_disk_at TEXT\")\n93-        task = await tasks.create_task(\n94-            tx, TaskCreate(project=\"global\", title=\"t\"), \"admin:test\"\n95-        )\n96-        await tasks.claim(tx, \"a\", [])\n97-        await tx.conn.execute(\"ALTER TABLE tasks DROP COLUMN session_gone_at\")\n98-        await tx.conn.execute(\"ALTER TABLE tasks DROP COLUMN paused_disk_at\")\n99-        await tx.conn.execute(\n100-            \"UPDATE agents SET runtime = '{\\\"features\\\": [\\\"steer\\\"]}' WHERE id = 'a'\"\n101-        )\n102-        waiting = await steers.create(tx, task.id, \"waiting\", \"admin:test\")\n103-        await tx.conn.execute(\n104-            \"INSERT INTO task_steers (id, task_id, attempt, agent_id, message, actor,\"\n105-            \" state, created_at, delivered_at) VALUES ('done', ?, 1, 'a', 'x',\"\n106-            \" 'admin:test', 'delivered', ?, ?)\",\n107-            (task.id, ts(tx.now), ts(tx.now)),\n108-        )\n109-    await db.close()\n110-\n111-    for _ in range(2):  # the upgrade, then a reopen that must change nothing\n112-        db = await Database.open(path, migrations=migrations)\n--\n248-async def test_0060_upgrade_keeps_data_and_reopen_is_a_no_op(tmp_path: Path) -> None:\n249-    path = tmp_path / \"argus.db\"\n250-    migrations = load_migrations()\n251:    assert migrations[59].name == \"0060_account_auth_health_indexes.sql\"\n252:    db = await Database.open(path, migrations=migrations[:59])\n253-    [account_id] = await _accounts(db, \"claude-1\")\n254-    await _fill(db, [account_id], 3)\n255-    await db.close()\n256-    assert await _user_version(path) == 59\n257-\n258-    for _ in range(2):  # the upgrade, then a reopen that must change nothing\n259-        db = await Database.open(path, migrations=migrations)\n260-        async with db.read() as conn:\n261-            async with conn.execute(\n262-                \"SELECT name, sql FROM sqlite_master WHERE type = 'index'\"\n263-                \" AND name IN (?, ?) ORDER BY name\",\n264-                AUTH_HEALTH_INDEXES,\n265-            ) as cur:\n266-                indexes = [tuple(r) for r in await cur.fetchall()]\n267-            acct = await accounts_service.get_account(","is_error":false}]},"parent_tool_use_id":null,"session_id":"e60805ed-c36d-4e22-8274-acc0a44d64d1","uuid":"ae6068c4-a916-4f57-8842-6d7b745f891f","timestamp":"2026-10-31T23:08:06.232Z","tool_use_result":{"stdout":"ADMIN_TOKEN = \"test-admin-token-\" + \"m\" * 32\n_ids = itertools.count(1)\n\n\n@pytest.fixture\ndef client(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> Generator[TestClient]:\n    monkeypatch.setenv(\"ARGUS_DATA_DIR\", str(tmp_path))\n    monkeypatch.setenv(\"ARGUS_ADMIN_TOKEN\", ADMIN_TOKEN)\n    with TestClient(app) as c:\n        yield c\n\n\ndef rpc(\n    client: TestClient, token: str | None, method: str, params: dict | None = None\n) -> dict:\n    # Host must be on the MCP DNS-rebinding allowlist (security-hardening spec).\n    headers = {\"Accept\": \"application/json, text/event-stream\", \"Host\": \"127.0.0.1\"}\n    if token:\n        headers[\"Authorization\"] = f\"Bearer {token}\"\n    res = client.post(\n        \"/mcp\",\n        headers=headers,\n        json={\n            \"jsonrpc\": \"2.0\",\n            \"id\": next(_ids),\n            \"method\": method,\n            \"params\": params or {},\n        },\n    )\n    assert res.status_code == 200, res.text\n    return res.json()[\"result\"]\n\n\ndef tool(client: TestClient, token: str | None, name: str, /, **arguments) -> dict:\n    \"\"\"Call a tool; return {\"error\": text} or the structured result.\"\"\"\n    result = rpc(client, token, \"tools/call\", {\"name\": name, \"arguments\": arguments})\n    text = result[\"content\"][0][\"text\"] if result[\"content\"] else \"\"\n    if result[\"isError\"]:\n        return {\n            \"error\": text.split(\": \", 1)[1]\n            if text.startswith(\"Error executing\")\n            else text\n        }\n    if \"structuredContent\" in result:\n        return result[\"structuredContent\"].get(\"result\", result[\"structuredContent\"])\n    return json.loads(text)\n\n\ndef register(client: TestClient, role: str = \"worker\") -> str:\n    h = {\"Authorization\": f\"Bearer {ADMIN_TOKEN}\"}\n    boot = client.post(\n        \"/api/agents/bootstrap-tokens\", json={\"role\": role}, headers=h\n    ).json()\n    return client.post(\n        \"/api/agents/register\", json={\"bootstrap_token\": boot[\"token\"]}\n    ).json()[\"token\"]\n\n\ndef test_tools_are_listed_with_descriptions(client: TestClient) -> None:\n    orchestrator = register(client, \"orchestrator\")\n    tools = {t[\"name\"]: t for t in rpc(client, orchestrator, \"tools/list\")[\"tools\"]}\n    admin = {t[\"name\"] for t in rpc(client, ADMIN_TOKEN, \"tools/list\")[\"tools\"]}\n    assert set(tools) | admin == set(mcp_server.audiences)  # each has an audience\n    for name, t in tools.items():\n        assert t[\"description\"], name\n    assert \"task_id\" in tools[\"complete_task\"][\"inputSchema\"][\"properties\"]\n\n\ndef listed(client: TestClient, token: str) -> set[str]:\n    return {t[\"name\"] for t in rpc(client, token, \"tools/list\")[\"tools\"]}\n\n\ndef test_tools_are_listed_by_scope(client: TestClient) -> None:\n    by_scope = {\n        Scope.WORKER: listed(client, register(client)),\n        Scope.ORCHESTRATOR: listed(client, register(client, \"orchestrator\")),\n        Scope.ADMIN: listed(client, ADMIN_TOKEN),\n    }\n    for scope, names in by_scope.items():\n        assert names == {n for n, a in mcp_server.audiences.items() if scope in a}\n    assert \"claim_task\" in by_scope[Scope.WORKER]\n# -- HTTP and MCP -------------------------------------------------------------------\n\nADMIN = {\"Authorization\": f\"Bearer {ADMIN_TOKEN}\"}\n\n\n@pytest.fixture\ndef client(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> Generator[TestClient]:\n    monkeypatch.setenv(\"ARGUS_DATA_DIR\", str(tmp_path))\n    monkeypatch.setenv(\"ARGUS_ADMIN_TOKEN\", ADMIN_TOKEN)\n    with TestClient(app) as c:\n        yield c\n\n\ndef test_stuck_dependents_show_in_the_inbox_and_are_released_over_mcp(\n    client: TestClient,\n) -> None:\n    def new(**kw) -> dict:\n        res = client.post(\n            \"/api/tasks\", json={\"project\": \"global\", \"title\": \"t\", **kw}, headers=ADMIN\n        )\n        assert res.status_code == 201, res.text\n        return res.json()\n\n    dep = new()\n    client.post(f\"/api/tasks/{dep['id']}/cancel\", headers=ADMIN).raise_for_status()\n    stuck = new(depends_on=[dep[\"id\"]])\n    new(depends_on=[new()[\"id\"]])  # pending on a ready task: not stuck\n\n    page = client.get(\"/api/inbox\", headers=ADMIN).json()\n    [row] = page[\"items\"]\n    assert (row[\"subject_id\"], row[\"state\"], row[\"failed_dependencies\"]) == (\n        stuck[\"id\"],\n        \"pending\",\n        [dep[\"id\"]],\n    )\n    assert row[\"decision_id\"] is None\n    assert page[\"totals_by_state\"] == {\"pending\": 1}\n    assert page[\"totals_by_decision_kind\"] == {\"none\": 1}\n    only = client.get(\"/api/inbox\", params={\"state\": \"blocked\"}, headers=ADMIN)\n    assert only.json()[\"total\"] == 0\n\n    worker = {\"Authorization\": f\"Bearer {register(client)}\"}\n    body = {\"depends_on\": [], \"expected_version\": row[\"version\"]}\n    refused = client.put(\n        f\"/api/tasks/{stuck['id']}/dependencies\", json=body, headers=worker\n    )\n    assert refused.status_code == 403\n\n    orchestrator = register(client, \"orchestrator\")\n    released = tool(\n        client,\n        orchestrator,\n        \"set_task_dependencies\",\n        task_id=stuck[\"id\"],\n        depends_on=[],\n        expected_version=row[\"version\"],\n    )\n    assert (released[\"state\"], released[\"depends_on\"]) == (\"ready\", [])\n    assert client.get(\"/api/inbox\", headers=ADMIN).json()[\"total\"] == 0\n    events = client.get(\n        \"/api/events\", params={\"subject_id\": stuck[\"id\"]}, headers=ADMIN\n    ).json()\n    changed = next(e for e in events if e[\"kind\"] == \"task.dependencies_changed\")\n    assert changed[\"data\"] == {\"added\": [], \"removed\": [dep[\"id\"]]}\n64-async def test_0004_rebuild_keeps_existing_tokens(tmp_path: Path) -> None:\n65-    path = tmp_path / \"argus.db\"\n66-    migrations = load_migrations()\n67:    db = await Database.open(path, migrations=migrations[:3])\n68-    async with db.write() as tx:\n69-        await tx.conn.execute(\n70-            \"INSERT INTO tokens (id, token_hash, kind, role, created_by, created_at)\"\n71-            \" VALUES ('t1', 'h1', 'bootstrap', 'worker', 'x', 'now')\