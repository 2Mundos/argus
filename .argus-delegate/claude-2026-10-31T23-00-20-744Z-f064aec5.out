{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UisvpL5M7FSUGk3Rq85g7U","type":"tool_result","content":"390:class TaskCreate(BaseModel):\n391-    title: str = Field(min_length=1, max_length=200)\n392-    spec: str = Field(default=\"\", max_length=SPEC_MAX_LENGTH)\n393-    kind: str = \"generic\"\n394-    acceptance: list[str] = []\n395-    input: dict[str, Any] = {}\n396-    required_capabilities: list[str] = []\n397-    priority: int = 0\n398-    requires_approval: bool = False\n399-    review: Review = Review.NONE\n400-    parent_id: str | None = None\n401-    depends_on: list[str] = []\n402-    # Required; a subtask may omit it to inherit its parent's project.\n403-    project: str | None = None\n404-    knowledge: list[str] = []  # page ids pinned to the task, delivered on claim\n405-    max_attempts: int = Field(default=3, ge=1, le=20)\n406-    lease_ttl_s: int = Field(default=120, ge=10, le=3600)\n407-    # Wall-clock cap per attempt, counted from the claim; heartbeats and progress\n408-    # notes do not extend it. Unset: the kind's default, then the server's.\n409-    timeout_s: int | None = Field(default=None, ge=60, le=7 * 24 * 3600)\n410-    # Unset: derived from the title and spec (task difficulty spec). The source\n411-    # defaults to `declared`; an orchestrator suggesting a level sends `inferred`.\n412-    difficulty: Difficulty | None = None\n413-    difficulty_source: DifficultySource | None = None\n414-    # Restrict the task to these engine account providers (e.g. [\"local\"]); None:\n415-    # unrestricted (local harness spec 3).\n416-    account_providers: list[str] | None = None\n417-    # Pinned engine/executor and model; None: policy and account priority.\n418-    harness_model: HarnessModel | None = None\n419-    executor_model: ExecutorModel | None = None\n420-    # Pin the engine lease to one account (id or name; stored as its id), e.g. the\n421-    # local Strata account or one custom account (task models spec 3.4).\n422-    harness_account: AccountRef | None = None\n423-\n424-    @field_validator(\"input\")\n425-    @classmethod\n426-    def _input_size(cls, value: dict[str, Any]) -> dict[str, Any]:\n427-        # Compact JSON length, mirroring the knowledge body character cap.\n428-        encoded = json.dumps(value, separators=(\",\", \":\"), ensure_ascii=False)\n429-        if len(encoded) > INPUT_MAX_CHARS:\n430-            raise ValueError(f\"input exceeds {INPUT_MAX_CHARS} characters\")\n431-        return value\n432-\n433-    @field_validator(\"account_providers\")\n434-    @classmethod\n435-    def _engine_providers(cls, value: list[str] | None) -> list[str] | None:\n436-        return validate_account_providers(value)\n437-\n438-    @model_validator(mode=\"after\")\n439-    def _harness_allowed(self) -> \"TaskCreate\":\n440-        if why := check_harness_providers(self.harness_model, self.account_providers):\n441-            raise ValueError(f\"harness_model: {why}\")\n442-        return self\n443-\n444-\n445-class Failover(BaseModel):\n446-    \"\"\"The last switch of the account serving a task (account selection 3.6).\"\"\"\n447-\n448-    from_account: str | None  # account names, never credentials\n449-    to_account: str | None  # None: nothing usable was left (awaiting quota)\n450-    reason: str  # sanitized: one line, no tokens or query strings\n451-    at: datetime\n452-    attempt: int\n453-    reason_code: Literal[\"quota_exhausted\", \"auth_expired\"] | None = None\n454-    reset_status: Literal[\"stated\", \"ambiguous\", \"absent\"] | None = None\n455-    reset_text: str | None = None\n456-    reset_at: datetime | None = None\n457-    source: Literal[\"structured\", \"notice\", \"log\"] | None = None\n458-    outcome: Literal[\"switched\", \"awaiting_quota\", \"switch_failed\"] | None = None\n459-    apply: Literal[\"pending\", \"applied\", \"not_needed\", \"failed\"] | None = None\n460-    apply_error: str | None = None\n461-    applied_at: datetime | None = None\n462-\n463-\n464-class ServingAccount(BaseModel):\n465-    id: str\n466-    name: str\n467-    provider: str\n468-    # Custom accounts only (custom accounts spec 3): the configured engine model and\n469-    # the host calls go to. Not provider-observed: the model actually served may differ.\n470-    model: str | None = None\n471-    host: str | None = None\n472-\n473-\n474-class Task(BaseModel):\n475-    id: str\n476-    parent_id: str | None\n477-    kind: str\n478-    title: str\n479-    spec: str\n480-    acceptance: list[str]\n__init__.py\naccounts.py\nagents.py\nauth.py\nclaude_auth.py\ncodex_auth.py\ncontinuation.py\nconversations.py\ncopilot_auth.py\ncost.py\ncriteria_safe.py\ncursor_auth.py\ncustom_accounts.py\ndecisions.py\ndelivery.py\ndifficulty.py\nengines.py\nfleet.py\nkinds.py\nknowledge.py\nmodel_trace.py\nquota.py\nredact.py\nresumability.py\nroutines.py\nruntime.py\nruntime_assets\nsettings.py\ntask_edit.py\ntasks.py\n\"\"\"Which task fields can be edited, in which state, and the patch model.\n\nSee docs/specs/task-edit.spec.md. REST, MCP and the dashboard all read the\npolicy from here.\n\"\"\"\n\nfrom datetime import datetime\nfrom typing import Any, Literal\n\nfrom pydantic import BaseModel, ConfigDict, Field\n\nfrom argus_core.difficulty import Difficulty\nfrom argus_core.tasks import AccountRef, ExecutorModel, HarnessModel, TaskState\n\nEDITABLE = (\n    \"title\",\n    \"spec\",\n    \"acceptance\",\n    \"priority\",\n    \"required_capabilities\",\n    \"knowledge\",\n    \"depends_on\",\n    \"difficulty\",\n    \"account_providers\",\n    \"harness_model\",\n    \"executor_model\",\n    \"harness_account\",\n)\n# `null` clears these to their empty value; title, priority and difficulty cannot be.\nCLEARABLE = frozenset(EDITABLE) - {\"title\", \"priority\", \"difficulty\"}\n\n_ALL = frozenset(EDITABLE)\n_PRIORITY_ONLY = frozenset({\"priority\"})\nEDITABLE_BY_STATE: dict[TaskState, frozenset[str]] = {\n    TaskState.AWAITING_APPROVAL: _ALL,\n    TaskState.PENDING: _ALL,\n    TaskState.READY: _ALL,\n    TaskState.BLOCKED: _PRIORITY_ONLY,\n    TaskState.CLAIMED: _PRIORITY_ONLY,\n    TaskState.IN_REVIEW: _PRIORITY_ONLY,\n    TaskState.SUCCEEDED: frozenset(),\n    TaskState.FAILED: frozenset(),\n    TaskState.CANCELLED: frozenset(),\n}\n\n\ndef editable_fields(state: TaskState, *, archived: bool = False) -> list[str]:\n    \"\"\"The fields an edit may change now, in display order.\"\"\"\n    if archived:\n        return []\n    allowed = EDITABLE_BY_STATE[state]\n    return [f for f in EDITABLE if f in allowed]\n\n\nclass TaskChanges(BaseModel):\n    \"\"\"A partial patch: a field left out is preserved, `null` clears (3.2).\n\n    Anything that is not an editable field is kept in `model_extra` so the\n    service can refuse it with one structured `immutable_field` error.\n    \"\"\"\n\n    model_config = ConfigDict(extra=\"allow\")\n\n    title: str | None = None\n    spec: str | None = Field(default=None, max_length=200_000)\n    acceptance: list[str] | None = None\n    priority: int | None = None\n    required_capabilities: list[str] | None = None\n    knowledge: list[str] | None = None\n    depends_on: list[str] | None = None\n    difficulty: Difficulty | None = None\n    account_providers: list[str] | None = None\n    harness_model: HarnessModel | None = None\n    executor_model: ExecutorModel | None = None\n    harness_account: AccountRef | None = None\n\n    def given(self) -> dict[str, Any]:\n        \"\"\"Editable fields the caller named (even as null), by name.\"\"\"\n        return {f: getattr(self, f) for f in EDITABLE if f in self.model_fields_set}","is_error":false}]},"parent_tool_use_id":null,"session_id":"e60805ed-c36d-4e22-8274-acc0a44d64d1","uuid":"fc26f9b2-bfcf-4336-8d49-845f4d7df622","timestamp":"2026-10-31T23:00:47.697Z","tool_use_result":{"stdout":"390:class TaskCreate(BaseModel):\n391-    title: str = Field(min_length=1, max_length=200)\n392-    spec: str = Field(defau