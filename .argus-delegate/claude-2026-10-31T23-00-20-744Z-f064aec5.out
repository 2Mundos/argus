{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014MdrHQPpvKzWxwBe74cGmV","type":"tool_result","content":"1\t\"\"\"Task drafts and their publication (docs/specs/task-drafts.spec.md).\n2\t\n3\tThe one implementation behind REST and MCP. A draft is a row of `task_drafts`,\n4\tnever of `tasks`, so nothing can claim it; publish creates every task of a batch\n5\tthrough `service.create_task` in the caller's single write transaction.\n6\t\"\"\"\n7\t\n8\timport hashlib\n9\timport json\n10\tfrom datetime import datetime, timedelta\n11\tfrom typing import Any\n12\tfrom uuid import uuid4\n13\t\n14\timport aiosqlite\n15\tfrom argus_core.task_drafts import (\n16\t    MAX_OPEN_DRAFTS,\n17\t    PublishOutcome,\n18\t    PublishRequest,\n19\t    PublishResult,\n20\t    TaskDraft,\n21\t    TaskDraftBody,\n22\t    TaskDraftPage,\n23\t)\n24\tfrom argus_core.tasks import TaskCreate\n25\tfrom pydantic import ValidationError\n26\t\n27\tfrom argus_api.db import Tx, ts\n28\tfrom argus_api.errors import (\n29\t    ConflictError,\n30\t    DomainError,\n31\t    NotFoundError,\n32\t    ValidationFailedError,\n33\t)\n34\tfrom argus_api.events import record\n35\tfrom argus_api.tasks import service\n36\t\n37\t_TICK = timedelta(microseconds=1)\n38\t# Which refusal an atomic publish reports when several items fail (3.3).\n39\t_PRECEDENCE = (\"not_found\", \"stale_version\", \"draft_published\", \"dependency_cycle\")\n40\t\n41\t\n42\t# -- reads -------------------------------------------------------------------\n43\t\n44\t\n45\tasync def get_draft(conn: aiosqlite.Connection, draft_id: str) -> TaskDraft:\n46\t    return _to_draft(await _row(conn, draft_id))\n47\t\n48\t\n49\tasync def list_drafts(conn: aiosqlite.Connection) -> TaskDraftPage:\n50\t    async with conn.execute(\n51\t        \"SELECT * FROM task_drafts WHERE published_at IS NULL ORDER BY created_at, id\"\n52\t    ) as cur:\n53\t        items = [_to_draft(r) for r in await cur.fetchall()]\n54\t    return TaskDraftPage(items=items, total=len(items))\n55\t\n56\t\n57\t# -- open drafts -------------------------------------------------------------\n58\t\n59\t\n60\tasync def create_draft(tx: Tx, body: TaskDraftBody, actor: str) -> TaskDraft:\n61\t    async with tx.conn.execute(\n62\t        \"SELECT COUNT(*) FROM task_drafts WHERE published_at IS NULL\"\n63\t    ) as cur:\n64\t        row = await cur.fetchone()\n65\t    if row is not None and row[0] >= MAX_OPEN_DRAFTS:\n66\t        raise ConflictError(\n67\t            f\"at most {MAX_OPEN_DRAFTS} open drafts; publish or discard some first\",\n68\t            code=\"too_many_drafts\",\n69\t        )\n70\t    draft_id = str(uuid4())\n71\t    now = ts(tx.now)\n72\t    await tx.conn.execute(\n73\t        \"INSERT INTO task_drafts (id, body, created_by, created_at, updated_by,\"\n74\t        \" updated_at) VALUES (?, ?, ?, ?, ?, ?)\",\n75\t        (draft_id, _stored(body), actor, now, actor, now),\n76\t    )\n77\t    return await get_draft(tx.conn, draft_id)\n78\t\n79\t\n80\tasync def edit_draft(\n81\t    tx: Tx, draft_id: str, changes: dict[str, Any], expected_version: str, actor: str\n82\t) -> TaskDraft:\n83\t    \"\"\"Merge a partial patch into an open draft's body: `null` resets a field.\"\"\"\n84\t    row = await _open_row(tx.conn, draft_id, expected_version)\n85\t    stored = json.loads(row[\"body\"])\n86\t    merged = {k: v for k, v in {**stored, **changes}.items() if v is not None}\n87\t    try:\n88\t        body = TaskDraftBody.model_validate(merged)\n89\t    except ValidationError as exc:\n90\t        raise ValidationFailedError(\n91\t            \"invalid draft: \" + \"; \".join(_errors(exc)), details=_errors(exc)\n92\t        ) from None\n93\t    if json.loads(_stored(body)) == stored:\n94\t        return _to_draft(row)  # nothing differs: no write, same version\n95\t    version = ts(max(tx.now, datetime.fromisoformat(row[\"updated_at\"]) + _TICK))\n96\t    await tx.conn.execute(\n97\t        \"UPDATE task_drafts SET body = ?, updated_by = ?, updated_at = ? WHERE id = ?\",\n98\t        (_stored(body), actor, version, draft_id),\n99\t    )\n100\t    return await get_draft(tx.conn, draft_id)\n101\t\n102\t\n103\tasync def discard_draft(tx: Tx, draft_id: str, expected_version: str) -> None:\n104\t    await _open_row(tx.conn, draft_id, expected_version)\n105\t    await tx.conn.execute(\"DELETE FROM task_drafts WHERE id = ?\", (draft_id,))\n106\t\n107\t\n108\t# -- publication -------------------------------------------------------------\n109\t\n110\t\n111\tasync def publish(\n112\t    tx: Tx, req: PublishRequest, actor: str, *, hourly_limit: int | None = None\n113\t) -> PublishResult:\n114\t    \"\"\"Validate and publish a batch (3.3), idempotently by key (3.4).\"\"\"\n115\t    digest = _digest(req)\n116\t    async with tx.conn.execute(\n117\t        \"SELECT request_digest, answer FROM task_draft_publications\"\n118\t        \" WHERE idempotency_key = ?\",\n119\t        (req.idempotency_key,),\n120\t    ) as cur:\n121\t        seen = await cur.fetchone()\n122\t    if seen is not None:\n123\t        if seen[\"request_digest\"] != digest:\n124\t            raise ConflictError(\n125\t                \"this idempotency_key was used for another publish request\",\n126\t                code=\"idempotency_key_reused\",\n127\t            )\n128\t        answer = PublishResult.model_validate_json(seen[\"answer\"])\n129\t        return answer.model_copy(update={\"replayed\": True})\n130\t\n131\t    ids = [d.draft_id for d in req.drafts]\n132\t    rows = await _rows(tx.conn, ids)\n133\t    outcomes: dict[str, PublishOutcome] = {}\n134\t    bodies: dict[str, TaskDraftBody] = {}\n135\t    outside: dict[str, str] = {}  # published drafts outside the batch -> task id\n136\t    for item in req.drafts:\n137\t        row = rows.get(item.draft_id)\n138\t        if row is None:\n139\t            outcomes[item.draft_id] = _rejected(\n140\t                item.draft_id, \"not_found\", \"draft not found\"\n141\t            )\n142\t        elif row[\"published_at\"] is not None:\n143\t            outcomes[item.draft_id] = _rejected(\n144\t                item.draft_id,\n145\t                \"draft_published\",\n146\t                f\"already published as task {row['published_task_id']}\",\n147\t            )\n148\t        elif row[\"updated_at\"] != item.expected_version:\n149\t            outcomes[item.draft_id] = _rejected(\n150\t                item.draft_id,\n151\t                \"stale_version\",\n152\t                f\"draft changed since you read it (version {row['updated_at']})\",\n153\t            )\n154\t        else:\n155\t            bodies[item.draft_id] = TaskDraftBody.model_validate_json(row[\"body\"])\n156\t    refs = {d for b in bodies.values() for d in b.depends_on_drafts} - set(ids)\n157\t    for ref, row in (await _rows(tx.conn, sorted(refs))).items():\n158\t        if row[\"published_task_id\"] is not None:\n159\t            outside[ref] = row[\"published_task_id\"]\n160\t    for draft_id, body in bodies.items():\n161\t        if why := _incomplete(body, outside, set(ids)):\n162\t            outcomes[draft_id] = _rejected(draft_id, \"validation_failed\", *why)\n163\t\n164\t    order, cycles = _order(ids, {i: b.depends_on_drafts for i, b in bodies.items()})\n165\t    for draft_id, path in cycles.items():\n166\t        outcomes.setdefault(\n167\t            draft_id,\n168\t            _rejected(\n169\t                draft_id,\n170\t                \"dependency_cycle\",\n171\t                \"these drafts depend on each other: \" + \" -> \".join(path),\n172\t            ),\n173\t        )\n174\t\n175\t    task_ids: dict[str, str] = dict(outside)\n176\t    for draft_id in order:\n177\t        if draft_id in outcomes:\n178\t            continue\n179\t        body = bodies[draft_id]\n180\t        if waits := [d for d in body.depends_on_drafts if d not in task_ids]:\n181\t            outcomes[draft_id] = PublishOutcome(\n182\t                draft_id=draft_id,\n183\t                outcome=\"skipped\",\n184\t                errors=[f\"depends_on_drafts: {d} was not published\" for d in waits],\n185\t            )\n186\t            continue\n187\t        create = TaskCreate.model_validate(\n188\t            {\n189\t                **body.model_dump(exclude_unset=True, exclude={\"depends_on_drafts\"}),\n190\t                \"depends_on\": [\n191\t                    *body.depends_on,\n192\t                    *(task_ids[d] for d in body.depends_on_drafts),\n193\t                ],\n194\t            }\n195\t        )\n196\t        try:\n197\t            async with tx.savepoint():\n198\t                task = await service.create_task(\n199\t                    tx, create, actor, hourly_limit=hourly_limit\n200\t                )\n201\t                await _check_capabilities(tx.conn, task.required_capabilities)\n202\t                await tx.conn.execute(\n203\t                    \"UPDATE task_drafts SET published_at = ?, published_task_id = ?,\"\n204\t                    \" publication_key = ? WHERE id = ?\",\n205\t                    (ts(tx.now), task.id, req.idempotency_key, draft_id),\n206\t                )\n207\t                await record(\n208\t                    tx,\n209\t                    actor,\n210\t                    \"task_draft\",\n211\t                    draft_id,\n212\t                    \"task_draft.published\",\n213\t                    {\"task_id\": task.id, \"idempotency_key\": req.idempotency_key},\n214\t                )\n215\t        except DomainError as exc:\n216\t            outcomes[draft_id] = _rejected(\n217\t                draft_id, exc.code, exc.message, *exc.details\n218\t            )\n219\t            continue\n220\t        task_ids[draft_id] = task.id\n221\t        outcomes[draft_id] = PublishOutcome(\n222\t            draft_id=draft_id, outcome=\"published\", task_id=task.id, state=task.state\n223\t        )\n224\t\n225\t    result = PublishResult(\n226\t        idempotency_key=req.idempotency_key,\n227\t        mode=req.mode,\n228\t        items=[outcomes[i] for i in ids],\n229\t    )\n230\t    failed = [o for o in result.items if o.outcome != \"published\"]\n231\t    if req.mode == \"atomic\" and failed:\n232\t        raise _atomic_refusal(failed)  # the write transaction rolls back\n233\t    await tx.conn.execute(\n234\t        \"INSERT INTO task_draft_publications (idempotency_key, request_digest,\"\n235\t        \" answer, actor, created_at) VALUES (?, ?, ?, ?, ?)\",\n236\t        (req.idempotency_key, digest, result.model_dump_json(), actor, ts(tx.now)),\n237\t    )\n238\t    return result\n239\t\n240\t\n241\tdef _incomplete(\n242\t    body: TaskDraftBody, outside: dict[str, str], batch: set[str]\n243\t) -> list[str]:\n244\t    \"\"\"Why a draft is not a complete task definition yet (3.3), or nothing.\"\"\"\n245\t    try:\n246\t        TaskCreate.model_validate(\n247\t            body.model_dump(exclude_unset=True, exclude={\"depends_on_drafts\"})\n248\t        )\n249\t        errors = []\n250\t    except ValidationError as exc:\n251\t        errors = _errors(exc)\n252\t    if not body.spec.strip():\n253\t        errors.append(\"spec: a draft needs a spec to be published\")\n254\t    if not body.acceptance:\n255\t        errors.append(\"acceptance: a draft needs at least one criterion\")\n256\t    elif any(not a.strip() for a in body.acceptance):\n257\t        errors.append(\"acceptance: criteria cannot be blank\")\n258\t    errors += [\n259\t        f\"depends_on_drafts: {d} is not in this batch\"\n260\t        for d in body.depends_on_drafts\n261\t        if d not in batch and d not in outside\n262\t    ]\n263\t    return errors\n264\t\n265\t\n266\tdef _order(\n267\t    ids: list[str], edges: dict[str, list[str]]\n268\t) -> tuple[list[str], dict[str, list[str]]]:\n269\t    \"\"\"The batch in dependency order, and each draft on an in-batch cycle with\n270\t    that cycle's path. Edges to drafts outside the batch are ignored here.\"\"\"\n271\t    batch = set(ids)\n272\t    deps = {i: [d for d in edges.get(i, []) if d in batch] for i in ids}\n273\t    order: list[str] = []\n274\t    done: set[str] = set()\n275\t    while True:\n276\t        ready = [i for i in ids if i not in done and all(d in done for d in deps[i])]\n277\t        if not ready:\n278\t            break\n279\t        order += ready\n280\t        done.update(ready)\n281\t    cycles: dict[str, list[str]] = {}\n282\t    for start in ids:\n283\t        if start not in done and (path := _cycle_from(start, deps)):\n284\t            cycles[start] = path\n285\t    # Drafts left behind a cycle come last; they are skipped as not published.\n286\t    return order + [i for i in ids if i not in done], cycles\n287\t\n288\t\n289\tdef _cycle_from(start: str, deps: dict[str, list[str]]) -> list[str] | None:\n290\t    \"\"\"A path start -> ... -> start along dependency edges, if one exists.\"\"\"\n291\t    stack: list[tuple[str, list[str]]] = [(start, [start])]\n292\t    seen: set[str] = set()\n293\t    while stack:\n294\t        node, path = stack.pop()\n295\t        for dep in deps[node]:\n296\t            if dep == start:\n297\t                return [*path, start]\n298\t            if dep not in seen:\n299\t                seen.add(dep)\n300\t                stack.append((dep, [*path, dep]))\n301\t    return None\n302\t\n303\t\n304\tasync def _check_capabilities(conn: aiosqlite.Connection, required: list[str]) -> None:\n305\t    \"\"\"Each capability must be declared by a pool or a non-archived agent.\"\"\"\n306\t    if not required:\n307\t        return\n308\t    async with conn.execute(\n309\t        \"SELECT j.value FROM pools, json_each(pools.capabilities) AS j\"\n310\t        \" UNION SELECT j.value FROM agents, json_each(agents.capabilities) AS j\"\n311\t        \" WHERE agents.archived_at IS NULL\"\n312\t    ) as cur:\n313\t        known = {r[0] for r in await cur.fetchall()}\n314\t    if unknown := [c for c in required if c not in known]:\n315\t        raise ValidationFailedError(\n316\t            \"no pool or agent declares these capabilities: \" + \", \".join(unknown),\n317\t            code=\"unknown_capability\",\n318\t            details=[f\"required_capabilities: {c}\" for c in unknown],\n319\t        )\n320\t\n321\t\n322\tdef _atomic_refusal(failed: list[PublishOutcome]) -> DomainError:\n323\t    codes = [o.code for o in failed if o.code]\n324\t    code = next((c for c in _PRECEDENCE if c in codes), codes[0] if codes else None)\n325\t    cls = {\n326\t        \"not_found\": NotFoundError,\n327\t        \"stale_version\": ConflictError,\n328\t        \"draft_published\": ConflictError,\n329\t    }.get(code or \"\", ValidationFailedError)\n330\t    details = [\n331\t        f\"{o.draft_id}: {o.code or o.outcome}: {e}\" for o in failed for e in o.errors\n332\t    ]\n333\t    return cls(\n334\t        f\"nothing was published: {len(failed)} draft(s) cannot be published\",\n335\t        code=code if code in _PRECEDENCE else \"validation_failed\",\n336\t        details=details,\n337\t    )\n338\t\n339\t\n340\tdef _rejected(draft_id: str, code: str, *errors: str) -> PublishOutcome:\n341\t    return PublishOutcome(\n342\t        draft_id=draft_id, outcome=\"rejected\", code=code, errors=list(errors)\n343\t    )\n344\t\n345\t\n346\tdef _digest(req: PublishRequest) -> str:\n347\t    canonical = json.dumps(\n348\t        {\n349\t            \"mode\": req.mode,\n350\t            \"drafts\": [[d.draft_id, d.expected_version] for d in req.drafts],\n351\t        },\n352\t        separators=(\",\", \":\"),\n353\t    )\n354\t    return hashlib.sha256(canonical.encode()).hexdigest()\n355\t\n356\t\n357\t# -- rows --------------------------------------------------------------------\n358\t\n359\t\n360\tdef _stored(body: TaskDraftBody) -> str:\n361\t    # Only fields the author set: a kind's defaults still apply at publish.\n362\t    return json.dumps(body.model_dump(mode=\"json\", exclude_unset=True), sort_keys=True)\n363\t\n364\t\n365\tdef _errors(exc: ValidationError) -> list[str]:\n366\t    return [\n367\t        f\"{'.'.join(map(str, e['loc'])) or 'body'}: {e['msg']}\" for e in exc.errors()\n368\t    ]\n369\t\n370\t\n371\tasync def _row(conn: aiosqlite.Connection, draft_id: str) -> aiosqlite.Row:\n372\t    async with conn.execute(\n373\t        \"SELECT * FROM task_drafts WHERE id = ?\", (draft_id,)\n374\t    ) as cur:\n375\t        row = await cur.fetchone()\n376\t    if row is None:\n377\t        raise NotFoundError(f\"draft not found: {draft_id}\")\n378\t    return row\n379\t\n380\t\n381\tasync def _rows(conn: aiosqlite.Connection, ids: list[str]) -> dict[str, aiosqlite.Row]:\n382\t    if not ids:\n383\t        return {}\n384\t    marks = \",\".join(\"?\" * len(ids))\n385\t    sql = f\"SELECT * FROM task_drafts WHERE id IN ({marks})\"  # noqa: S608\n386\t    async with conn.execute(sql, ids) as cur:\n387\t        return {r[\"id\"]: r for r in await cur.fetchall()}\n388\t\n389\t\n390\tasync def _open_row(\n391\t    conn: aiosqlite.Connection, draft_id: str, expected_version: str\n392\t) -> aiosqlite.Row:\n393\t    row = await _row(conn, draft_id)\n394\t    if row[\"published_at\"] is not None:\n395\t        raise ConflictError(\n396\t            f\"draft {draft_id} was published as task {row['published_task_id']};\"\n397\t            \" edit the task instead\",\n398\t            code=\"draft_published\",\n399\t            details=[row[\"published_task_id\"]],\n400\t        )\n401\t    if row[\"updated_at\"] != expected_version:\n402\t        raise ConflictError(\n403\t            f\"draft {draft_id} changed since you read it (version\"\n404\t            f\" {row['updated_at']}); read it again and reapply your change\",\n405\t            code=\"stale_version\",\n406\t            details=[row[\"updated_at\"]],\n407\t        )\n408\t    return row\n409\t\n410\t\n411\tdef _to_draft(row: aiosqlite.Row) -> TaskDraft:\n412\t    return TaskDraft(\n413\t        id=row[\"id\"],\n414\t        body=TaskDraftBody.model_validate_json(row[\"body\"]),\n415\t        version=row[\"updated_at\"],\n416\t        created_by=row[\"created_by\"],\n417\t        created_at=row[\"created_at\"],\n418\t        updated_by=row[\"updated_by\"],\n419\t        updated_at=row[\"updated_at\"],\n420\t        published_at=row[\"published_at\"],\n421\t        published_task_id=row[\"published_task_id\"],\n422\t    )\n423\t"}]},"parent_tool_use_id":null,"session_id":"e60805ed-c36d-4e22-8274-acc0a44d64d1","uuid":"aa80b074-4650-4755-92ae-9d0fa5a35c8c","timestamp":"2026-10-31T23:08:06.746Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/agent/task-workspaces/030540ef-d69a-4c2c-839d-f4970e8c94d7/apps/api/src/argus_api/tasks/drafts.py","content":"\"\"\"Task drafts and their publication (docs/specs/task-drafts.spec.md).\n\nThe one implementation behind REST and MCP. A draft is a row of `task_drafts`,\nnever of `tasks`, so nothing can claim it; publish creates every task of a batch\nthrough `service.create_task` in the caller's single write transaction.\n\"\"\"\n\nimport hashlib\nimport json\nfrom datetime import datetime, timedelta\nfrom typing import Any\nfrom uuid import uuid4\n\nimport aiosqlite\nfrom argus_core.task_drafts import (\n    MAX_OPEN_DRAFTS,\n    PublishOutcome,\n    PublishRequest,\n    PublishResult,\n    TaskDraft,\n    TaskDraftBody,\n    TaskDraftPage,\n)\nfrom argus_core.tasks import TaskCreate\nfrom pydantic import ValidationError\n\nfrom argus_api.db import Tx, ts\nfrom argus_api.errors import (\n    ConflictError,\n    DomainError,\n    NotFoundError,\n    ValidationFailedError,\n)\nfrom argus_api.events import record\nfrom argus_api.tasks import service\n\n_TICK = timedelta(microseconds=1)\n# Which refusal an atomic publish reports when several items fail (3.3).\n_PRECEDENCE = (\"not_found\", \"stale_version\", \"draft_published\", \"dependency_cycle\")\n\n\n# -- reads -------------------------------------------------------------------\n\n\nasync def get_draft(conn: aiosqlite.Connection, draft_id: str) -> TaskDraft:\n    return _to_draft(await _row(conn, draft_id))\n\n\nasync def list_drafts(conn: aiosqlite.Connection) -> TaskDraftPage:\n    async with conn.execute(\n        \"SELECT * FROM task_drafts WHERE published_at IS NULL ORDER BY created_at, id\"\n    ) as cur:\n        items = [_to_draft(r) for r in await cur.fetchall()]\n    return TaskDraftPage(items=items, total=len(items))\n\n\n# -- open drafts -------------------------------------------------------------\n\n\nasync def create_draft(tx: Tx, body: TaskDraftBody, actor: str) -> TaskDraft:\n    async with tx.conn.execute(\n        \"SELECT COUNT(*) FROM task_drafts WHERE published_at IS NULL\"\n    ) as cur:\n        row = await cur.fetchone()\n    if row is not None and row[0] >= MAX_OPEN_DRAFTS:\n        raise ConflictError(\n            f\"at most {MAX_OPEN_DRAFTS} open drafts; publish or discard some first\",\n            code=\"too_many_drafts\",\n        )\n    draft_id = str(uuid4())\n    now = ts(tx.now)\n    await tx.conn.execute(\n        \"INSERT INTO task_drafts (id, body, created_by, created_at, updated_by,\"\n        \" updated_at) VALUES (?, ?, ?, ?, ?, ?)\",\n        (draft_id, _stored(body), actor, now, actor, now),\n    )\n    return await get_draft(tx.conn, draft_id)\n\n\nasync def edit_draft(\n    tx: Tx, draft_id: str, changes: dict[str, Any], expected_version: str, actor: str\n) -> TaskDraft:\n    \"\"\"Merge a partial patch into an open draft's body: `null` resets a field.\"\"\"\n    row = await _open_row(tx.conn, draft_id, expected_version)\n    stored = json.loads(row[\"body\"])\n    merged = {k: v for k, v in {**stored, **changes}.items() if v is not None}\n    try:\n        body = TaskDraftBody.model_validate(merged)\n    except ValidationError as exc:\n        raise ValidationFailedError(\n            \"invalid draft: \" + \"; \".join(_errors(exc)), details=_errors(exc)\n        ) from None\n    if json.loads(_stored(body)) == stored:\n        return _to_draft(row)  # nothing differs: no write, same version\n    version = ts(max(tx.now, datetime.fromisoformat(row[\"updated_at\"]) + _TICK))\n    await tx.conn.execute(\n        \"UPDATE task_drafts SET body = ?, updated_by = ?, updated_at = ? WHERE id = ?\",\n        (_stored(body), actor, version, draft_id),\n    )\n    return await get_draft(tx.conn, draft_id)\n\n\nasync def discard_draft(tx: Tx, draft_id: str, expected_version: str) -> None:\n    await _open_row(tx.conn, draft_id, expected_version)\n    await tx.conn.execute(\"DELETE FROM task_drafts WHERE id = ?\", (draft_id,))\n\n\n# -- publication -------------------------------------------------------------\n\n\nasync def publish(\n    tx: Tx, req: PublishRequest, actor: str, *, hourly_limit: int | None = None\n) -> PublishResult:\n    \"\"\"Validate and publish a batch (3.3), idempotently by key (3.4).\"\"\"\n    digest = _digest(req)\n    async with tx.conn.execute(\n        \"SELECT request_digest, answer FROM task_draft_publications\"\n        \" WHERE idempotency_key = ?\",\n        (req.idempotency_key,),\n    ) as cur:\n        seen = await cur.fetchone()\n    if seen is not None:\n        if seen[\"request_digest\"] != digest:\n            raise ConflictError(\n                \"this idempotency_key was used for another publish request\",\n                code=\"idempotency_key_reused\",\n            )\n        answer = PublishResult.model_validate_json(seen[\"answer\"])\n        return answer.model_copy(update={\"replayed\": True})\n\n    ids = [d.draft_id for d in req.drafts]\n    rows = await _rows(tx.conn, ids)\n    outcomes: dict[str, PublishOutcome] = {}\n    bodies: dict[str, TaskDraftBody] = {}\n    outside: dict[str, str] = {}  # published drafts outside the batch -> task id\n    for item in req.drafts:\n        row = rows.get(item.draft_id)\n        if row is None:\n            outcomes[item.draft_id] = _rejected(\n                item.draft_id, \"not_found\", \"draft not found\"\n            )\n        elif row[\"published_at\"] is not None:\n            outcomes[item.draft_id] = _rejected(\n                item.draft_id,\n                \"draft_published\",\n                f\"already published as task {row['published_task_id']}\",\n            )\n        elif row[\"updated_at\"] != item.expected_version:\n            outcomes[item.draft_id] = _rejected(\n                item.draft_id,\n                \"stale_version\",\n                f\"draft changed since you read it (version {row['updated_at']})\",\n            )\n        else:\n            bodies[item.draft_id] = TaskDraftBody.model_validate_json(row[\"body\"])\n    refs = {d for b in bodies.values() for d in b.depends_on_drafts} - set(ids)\n    for ref, row in (await _rows(tx.conn, sorted(refs))).items():\n        if row[\"published_task_id\"] is not None:\n            outside[ref] = row[\"published_task_id\"]\n    for draft_id, body in bodies.items():\n        if why := _incomplete(body, outside, set(ids)):\n            outcomes[draft_id] = _rejected(draft_id, \"validation_failed\", *why)\n\n    order, cycles = _order(ids, {i: b.depends_on_drafts for i, b in bodies.items()})\n    for draft_id, path in cycles.items():\n        outcomes.setdefault(\n            draft_id,\n            _rejected(\n                draft_id,\n                \"dependency_cycle\",\n                \"these drafts depend on each other: \" + \" -> \".join(path),\n            ),\n        )\n\n    task_ids: dict[str, str] = dict(outside)\n    for draft_id in order:\n        if draft_id in outcomes:\n            continue\n        body = bodies[draft_id]\n        if waits := [d for d in body.depends_on_drafts if d not in task_ids]:\n            outcomes[draft_id] = PublishOutcome(\n                draft_id=draft_id,\n                outcome=\"skipped\",\n                errors=[f\"depends_on_drafts: {d} was not published\" for d in waits],\n            )\n            continue\n        create = TaskCreate.model_validate(\n            {\n                **body.model_dump(exclude_unset=True, exclude={\"depends_on_drafts\"}),\n                \"depends_on\": [\n                    *body.depends_on,\n                    *(task_ids[d] for d in body.depends_on_drafts),\n                ],\n            }\n        )\n        try:\n            async with tx.savepoint():\n                task = await service.create_task(\n                    tx, create, actor, hourly_limit=hourly_limit\n                )\n                await _check_capabilities(tx.conn, task.required_capabilities)\n                await tx.conn.execute(\n                    \"UPDATE task_drafts SET published_at = ?, published_task_id = ?,\"\n                    \" publication_key = ? WHERE id = ?\",\n                    (ts(tx.now), task.id, req.idempotency_key, draft_id),\n                )\n                await record(\n                    tx,\n                    actor,\n                    \"task_draft\",\n                    draft_id,\n                    \"task_draft.published\",\n                    {\"task_id\": task.id, \"idempotency_key\": req.idempotency_key},\n                )\n        except DomainError as exc:\n            outcomes[draft_id] = _rejected(\n                draft_id, exc.code, exc.message, *exc.details\n            )\n            continue\n        task_ids[draft_id] = task.id\n        outcomes[draft_id] = PublishOutcome(\n            draft_id=draft_id, outcome=\"published\", task_id=task.id, state=task.state\n        )\n\n    result = PublishResult(\n        idempotency_key=req.idempotency_key,\n        mode=req.mode,\n        items=[outcomes[i] for i in ids],\n    )\n    failed = [o for o in result.items if o.outcome != \"published\"]\n    if req.mode == \"atomic\" and failed:\n        raise _atomic_refusal(failed)  # the write transaction rolls back\n    await tx.conn.execute(\n        \"INSERT INTO task_draft_publications (idempotency_key, request_digest,\"\n        \" answer, actor, created_at) VALUES (?, ?, ?, ?, ?)\",\n        (req.idempotency_key, digest, result.model_dump_json(), actor, ts(tx.now)),\n    )\n    return result\n\n\ndef _incomplete(\n    body: TaskDraftBody, outside: dict[str, str], batch: set[str]\n) -> list[str]:\n    \"\"\"Why a draft is not a complete task definition yet (3.3), or nothing.\"\"\"\n    try:\n        TaskCreate.model_validate(\n            body.model_dump(exclude_unset=True, exclude={\"depends_on_drafts\"})\n        )\n        errors = []\n    except ValidationError as exc:\n        errors = _errors(exc)\n    if not body.spec.strip():\n        errors.append(\"spec: a draft needs a spec to be published\")\n    if not body.acceptance:\n        errors.append(\"acceptance: a draft needs at least one criterion\")\n    elif any(not a.strip() for a in body.acceptance):\n        errors.append(\"acceptance: criteria cannot be blank\")\n    errors += [\n        f\"depends_on_drafts: {d} is not in this batch\"\n        for d in body.depends_on_drafts\n        if d not in batch and d not in outside\n    ]\n    return errors\n\n\ndef _order(\n    ids: list[str], edges: dict[str, list[str]]\n) -> tuple[list[str], dict[str, list[str]]]:\n    \"\"\"The batch in dependency order, and each draft on an in-batch cycle with\n    that cycle's path. Edges to drafts outside the batch are ignored here.\"\"\"\n    batch = set(ids)\n    deps = {i: [d for d in edges.get(i, []) if d in batch] for i in ids}\n    order: list[str] = []\n    done: set[str] = set()\n    while True:\n        ready = [i for i in ids if i not in done and all(d in done for d in deps[i])]\n        if not ready:\n            break\n        order += ready\n        done.update(ready)\n    cycles: dict[str, list[str]] = {}\n    for start in ids:\n        if start not in done and (path := _cycle_from(start, deps)):\n            cycles[start] = path\n    # Drafts left behind a cycle come last; they are skipped as not published.\n    return order + [i for i in ids if i not in done], cycles\n\n\ndef _cycle_from(start: str, deps: dict[str, list[str]]) -> list[str] | None:\n    \"\"\"A path start -> ... -> start along dependency edges, if one exists.\"\"\"\n    stack: list[tuple[str, list[str]]] = [(start, [start])]\n    seen: set[str] = set()\n    while stack:\n        node, path = stack.pop()\n        for dep in deps[node]:\n            if dep == start:\n                return [*path, start]\n            if dep not in seen:\n                seen.add(dep)\n                stack.append((dep, [*path, dep]))\n    return None\n\n\nasync def _check_capabilities(conn: aiosqlite.Connection, required: list[str]) -> None:\n    \"\"\"Each capability must be declared by a pool or a non-archived agent.\"\"\"\n    if not required:\n        return\n    async with conn.execute(\n        \"SELECT j.value FROM pools, json_each(pools.capabilities) AS j\"\n        \" UNION SELECT j.value FROM agents, json_each(agents.capabilities) AS j\"\n        \" WHERE agents.archived_at IS NULL\"\n    ) as cur:\n        known = {r[0] for r in await cur.fetchall()}\n    if unknown := [c for c in required if c not in known]:\n        raise ValidationFailedError(\n            \"no pool or agent declares these capabilities: \" + \", \".join(unknown),\n            code=\"unknown_capability\",\n            details=[f\"required_capabilities: {c}\" for c in unknown],\n        )\n\n\ndef _atomic_refusal(failed: list[PublishOutcome]) -> DomainError:\n    codes = [o.code for o in failed if o.code]\n    code = next((c for c in _PRECEDENCE if c in codes), codes[0] if codes else None)\n    cls = {\n        \"not_found\": NotFoundError,\n        \"stale_version\": ConflictError,\n        \"draft_published\": ConflictError,\n    }.get(code or \"\", ValidationFailedError)\n    details = [\n        f\"{o.draft_id}: {o.code or o.outcome}: {e}\" for o in failed for e in o.errors\n    ]\n    return cls(\n        f\"nothing was published: {len(failed)} draft(s) cannot be published\",\n        code=code if code in _PRECEDENCE else \"validation_failed\",\n        details=details,\n    )\n\n\ndef _rejected(draft_id: str, code: str, *errors: str) -> PublishOutcome:\n    return PublishOutcome(\n        draft_id=draft_id, outcome=\"rejected\", code=code, errors=list(errors)\n    )\n\n\ndef _digest(req: PublishRequest) -> str:\n    canonical = json.dumps(\n        {\n            \"mode\": req.mode,\n            \"drafts\": [[d.draft_id, d.expected_version] for d in req.drafts],\n        },\n        separators=(\",\", \":\"),\n    )\n    return hashlib.sha256(canonical.encode()).hexdigest()\n\n\n# -- rows --------------------------------------------------------------------\n\n\ndef _stored(body: TaskDraftBody) -> str:\n    # Only fields the author set: a kind's defaults still apply at publish.\n    return json.dumps(body.model_dump(mode=\"json\", exclude_unset=True), sort_keys=True)\n\n\ndef _errors(exc: ValidationError) -> list[str]:\n    return [\n        f\"{'.'.join(map(str, e['loc'])) or 'body'}: {e['msg']}\" for e in exc.errors()\n    ]\n\n\nasync def _row(conn: aiosqlite.Connection, draft_id: str) -> aiosqlite.Row:\n    async with conn.execute(\n        \"SELECT * FROM task_drafts WHERE id = ?\", (draft_id,)\n    ) as cur:\n        row = await cur.fetchone()\n    if row is None:\n        raise NotFoundError(f\"draft not found: {draft_id}\")\n    return row\n\n\nasync def _rows(conn: aiosqlite.Connection, ids: list[str]) -> dict[str, aiosqlite.Row]:\n    if not ids:\n        return {}\n    marks = \",\".join(\"?\" * len(ids))\n    sql = f\"SELECT * FROM task_drafts WHERE id IN ({marks})\"  # noqa: S608\n    async with conn.execute(sql, ids) as cur:\n        return {r[\"id\"]: r for r in await cur.fetchall()}\n\n\nasync def _open_row(\n    conn: aiosqlite.Connection, draft_id: str, expected_version: str\n) -> aiosqlite.Row:\n    row = await _row(conn, draft_id)\n    if row[\"published_at\"] is not None:\n        raise ConflictError(\n            f\"draft {draft_id} was published as task {row['published_task_id']};\"\n            \" edit the task instead\",\n            code=\"draft_published\",\n            details=[row[\"published_task_id\"]],\n        )\n    if row[\"updated_at\"] != expected_version:\n        raise ConflictError(\n            f\"draft {draft_id} changed since you read it (version\"\n            f\" {row['updated_at']}); read it again and reapply your change\",\n            code=\"stale_version\",\n            details=[row[\"updated_at\"]],\n        )\n    return row\n\n\ndef _to_draft(row: aiosqlite.Row) -> TaskDraft:\n    return TaskDraft(\n        id=row[\"id\"],\n        body=TaskDraftBody.model_validate_json(row[\"body\"]),\n        version=row[\"updated_at\"],\n        created_by=row[\"created_by\"],\n        created_at=row[\"created_at\"],\n        updated_by=row[\"updated_by\"],\n        updated_at=row[\"updated_at\"],\n        published_at=row[\"published_at\"],\n        published_task_id=row[\"published_task_id\"],\n    )\n","numLines":423,"startLine":1,"totalLines":423}},"tool_result_meta":[{"id":"toolu_014MdrHQPpvKzWxwBe74cGmV","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
