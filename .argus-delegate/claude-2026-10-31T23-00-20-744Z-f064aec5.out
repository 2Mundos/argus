{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Qzqd1zKoVj8fi3mpv2HT2d","type":"tool_result","content":"from datetime import UTC, datetime\nfrom pathlib import Path\n\nimport aiosqlite\nimport pytest\nfrom api_support import insert_agent\nfrom argus_api.accounts import service as accounts_service\nfrom argus_api.agents import service as _agents  # noqa: F401 - avoids an import cycle\nfrom argus_api.db import Database, MigrationError, ts\nfrom argus_api.db.migrate import Migration, load_migrations\nfrom argus_api.secrets import MemorySecretStore\nfrom argus_api.tasks import service as tasks\nfrom argus_api.tasks import steers\nfrom argus_core.accounts import AccountCreate\nfrom argus_core.tasks import TaskCreate\n\n\nasync def _user_version(path: Path) -> int:\n    async with (\n        aiosqlite.connect(path) as conn,\n        conn.execute(\"PRAGMA user_version\") as cur,\n    ):\n        row = await cur.fetchone()\n    assert row is not None\n    return row[0]\n\n\ndef test_shipped_migrations_load_in_order() -> None:\n    migrations = load_migrations()\n    assert [m.version for m in migrations] == list(range(1, len(migrations) + 1))\nasync def test_0060_upgrade_keeps_data_and_reopen_is_a_no_op(tmp_path: Path) -> None:\n    path = tmp_path / \"argus.db\"\n    migrations = load_migrations()\n    assert migrations[59].name == \"0060_account_auth_health_indexes.sql\"\n    db = await Database.open(path, migrations=migrations[:59])\n    [account_id] = await _accounts(db, \"claude-1\")\n    await _fill(db, [account_id], 3)\n    await db.close()\n    assert await _user_version(path) == 59\n\n    for _ in range(2):  # the upgrade, then a reopen that must change nothing\n        db = await Database.open(path, migrations=migrations)\n        async with db.read() as conn:\n            async with conn.execute(\n                \"SELECT name, sql FROM sqlite_master WHERE type = 'index'\"\n                \" AND name IN (?, ?) ORDER BY name\",\n                AUTH_HEALTH_INDEXES,\n            ) as cur:\n                indexes = [tuple(r) for r in await cur.fetchall()]\n            acct = await accounts_service.get_account(\n                conn, account_id, datetime(2026, 1, 2, tzinfo=UTC)\n            )\n        await db.close()\n        assert await _user_version(path) == len(migrations)\n        assert [name for name, _ in indexes] == sorted(AUTH_HEALTH_INDEXES)\n        assert all(\"WHERE\" in sql for _, sql in indexes)  # partial indexes\n        assert acct.last_accepted_at == datetime(2026, 1, 1, 0, 0, 2, 2, tzinfo=UTC)\n        assert acct.last_rejected_at == datetime(2026, 1, 1, 0, 0, 0, 2, tzinfo=UTC)\n\"\"\"Domain errors, mapped to HTTP with a stable `code` agents can act on.\"\"\"\n\n\nclass DomainError(Exception):\n    status = 400\n    code = \"bad_request\"\n\n    def __init__(\n        self, message: str, *, code: str | None = None, details: list[str] | None = None\n    ) -> None:\n        super().__init__(message)\n        self.message = message\n        self.details = details or []\n        if code:\n            self.code = code\n\n\nclass NotFoundError(DomainError):\n    status = 404\n    code = \"not_found\"\n\n\nclass ConflictError(DomainError):\n    status = 409\n    code = \"conflict\"\n\n\nclass LeaseConflictError(ConflictError):\n    \"\"\"The caller does not hold a valid lease on the task (worker lifecycle 3.3).\"\"\"\n\n\nclass UnauthorizedError(DomainError):\n    status = 401\n    code = \"invalid_token\"\n\n\nclass ForbiddenError(DomainError):\n    status = 403\n    code = \"forbidden\"\n\n\nclass ValidationFailedError(DomainError):\n    \"\"\"Input or result does not match its kind's schema; `details` lists why.\"\"\"\n\n    status = 422\n    code = \"validation_failed\"\n\n\nclass TooLargeError(DomainError):\n    status = 413\n    code = \"too_large\"\n\n\nclass RateLimitedError(DomainError):\n    status = 429\n    code = \"rate_limited\"","is_error":false}]},"parent_tool_use_id":null,"session_id":"e60805ed-c36d-4e22-8274-acc0a44d64d1","uuid":"06bde5fe-12ac-4c6f-a589-e7c3ff5f4995","timestamp":"2026-10-31T23:02:57.897Z","tool_use_result":{"stdout":"from datetime import UTC, datetime\nfrom pathlib import Path\n\nimport aiosqlite\nimport pytest\nfrom api_support import insert_agent\nfrom argus_api.accounts import service as accounts_service\nfrom argus_api.agents import service as _agents  # noqa: F401 - avoids an import cycle\nfrom argus_api.db import Database, MigrationError, ts\nfrom argus_api.db.migrate import Migration, load_migrations\nfrom argus_api.secrets import MemorySecretStore\nfrom argus_api.tasks import service as tasks\nfrom argus_api.tasks import steers\nfrom argus_core.accounts import AccountCreate\nfrom argus_core.tasks import TaskCreate\n\n\nasync def _user_version(path: Path) -> int:\n    async with (\n        aiosqlite.connect(path) as conn,\n        conn.execute(\"PRAGMA user_version\") as cur,\n    ):\n        row = await cur.fetchone()\n    assert row is not None\n    return row[0]\n\n\ndef test_shipped_migrations_load_in_order() -> None:\n    migrations = load_migrations()\n    assert [m.version for m in migrations] == list(range(1, len(migrations) + 1))\nasync def test_0060_upgrade_keeps_data_and_reopen_is_a_no_op(tmp_path: Path) -> None:\n    path = tmp_path / \"argus.db\"\n    migrations = load_migrations()\n    assert migrations[59].name == \"0060_account_auth_health_indexes.sql\"\n    db = await Database.open(path, migrations=migrations[:59])\n    [account_id] = await _accounts(db, \"claude-1\")\n    await _fill(db, [account_id], 3)\n    await db.close()\n    assert await _user_version(path) == 59\n\n    for _ in range(2):  # the upgrade, then a reopen that must change nothing\n        db = await Database.open(path, migrations=migrations)\n        async with db.read() as conn:\n            async with conn.execute(\n                \"SELECT name, sql FROM sqlite_master WHERE type = 'index'\"\n                \" AND name IN (?, ?) ORDER BY name\",\n                AUTH_HEALTH_INDEXES,\n            ) as cur:\n                indexes = [tuple(r) for r in await cur.fetchall()]\n            acct = await accounts_service.get_account(\n                conn, account_id, datetime(2026, 1, 2, tzinfo=UTC)\n            )\n        await db.close()\n        assert await _user_version(path) == len(migrations)\n        assert [name for name, _ in indexes] == sorted(AUTH_HEALTH_INDEXES)\n        assert all(\"WHERE\" in sql for _, sql in indexes)  # partial indexes\n        assert acct.last_accepted_at == datetime(2026, 1, 1, 0, 0, 2, 2, tzinfo=UTC)\n        assert acct.last_rejected_at == datetime(2026, 1, 1, 0, 0, 0, 2, tzinfo=UTC)\n\"\"\"Domain errors, mapped to HTTP with a stable `code` agents can act on.\"\"\"\n\n\nclass DomainError(Exception):\n    status = 400\n    code = \"bad_request\"\n\n    def __init__(\n        self, message: str, *, code: str | None = None, details: list[str] | None = None\n    ) -> None:\n        super().__init__(message)\n        self.message = message\n        self.details = details or []\n        if code:\n            self.code = code\n\n\nclass NotFoundError(DomainError):\n    status = 404\n    code = \"not_found\"\n\n\nclass ConflictError(DomainError):\n    status = 409\n    code = \"conflict\"\n\n\nclass LeaseConflictError(ConflictError):\n    \"\"\"The caller does not hold a valid lease on the task (worker lifecycle 3.3).\"\"\"\n\n\nclass UnauthorizedError(DomainError):\n    status = 401\n    code = \"invalid_token\"\n\n\nclass ForbiddenError(DomainError):\n    status = 403\n    code = \"forbidden\"\n\n\nclass ValidationFailedError(DomainError):\n    \"\"\"Input or result does not match its kind's schema; `details` lists why.\"\"\"\n\n    status = 422\n    code = \"validation_failed\"\n\n\nclass TooLargeError(DomainError):\n    status = 413\n    code = \"too_large\"\n\n\nclass RateLimitedError(DomainError):\n    status = 429\n    code = \"rate_limited\"","