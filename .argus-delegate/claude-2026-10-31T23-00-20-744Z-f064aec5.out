{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgb9sPBHwdq9dVoRa5CXC","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_015YYKE8mw6uLRSCZCLxXpFf","name":"Edit","input":{"replace_all":false,"file_path":"/workspace/agent/task-workspaces/030540ef-d69a-4c2c-839d-f4970e8c94d7/apps/api/src/argus_api/mcp_server.py","old_string":"@tool(MANAGERS)\nasync def steer_task(","new_string":"@tool(MANAGERS)\nasync def create_task_draft(ctx: Context, draft: TaskDraftBody) -> dict:\n    \"\"\"Save a task definition as a draft: nothing can claim, list or count it until\n    publish_task_drafts. `draft` takes create_task's fields (same rules) plus\n    depends_on_drafts (ids of other drafts; depends_on stays for existing tasks).\n    Title, spec, acceptance and project may be filled in later; publish requires\n    them. Returns the draft with its `version`.\"\"\"\n    return await _call(\n        ctx,\n        \"POST\",\n        \"/task-drafts\",\n        json=draft.model_dump(mode=\"json\", exclude_unset=True),\n    )\n\n\n@tool(MANAGERS)\nasync def list_task_drafts(ctx: Context) -> dict:\n    \"\"\"Open drafts, oldest first ({items, total}; at most 200, always whole).\"\"\"\n    return await _call(ctx, \"GET\", \"/task-drafts\")\n\n\n@tool(MANAGERS)\nasync def get_task_draft(ctx: Context, draft_id: str) -> dict:\n    \"\"\"One draft, open or published (then with published_task_id).\"\"\"\n    return await _call(ctx, \"GET\", f\"/task-drafts/{draft_id}\")\n\n\n@tool(MANAGERS)\nasync def edit_task_draft(\n    ctx: Context, draft_id: str, expected_version: str, changes: dict[str, Any]\n) -> dict:\n    \"\"\"Patch an open draft's fields: a field you leave out is kept, null resets it.\n    Pass the draft's `version` as expected_version (409 stale_version carries the\n    current one); a published draft is 409 draft_published.\"\"\"\n    return await _call(\n        ctx,\n        \"PATCH\",\n        f\"/task-drafts/{draft_id}\",\n        json={\"expected_version\": expected_version, \"changes\": changes},\n    )\n\n\n@tool(MANAGERS)\nasync def discard_task_draft(ctx: Context, draft_id: str, expected_version: str) -> str:\n    \"\"\"Delete an open draft (pass its `version`).\"\"\"\n    await _call(\n        ctx,\n        \"DELETE\",\n        f\"/task-drafts/{draft_id}\",\n        params={\"expected_version\": expected_version},\n    )\n    return \"discarded\"\n\n\n@tool(MANAGERS)\nasync def publish_task_drafts(\n    ctx: Context,\n    idempotency_key: str,\n    drafts: list[PublishItem],\n    mode: Literal[\"atomic\", \"partial\"] = \"atomic\",\n) -> dict:\n    \"\"\"Publish up to 50 drafts ([{draft_id, expected_version}]) as tasks in one\n    transaction: depends_on_drafts become the new task ids, cycles are refused, and\n    each draft needs a project, spec, acceptance and capabilities some pool or agent\n    declares. mode \"atomic\" (default) publishes all or nothing (the error lists each\n    failing draft); \"partial\" publishes the valid ones and returns an outcome per\n    draft (published | rejected | skipped). Retrying with the same idempotency_key\n    and drafts returns the first answer (replayed: true) and creates nothing.\"\"\"\n    return await _call(\n        ctx,\n        \"POST\",\n        \"/task-drafts/publish\",\n        json={\n            \"idempotency_key\": idempotency_key,\n            \"mode\": mode,\n            \"drafts\": [d.model_dump() for d in drafts],\n        },\n    )\n\n\n@tool(MANAGERS)\nasync def steer_task("},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2163,"cache_read_input_tokens":127188,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2163},"output_tokens":43,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"e60805ed-c36d-4e22-8274-acc0a44d64d1","uuid":"aa1d0fa9-e11f-41cc-b708-677b015244b3","timestamp":"2026-10-31T23:06:36.180Z","request_id":"req_011Cgb9sNapTdpZdxSZKdfxG","wire_tool_inputs":{"toolu_015YYKE8mw6uLRSCZCLxXpFf":{"file_path":"/workspace/agent/task-workspaces/030540ef-d69a-4c2c-839d-f4970e8c94d7/apps/api/src/argus_api/mcp_server.py","old_string":"@tool(MANAGERS)\nasync def steer_task(","new_string":"@tool(MANAGERS)\nasync def create_task_draft(ctx: Context, draft: TaskDraftBody) -> dict:\n    \"\"\"Save a task definition as a draft: nothing can claim, list or count it until\n    publish_task_drafts. `draft` takes create_task's fields (same rules) plus\n    depends_on_drafts (ids of other drafts; depends_on stays for existing tasks).\n    Title, spec, acceptance and project may be filled in later; publish requires\n    them. Returns the draft with its `version`.\"\"\"\n    return await _call(\n        ctx,\n        \"POST\",\n        \"/task-drafts\",\n        json=draft.model_dump(mode=\"json\", exclude_unset=True),\n    )\n\n\n@tool(MANAGERS)\nasync def list_task_drafts(ctx: Context) -> dict:\n    \"\"\"Open drafts, oldest first ({items, total}; at most 200, always whole).\"\"\"\n    return await _call(ctx, \"GET\", \"/task-drafts\")\n\n\n@tool(MANAGERS)\nasync def get_task_draft(ctx: Context, draft_id: str) -> dict:\n    \"\"\"One draft, open or published (then with published_task_id).\"\"\"\n    return await _call(ctx, \"GET\", f\"/task-drafts/{draft_id}\")\n\n\n@tool(MANAGERS)\nasync def edit_task_draft(\n    ctx: Context, draft_id: str, expected_version: str, changes: dict[str, Any]\n) -> dict:\n    \"\"\"Patch an open draft's fields: a field you leave out is kept, null resets it.\n    Pass the draft's `version` as expected_version (409 stale_version carries the\n    current one); a published draft is 409 draft_published.\"\"\"\n    return await _call(\n        ctx,\n        \"PATCH\",\n        f\"/task-drafts/{draft_id}\",\n        json={\"expected_version\": expected_version, \"changes\": changes},\n    )\n\n\n@tool(MANAGERS)\nasync def discard_task_draft(ctx: Context, draft_id: str, expected_version: str) -> str:\n    \"\"\"Delete an open draft (pass its `version`).\"\"\"\n    await _call(\n        ctx,\n        \"DELETE\",\n        f\"/task-drafts/{draft_id}\",\n        params={\"expected_version\": expected_version},\n    )\n    return \"discarded\"\n\n\n@tool(MANAGERS)\nasync def publish_task_drafts(\n    ctx: Context,\n    idempotency_key: str,\n    drafts: list[PublishItem],\n    mode: Literal[\"atomic\", \"partial\"] = \"atomic\",\n) -> dict:\n    \"\"\"Publish up to 50 drafts ([{draft_id, expected_version}]) as tasks in one\n    transaction: depends_on_drafts become the new task ids, cycles are refused, and\n    each draft needs a project, spec, acceptance and capabilities some pool or agent\n    declares. mode \"atomic\" (default) publishes all or nothing (the error lists each\n    failing draft); \"partial\" publishes the valid ones and returns an outcome per\n    draft (published | rejected | skipped). Retrying with the same idempotency_key\n    and drafts returns the first answer (replayed: true) and creates nothing.\"\"\"\n    return await _call(\n        ctx,\n        \"POST\",\n        \"/task-drafts/publish\",\n        json={\n            \"idempotency_key\": idempotency_key,\n            \"mode\": mode,\n            \"drafts\": [d.model_dump() for d in drafts],\n        },\n    )\n\n\n@tool(MANAGERS)\nasync def steer_task("}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015YYKE8mw6uLRSCZCLxXpFf","type":"tool_result","content":"The file /workspace/agent/task-workspaces/030540ef-d69a-4c2c-839d-f4970e8c94d7/apps/api/src/argus_api/mcp_server.py has been updated successfully."}]},"parent_tool_use_id":null,"session_id":"e60805ed-c36d-4e22-8274-acc0a44d64d1","uuid":"a75030a6-eab1-404e-a649-07f7854ffeb6","timestamp":"2026-10-31T23:06:36.194Z","tool_use_result":{"filePath":"/workspace/agent/task-workspaces/030540ef-d69a-4c2c-839d-f4970e8c94d7/apps/api/src/argus_api/mcp_server.py","oldString":"@tool(MANAGERS)\nasync def steer_task(","newString":"@tool(MANAGERS)\nasync def create_task_draft(ctx: Context, draft: TaskDraftBody) -> dict:\n    \"\"\"Save a task definition as a draft: nothing can claim, list or count it until\n    publish_task_drafts. `draft` takes create_task's fields (same rules) plus\n    depends_on_drafts (ids of other drafts; depends_on stays for existing tasks).\n    Title, spec, acceptance and project may be filled in later; publish requires\n    them. Returns the draft with its `version`.\"\"\"\n    return await _call(\n        ctx,\n        \"POST\",\n        \"/task-drafts\",\n        json=draft.model_dump(mode=\"json\", exclude_unset=True),\n    )\n\n\n@tool(MANAGERS)\nasync def list_task_drafts(ctx: Context) -> dict:\n    \"\"\"Open drafts, oldest first ({items, total}; at most 200, always whole).\"\"\"\n    return await _call(ctx, \"GET\", \"/task-drafts\")\n\n\n@tool(MANAGERS)\nasync def get_task_draft(ctx: Context, draft_id: str) -> dict:\n    \"\"\"One draft, open or published (then with published_task_id).\"\"\"\n    return await _call(ctx, \"GET\", f\"/task-drafts/{draft_id}\")\n\n\n@tool(MANAGERS)\nasync def edit_task_draft(\n    ctx: Context, draft_id: str, expected_version: str, changes: dict[str, Any]\n) -> dict:\n    \"\"\"Patch an open draft's fields: a field you leave out is kept, null resets it.\n    Pass the draft's `version` as expected_version (409 stale_version carries the\n    current one); a published draft is 409 draft_published.\"\"\"\n    return await _call(\n        ctx,\n        \"PATCH\",\n        f\"/task-drafts/{draft_id}\",\n        json={\"expected_version\": expected_version, \"changes\": changes},\n    )\n\n\n@tool(MANAGERS)\nasync def discard_task_draft(ctx: Context, draft_id: str, expected_version: str) -> str:\n    \"\"\"Delete an open draft (pass its `version`).\"\"\"\n    await _call(\n        ctx,\n        \"DELETE\",\n        f\"/task-drafts/{draft_id}\",\n        params={\"expected_version\": expected_version},\n    )\n    return \"discarded\"\n\n\n@tool(MANAGERS)\nasync def publish_task_drafts(\n    ctx: Context,\n    idempotency_key: str,\n    drafts: list[PublishItem],\n    mode: Literal[\"atomic\", \"partial\"] = \"atomic\",\n) -> dict:\n    \"\"\"Publish up to 50 drafts ([{draft_id, expected_version}]) as tasks in one\n    transaction: depends_on_drafts become the new task ids, cycles are refused, and\n    each draft needs a project, spec, acceptance and capabilities some pool or agent\n    declares. mode \"atomic\" (default) publishes all or nothing (the error lists each\n    failing draft); \"partial\" publishes the valid ones and returns an outcome per\n    draft (published | rejected | skipped). Retrying with the same idempotency_key\n    and drafts returns the first answer (replayed: true) and creates nothing.\"\"\"\n    return await _call(\n        ctx,\n        \"POST\",\n        \"/task-drafts/publish\",\n        json={\n            \"idempotency_key\": idempotency_key,\n            \"mode\": mode,\n            \"drafts\": [d.model_dump() for d in drafts],\n        },\n    )\n\n\n@tool(MANAGERS)\nasync def steer_task(","originalFile":"\"\"\"MCP endpoint for agents (worker lifecycle 3.7), served at /mcp/.\n\nEvery tool is a thin call to the REST API, made in-process with the agent's own\nbearer token. Scopes, validation, leases, and errors therefore behave exactly\nas over HTTP; this module holds no state or logic of its own.\n\nConnect with `Authorization: Bearer <agent token>` (or an admin token for the\norchestrator-style tools).\n\"\"\"\n\nfrom base64 import b64decode\nfrom collections.abc import AsyncGenerator, Callable\nfrom contextlib import asynccontextmanager\nfrom datetime import datetime\nfrom pathlib import Path\nfrom types import FunctionType\nfrom typing import Annotated, Any, Literal\nfrom urllib.parse import urlsplit\n\nimport httpx2 as httpx\nfrom argus_core.auth import Scope\nfrom argus_core.continuation import (\n    ChecklistReport,\n    ContinuationUpdate,\n    ObservationRequest,\n)\nfrom argus_core.task_edit import TaskChanges\nfrom argus_core.tasks import ExecutorModel, HarnessModel\nfrom fastapi import FastAPI\nfrom mcp.server.context import CallNext, HandlerResult, ServerRequestContext\nfrom mcp.server.mcpserver import Context, MCPServer\nfrom mcp.server.mcpserver.exceptions import ToolError\nfrom mcp.server.mcpserver.resources import TextResource\nfrom mcp.server.transport_security import TransportSecuritySettings\nfrom mcp.shared.exceptions import MCPError\nfrom mcp.types import INVALID_REQUEST\nfrom pydantic import BaseModel, Field\nfrom starlette.types import ASGIApp, Receive, Send\nfrom starlette.types import Scope as AsgiScope\n\nfrom argus_api.auth import authenticate\nfrom argus_api.errors import UnauthorizedError\n\nINSTRUCTIONS = \"\"\"\\\nArgus coordinates a fleet of agents. As a worker: claim_task, then work on it while\ncalling heartbeat (renews your leases) and report_progress; finish with complete_task\nor fail_task. Every task write needs the task's `attempt`; a 409 error means you no\nlonger hold the task, so stop working on it. If you need a human or orchestrator to\ndecide something, use ask_question (your task is paused until answered). Read the\nknowledge pages listed with each claimed task before starting; search_knowledge for\nmore, and write_knowledge when you learn something others will need. Lease provider\ncredentials only after claiming a task, with runtime_providers, task_id and attempt.\nIf an account runs out of quota, report_account_exhausted (same claim and providers)\nreturns fallback metadata; call lease_account to receive the next credential.\n\nAs an orchestrator, work the inbox: get_inbox lists what waits (blocked, in review,\nawaiting approval) with decision and artifact ids; list_decisions(view=\"detail\") or\nget_decision reads the questions (get_inbox(view=\"actionable\") gives, per row,\nwho may answer, what each answer does, what it holds up and labelled evidence: hints\nonly, nothing is executed); list_artifacts, verify_artifact and read_artifact\ncheck evidence; answer_decision or answer_decisions acts (give each answer a\nrequest_id, so retries are safe); get_tasks(ids) reads the effects back. edit_task changes a task's title, spec,\nacceptance, priority, capabilities, pins or dependencies (pass its `version`). Lists\nare paged: `total` counts every match, follow `next_cursor` while `has_more`. If a\ntool you need is missing, say which and stop; do not script REST around it.\n\nFor the fleet: inspect_pool shows what each instance is proven to run (a fact's\n`source`, or `unknown`); recycle_instance and drain_agent never interrupt claimed\nwork (recycle_instance(requeue=true) and release_task requeue it without costing an\nattempt); admins change options with update_pool(expected_version=the pool's version).\nget_agent_hygiene reports lost/gone aggregates and alerts; archive_agents (admin)\narchives old lost/gone identities in bounded batches. wait_for_events(subject_type,\nsubject_id) waits for the change to happen instead of polling; then inspect_pool or\nget_tasks reads back the effect. steer_task sends an instruction to the worker\nholding a claimed task; it arrives on that worker's next heartbeat.\n\nOrchestrators: read the skill at skill://argus-orchestrator/SKILL.md (also the\nprompt \"argus-orchestrator\") before acting: what you must and must not do.\"\"\"\n\nserver = MCPServer(\"argus\", version=\"0.1.0\", instructions=INSTRUCTIONS)\n\n# The orchestrator skill, in the Agent Skills format (SKILL.md), served as an MCP\n# resource and as a prompt so any connected client can load it (MCP operations 3.4).\nORCHESTRATOR_SKILL = (\n    Path(__file__).parent / \"skills\" / \"argus-orchestrator\" / \"SKILL.md\"\n).read_text()\nserver.add_resource(\n    TextResource(\n        uri=\"skill://argus-orchestrator/SKILL.md\",\n        name=\"argus-orchestrator\",\n        title=\"Argus orchestrator skill\",\n        description=\"What an orchestrator can and must do with the Argus tools.\",\n        mime_type=\"text/markdown\",\n        text=ORCHESTRATOR_SKILL,\n    )\n)\n\n\n@server.prompt(\n    name=\"argus-orchestrator\",\n    title=\"Argus orchestrator\",\n    description=\"Load the Argus orchestrator skill before running the fleet.\",\n)\ndef orchestrator_skill() -> str:\n    return ORCHESTRATOR_SKILL\n\n\n_app: FastAPI | None = None\n\n# Who a tool is listed to (MCP operations 3.4). Listing is not access control:\n# every call is still decided by the REST endpoint it forwards to.\nAGENTS = frozenset({Scope.WORKER, Scope.ORCHESTRATOR})\nMANAGERS = frozenset({Scope.ORCHESTRATOR, Scope.ADMIN})\nADMINS = frozenset({Scope.ADMIN})\nANYONE = frozenset(Scope)\naudiences: dict[str, frozenset[Scope]] = {}\n\n\ndef tool[F: FunctionType](audience: frozenset[Scope]) -> Callable[[F], F]:\n    def register(fn: F) -> F:\n        audiences[fn.__name__] = audience\n        return server.tool()(fn)\n\n    return register\n\n\nasync def _list_tools_for_caller(\n    ctx: ServerRequestContext[Any, Any], call_next: CallNext\n) -> HandlerResult:\n    \"\"\"Answer `tools/list` with only the tools the caller's scope can use.\"\"\"\n    result = await call_next(ctx)\n    # The SDK hands middleware the serialized result; tests pin that shape.\n    if ctx.method != \"tools/list\" or not isinstance(result, dict):\n        return result\n    headers = getattr(ctx.request, \"headers\", None) or {}\n    scheme, _, token = headers.get(\"authorization\", \"\").partition(\" \")\n    assert _app is not None\n    try:\n        if scheme.lower() != \"bearer\" or not token:\n            raise UnauthorizedError(\"missing bearer token\")\n        async with _app.state.db.read() as conn:\n            scope = (await authenticate(conn, token, now=_app.state.db.now())).scope\n    except UnauthorizedError as exc:\n        raise MCPError(INVALID_REQUEST, f\"401 unauthorized: {exc}\") from exc\n    tools = [t for t in result[\"tools\"] if scope in audiences[t[\"name\"]]]\n    return {**result, \"tools\": tools}\n\n\nserver.middleware.append(_list_tools_for_caller)\n\n\ndef bind(app: FastAPI) -> None:\n    \"\"\"Point the tools at the REST app they call into (set once at import).\"\"\"\n    global _app\n    _app = app\n\n\nclass SlashAlias:\n    \"\"\"Serve `/mcp` as well as `/mcp/`: some MCP clients do not follow a\n    redirect on POST.\"\"\"\n\n    def __init__(self, app: ASGIApp) -> None:\n        self.app = app\n\n    async def __call__(self, scope: AsgiScope, receive: Receive, send: Send) -> None:\n        if scope[\"type\"] == \"http\" and scope[\"path\"] == \"/mcp\":\n            scope = {**scope, \"path\": \"/mcp/\", \"raw_path\": b\"/mcp/\"}\n        await self.app(scope, receive, send)\n\n\nclass Endpoint:\n    \"\"\"The ASGI app mounted at /mcp. The SDK's session manager can run only once,\n    so each app lifespan builds a fresh one (`async with endpoint.running()`).\"\"\"\n\n    def __init__(self) -> None:\n        self._app: ASGIApp | None = None\n\n    @asynccontextmanager\n    async def running(self) -> AsyncGenerator[None]:\n        self._app = _build()\n        async with server.session_manager.run():\n            yield\n        self._app = None\n\n    async def __call__(self, scope: AsgiScope, receive: Receive, send: Send) -> None:\n        if self._app is None:\n            raise RuntimeError(\"MCP endpoint used outside the app lifespan\")\n        await self._app(scope, receive, send)\n\n\nendpoint = Endpoint()\n\n\ndef allowed_mcp_hosts(public_url: str | None) -> tuple[list[str], list[str]]:\n    \"\"\"Host/Origin allowlist for MCP DNS-rebinding protection.\"\"\"\n    hosts = [\n        \"localhost\",\n        \"localhost:*\",\n        \"127.0.0.1\",\n        \"127.0.0.1:*\",\n        \"[::1]\",\n        \"[::1]:*\",\n        \"host.docker.internal\",\n        \"host.docker.internal:*\",\n    ]\n    origins = [\n        \"http://localhost\",\n        \"http://localhost:*\",\n        \"https://localhost\",\n        \"https://localhost:*\",\n        \"http://127.0.0.1\",\n        \"http://127.0.0.1:*\",\n        \"https://127.0.0.1\",\n        \"https://127.0.0.1:*\",\n        \"http://[::1]\",\n        \"http://[::1]:*\",\n        \"https://[::1]\",\n        \"https://[::1]:*\",\n        \"http://host.docker.internal\",\n        \"http://host.docker.internal:*\",\n        \"https://host.docker.internal\",\n        \"https://host.docker.internal:*\",\n    ]\n    if public_url:\n        parsed = urlsplit(public_url)\n        host = parsed.hostname\n        if host:\n            if parsed.port:\n                hosts.append(f\"{host}:{parsed.port}\")\n                origins.append(f\"{parsed.scheme}://{host}:{parsed.port}\")\n            else:\n                hosts.append(host)\n                hosts.append(f\"{host}:*\")\n                origins.append(f\"{parsed.scheme}://{host}\")\n                origins.append(f\"{parsed.scheme}://{host}:*\")\n            # Containers often reach a local Argus as host.docker.internal:PORT.\n            if host in (\"localhost\", \"127.0.0.1\", \"::1\", \"host.docker.internal\"):\n                port = parsed.port or (443 if parsed.scheme == \"https\" else 80)\n                hosts.append(f\"host.docker.internal:{port}\")\n                origins.append(f\"{parsed.scheme}://host.docker.internal:{port}\")\n    return hosts, origins\n\n\ndef _build() -> ASGIApp:\n    public_url = None\n    if _app is not None and hasattr(_app.state, \"settings\"):\n        public_url = _app.state.settings.public_url\n    hosts, origins = allowed_mcp_hosts(public_url)\n    return server.streamable_http_app(\n        streamable_http_path=\"/\",\n        stateless_http=True,\n        json_response=True,\n        transport_security=TransportSecuritySettings(\n            enable_dns_rebinding_protection=True,\n            allowed_hosts=hosts,\n            allowed_origins=origins,\n        ),\n    )\n\n\nasync def _call(\n    ctx: Context,\n    method: str,\n    path: str,\n    *,\n    json: Any = None,\n    params: dict[str, Any] | None = None,\n    content: bytes | None = None,\n    headers: dict[str, str] | None = None,\n) -> Any:\n    raw = ((ctx.headers or {}).get(\"authorization\") or \"\").strip()\n    if not raw:\n        raise ToolError(\n            \"missing token: connect with the header 'Authorization: Bearer <token>'\"\n        )\n    # The REST layer authenticates through HTTPBearer, which requires the scheme.\n    # Forward the header verbatim, only adding \"Bearer \" when the client sent a\n    # bare token, so the downstream call is authenticated instead of rejected.\n    auth = raw if raw.lower().startswith(\"bearer \") else f\"Bearer {raw}\"\n    assert _app is not None\n    async with httpx.AsyncClient(\n        transport=httpx.ASGITransport(app=_app), base_url=\"http://argus\", timeout=60\n    ) as client:\n        res = await client.request(\n            method,\n            \"/api\" + path,\n            json=json,\n            params={k: v for k, v in (params or {}).items() if v is not None},\n            content=content,\n            headers={\"Authorization\": auth, **(headers or {})},\n        )\n    if not res.content:\n        body = None\n    elif res.headers.get(\"content-type\", \"\").startswith(\"text/plain\"):\n        body = res.text\n    else:\n        body = res.json()\n    if res.is_error:\n        raise ToolError(_describe(res.status_code, body))\n    return body\n\n\ndef _describe(status: int, body: Any) -> str:\n    detail = body.get(\"detail\") if isinstance(body, dict) else body\n    if isinstance(detail, dict):\n        text = f\"{status} {detail.get('code')}: {detail.get('message')}\"\n        if detail.get(\"details\"):\n            text += \" | \" + \"; \".join(map(str, detail[\"details\"]))\n        return text\n    if isinstance(detail, list):  # request validation\n        return f\"{status} invalid arguments: \" + \"; \".join(\n            f\"{'.'.join(map(str, e.get('loc', [])[1:]))}: {e.get('msg')}\"\n            for e in detail\n        )\n    return f\"{status}: {detail}\"\n\n\nclass Lease(BaseModel):\n    task_id: str\n    attempt: int\n    activity_at: datetime | None = None\n\n\nclass Runtime(BaseModel):\n    worker_version: str | None = None\n    engine: str | None = None\n    executor: str | None = None\n    features: list[str] = []\n\n\nViewArg = Literal[\"summary\", \"detail\"]\nInboxState = Literal[\"blocked\", \"in_review\", \"awaiting_approval\", \"pending\", \"claimed\"]\nTaskStateArg = Literal[\n    \"awaiting_approval\",\n    \"pending\",\n    \"ready\",\n    \"claimed\",\n    \"blocked\",\n    \"in_review\",\n    \"succeeded\",\n    \"failed\",\n    \"cancelled\",\n]\nDecisionKindArg = Literal[\"question\", \"approval\", \"review\", \"policy\", \"knowledge\"]\nArtifactRole = Literal[\n    \"report\", \"delegate_report\", \"policy_snapshot\", \"qa_receipt\", \"other\"\n]\n\n\n# -- working on tasks ---------------------------------------------------------------\n\n\n@tool(AGENTS)\nasync def claim_task(\n    ctx: Context,\n    capabilities: list[str] | None = None,\n    wait_s: float = 20,\n    runtime_providers: list[str] | None = None,\n) -> dict:\n    \"\"\"Claim the next task you can do, waiting up to wait_s seconds (max 30) for one.\n    `runtime_providers` are the account providers you can apply; a task restricted to\n    other providers (account_providers) is skipped and stays ready.\n    Returns the task (keep its `id` and `attempt`) with `knowledge_refs`: pages to\n    read first. `steer_unknown` > 0 means that many operator steers sent to the\n    previous attempt were never confirmed: they may or may not have been applied, so\n    check the work rather than assume either way. Returns {\"task\": null} when nothing\n    became ready.\"\"\"\n    task = await _call(\n        ctx,\n        \"POST\",\n        \"/tasks/claim\",\n        json={\n            \"capabilities\": capabilities or [],\n            \"wait_s\": wait_s,\n            \"runtime_providers\": runtime_providers or [],\n        },\n    )\n    return {\"task\": task}\n\n\n@tool(AGENTS)\nasync def heartbeat(\n    ctx: Context,\n    leases: list[Lease] | None = None,\n    runtime: Runtime | None = None,\n    steer_acks: list[str] | None = None,\n) -> dict:\n    \"\"\"Prove you are alive and renew the leases on tasks you hold. Call it at least\n    every heartbeat_interval_s (30 s). If a lease comes back rejected, stop working on\n    that task. If state is \"draining\", finish your task and then call leave.\n    `runtime` reports what you run (worker_version, engine, executor, features), if known.\n    `steers` in the answer are operator instructions to inject; send their ids back as\n    `steer_acks` once injected. A steer stays listed until you ack it or the attempt\n    ends; de-duplicate by id.\"\"\"\n    body: dict[str, Any] = {\n        \"leases\": [lease.model_dump() for lease in leases or []],\n        \"steer_acks\": steer_acks or [],\n    }\n    if runtime is not None:\n        body[\"runtime\"] = runtime.model_dump()\n    return await _call(ctx, \"POST\", \"/agents/me/heartbeat\", json=body)\n\n\n@tool(ANYONE)\nasync def get_task(ctx: Context, task_id: str) -> dict:\n    \"\"\"Read a task: spec, acceptance criteria, state, attempt, clarifications.\"\"\"\n    return await _call(ctx, \"GET\", f\"/tasks/{task_id}\")\n\n\n@tool(ANYONE)\nasync def get_task_log(\n    ctx: Context,\n    task_id: str,\n    attempt: int | None = None,\n    after: int | None = None,\n    limit: int = 200,\n) -> dict:\n    \"\"\"Read the live output log of a task attempt (default: the current one), as the\n    dashboard's \"Ao vivo\" panel shows it: {attempt, lines: [{seq, source, at, line}],\n    last_seq}. Without `after` you get the newest `limit` lines (max 1000); pass\n    `after`=last_seq to read on. Secrets are redacted. Workers read leased tasks only.\"\"\"\n    return await _call(\n        ctx,\n        \"GET\",\n        f\"/tasks/{task_id}/log\",\n        params={\"attempt\": attempt, \"after\": after, \"limit\": limit},\n    )\n\n\n@tool(ANYONE)\nasync def get_task_changes(\n    ctx: Context, task_id: str, attempt: int | None = None\n) -> dict:\n    \"\"\"Read what a task attempt (default: the current one) has changed in its\n    workspace, as the dashboard's Changes panel shows it: {branch, base, head,\n    commits, files: [{path, status, added, deleted, binary}], untracked, patch,\n    truncated, at}. 404 no_changes when the worker has posted none. Secrets are\n    redacted. Workers read leased tasks only.\"\"\"\n    return await _call(\n        ctx, \"GET\", f\"/tasks/{task_id}/changes\", params={\"attempt\": attempt}\n    )\n\n\n@tool(ANYONE)\nasync def get_tasks(ctx: Context, ids: list[str], view: ViewArg = \"summary\") -> dict:\n    \"\"\"Read up to 50 tasks in one call, in the order given; unknown ids come back in\n    `missing`. view=detail adds spec and result (long text cut, see `truncated`).\"\"\"\n    return await _call(\n        ctx, \"GET\", \"/tasks\", params={\"ids\": \",\".join(ids), \"view\": view}\n    )\n\n\n@tool(ANYONE)\nasync def list_artifacts(\n    ctx: Context,\n    task_id: str,\n    attempt: int | None = None,\n    role: ArtifactRole | None = None,\n) -> list[dict]:\n    \"\"\"A task's artifacts: name, attempt, role, size, sha256, and `in_result` (the\n    task's result lists it). Metadata only; read_artifact for content.\"\"\"\n    return await _call(\n        ctx,\n        \"GET\",\n        f\"/tasks/{task_id}/artifacts\",\n        params={\"attempt\": attempt, \"role\": role},\n    )\n\n\n@tool(ANYONE)\nasync def read_artifact(\n    ctx: Context, artifact_id: str, offset: int = 0, max_bytes: int = 16384\n) -> dict:\n    \"\"\"Read a text or JSON artifact as UTF-8 from byte `offset` (max_bytes ≤ 65536);\n    continue from `next_offset` until it is null. Other media types: `binary` true.\"\"\"\n    return await _call(\n        ctx,\n        \"GET\",\n        f\"/artifacts/{artifact_id}/text\",\n        params={\"offset\": offset, \"max_bytes\": max_bytes},\n    )\n\n\n@tool(ANYONE)\nasync def verify_artifact(ctx: Context, artifact_id: str) -> dict:\n    \"\"\"Re-hash an artifact's stored bytes against its recorded size and SHA-256.\n    `ok` means the bytes are intact, not that the content is acceptable.\"\"\"\n    return await _call(ctx, \"POST\", f\"/artifacts/{artifact_id}/verify\")\n\n\n@tool(AGENTS)\nasync def report_progress(\n    ctx: Context,\n    task_id: str,\n    attempt: int,\n    message: str,\n    percent: int | None = None,\n    kind: str | None = None,\n    data: dict | None = None,\n) -> dict:\n    \"\"\"Post a short progress note shown to humans (at most one per 10 s). It also\n    renews your lease on the task. Optional `kind` marks a milestone: commit_created\n    {branch, sha}, pr_opened {number, url}, ci_running|ci_passed|ci_failed {sha},\n    gate_failed {gate}, waiting_input; a milestone is not limited unless its kind repeats.\"\"\"\n    return await _call(\n        ctx,\n        \"POST\",\n        f\"/tasks/{task_id}/progress\",\n        json={\n            \"attempt\": attempt,\n            \"message\": message,\n            \"percent\": percent,\n            \"kind\": kind,\n            \"data\": data,\n        },\n    )\n\n\n@tool(AGENTS)\nasync def report_task_models(\n    ctx: Context,\n    task_id: str,\n    attempt: int,\n    executions: list[dict] | None = None,\n    selections: list[dict] | None = None,\n) -> dict:\n    \"\"\"Report which models ran for your task attempt, in two separate layers:\n    `harness` (your agent runtime) and `delegate` (a CLI implementer). Each execution\n    has a unique `key`, `layer`, `state` (selected|running|succeeded|failed|cancelled)\n    and optional runtime/engine/executor/provider/requested_model/configured_model/\n    observed_model + `evidence` (reported_by_runtime|cli_output|provider_response;\n    never claim an observed model from config), policy_revision, account_id,\n    delegation_id, run_key, resumed_from, error_code, started_at (omit if the model\n    never started), ended_at. Each selection has `key`, `layer`, `kind` (initial|\n    account_switch|model_switch|provider_switch|executor_switch|retry_no_fallback),\n    `reason_code` (priority|availability|compatibility|context|quota|error|policy),\n    a short `explanation`, from_*/to_* model/provider/executor/account_id,\n    alternatives, execution_key, outcome. Re-sending a key completes it; it never\n    overwrites. Never include credentials or prompts.\"\"\"\n    return await _call(\n        ctx,\n        \"POST\",\n        f\"/tasks/{task_id}/models\",\n        json={\n            \"attempt\": attempt,\n            \"executions\": executions or [],\n            \"selections\": selections or [],\n        },\n    )\n\n\n@tool(ANYONE)\nasync def get_task_models(ctx: Context, task_id: str) -> dict:\n    \"\"\"Which models ran for a task, per layer (harness vs delegate): every execution\n    across attempts with requested/configured/observed model and evidence, plus the\n    selection and fallback timeline. An unreported model is null / not_reported.\"\"\"\n    return await _call(ctx, \"GET\", f\"/tasks/{task_id}/models\")\n\n\n@tool(ANYONE)\nasync def get_agent_models(ctx: Context, agent_id: str) -> dict:\n    \"\"\"A worker's latest model per layer and its recent runs, with evidence.\"\"\"\n    return await _call(ctx, \"GET\", f\"/agents/{agent_id}/models\")\n\n\n@tool(AGENTS)\nasync def complete_task(\n    ctx: Context,\n    task_id: str,\n    attempt: int,\n    summary: str,\n    data: dict | None = None,\n    artifacts: list[str] | None = None,\n    account_id: str | None = None,\n    input_tokens: int | None = None,\n    output_tokens: int | None = None,\n    cost_usd: float | None = None,\n    checklist: list[ChecklistReport] | None = None,\n) -> dict:\n    \"\"\"Finish the task. `summary` says what you did (Markdown); `data` must match the\n    task kind's result schema if it has one; `artifacts` are ids from\n    upload_text_artifact. Report token usage and the account you used, if known.\n    `checklist` reports each acceptance item of the task's continuation contract by id\n    (status done needs evidence); any item not done sends the result to review instead\n    of success.\"\"\"\n    usage = {\n        \"account_id\": account_id,\n        \"input_tokens\": input_tokens,\n        \"output_tokens\": output_tokens,\n        \"cost_usd\": cost_usd,\n    }\n    result: dict[str, Any] = {\n        \"summary\": summary,\n        \"data\": data,\n        \"artifacts\": artifacts or [],\n        \"checklist\": [c.model_dump(mode=\"json\") for c in checklist or []],\n    }\n    if any(v is not None for v in usage.values()):\n        result[\"usage\"] = usage\n    return await _call(\n        ctx,\n        \"POST\",\n        f\"/tasks/{task_id}/complete\",\n        json={\"attempt\": attempt, \"result\": result},\n    )\n\n\n@tool(AGENTS)\nasync def fail_task(ctx: Context, task_id: str, attempt: int, error: str) -> dict:\n    \"\"\"Give up on the task, explaining why. It is retried (by you or another agent)\n    until it runs out of attempts.\"\"\"\n    return await _call(\n        ctx, \"POST\", f\"/tasks/{task_id}/fail\", json={\"attempt\": attempt, \"error\": error}\n    )\n\n\n@tool(AGENTS)\nasync def ask_question(\n    ctx: Context,\n    task_id: str,\n    attempt: int,\n    question: str,\n    options: list[str] | None = None,\n    audience: Literal[\"any\", \"orchestrator\", \"human\"] = \"any\",\n    category: Literal[\"decision\", \"assistance\"] = \"decision\",\n    resource: str | None = None,\n) -> dict:\n    \"\"\"Ask for a real choice of scope, cost or permission that you cannot make yourself.\n    Your task is paused (its lease is released) until someone answers; the answer is\n    recorded as an effective decision and in the spec's \"Clarifications\" history, and\n    the task becomes claimable again. Never ask whether to run a gate, accept a partial\n    result or verify merged work: resolve facts within your authorization.\n    A missing tool, credential or service is `category=\"assistance\"` with the `resource`\n    name: it goes to the orchestrator (never a human) and is not a decision about the\n    goal. 409 already_answered: the question has an effective answer (in the message).\"\"\"\n    return await _call(\n        ctx,\n        \"POST\",\n        f\"/tasks/{task_id}/ask\",\n        json={\n            \"attempt\": attempt,\n            \"question\": question,\n            \"options\": options,\n            \"audience\": audience,\n            \"category\": category,\n            \"resource\": resource,\n        },\n    )\n\n\n@tool(ANYONE)\nasync def get_task_continuation(ctx: Context, task_id: str) -> dict:\n    \"\"\"The continuation contract of a task: phase (implement | resume | reconcile | qa |\n    close_evidence), known branch/PR/commit artifacts with provenance and observation\n    time, preserved WIP, the last interruption, the checklist with evidence, effective\n    decisions (newest first) and `gaps` (what Argus does not know: unknown is not\n    absent). Merged is not accepted: pending items stay pending.\"\"\"\n    return await _call(ctx, \"GET\", f\"/tasks/{task_id}/continuation\")\n\n\n@tool(ANYONE)\nasync def task_resumability_preflight(\n    ctx: Context,\n    task_id: str,\n    expected_attempt: int | None = None,\n    expected_version: str | None = None,\n) -> dict:\n    \"\"\"Read-only resumability preflight for a task: attempt/lease state, WIP class\n    (published vs local_only vs unknown), and whether shared attachments are currently\n    available by re-reading size and SHA-256. Recorded metadata and historical\n    receipts do not prove current availability. Grants nothing: no merge, deploy or\n    Production access. Optional expected_attempt / expected_version make a mismatch\n    `stale` instead of describing a newer state. The REST route enforces the task\n    read rule (managers global; workers only tasks they hold or held).\"\"\"\n    return await _call(\n        ctx,\n        \"GET\",\n        f\"/tasks/{task_id}/resumability\",\n        params={\n            \"expected_attempt\": expected_attempt,\n            \"expected_version\": expected_version,\n        },\n    )\n\n\n@tool(ANYONE)\nasync def get_task_delivery(ctx: Context, task_id: str) -> dict | None:\n    \"\"\"Bounded read-only delivery projection for a task's PR (inbox review evidence).\n    Top-level: pr, pr_state (open|merged|closed|unknown; unknown means unread, not open),\n    merged_at, checked_at, flags, accept_decision_id / accept_blocked.\n    Additive: task, head/base (source+sha+checked_at), merge, exact-head checks/statuses\n    (pending|skipped|failed|…), checks_combined, required_gates (null when unknown),\n    review evidence, checklist and authorization separately, stale, partial, disclosures.\n    Green checks do not authorize merge; merge is not acceptance. null: no unambiguous PR.\"\"\"\n    return await _call(ctx, \"GET\", f\"/tasks/{task_id}/delivery\")\n\n\n@tool(ANYONE)\nasync def get_task_prerequisites(\n    ctx: Context, task_id: str, expected_base: str | None = None\n) -> dict:\n    \"\"\"Evidence for each direct dependency of a task: whether it is forge-merged\n    (optionally on expected_base) or has a listed artifact re-verified on disk.\n    task_succeeded is reported separately and is never folded into verdict.\n    enforced is always false; depends_on semantics are unchanged. unknown when the\n    forge or artifact cannot be read — never inferred from titles or closed PRs.\"\"\"\n    return await _call(\n        ctx,\n        \"GET\",\n        f\"/tasks/{task_id}/prerequisites\",\n        params={\"expected_base\": expected_base},\n    )\n\n\n@tool(AGENTS)\nasync def report_observations(\n    ctx: Context, task_id: str, attempt: int, observations: ObservationRequest\n) -> dict:\n    \"\"\"Report what you saw of the live system for the task you hold: artifact state\n    (PR open/merged/closed, head sha), environment readiness per resource\n    (installed, credential_usable, reachable, permitted, validated) and preserved WIP.\n    Idempotent; Argus stores it with runtime provenance and flags contradictions.\"\"\"\n    body = observations.model_dump(mode=\"json\", exclude_none=True)\n    body[\"attempt\"] = attempt\n    return await _call(ctx, \"POST\", f\"/tasks/{task_id}/observations\", json=body)\n\n\n@tool(MANAGERS)\nasync def update_task_continuation(\n    ctx: Context, task_id: str, update: ContinuationUpdate\n) -> dict:\n    \"\"\"Settle continuation facts the runtime cannot: phase, artifacts, WIP, checklist\n    items and evidence, environment status, decisions to retire. Pass the contract's\n    `revision` as expected_revision (409 stale_continuation otherwise). Recorded with\n    orchestrator provenance and audited.\"\"\"\n    return await _call(\n        ctx,\n        \"PATCH\",\n        f\"/tasks/{task_id}/continuation\",\n        json=update.model_dump(mode=\"json\", exclude_none=True),\n    )\n\n\n@tool(ANYONE)\nasync def create_task(\n    ctx: Context,\n    title: str,\n    project: str | None = None,\n    spec: str = \"\",\n    kind: str = \"generic\",\n    parent_id: str | None = None,\n    depends_on: list[str] | None = None,\n    required_capabilities: list[str] | None = None,\n    priority: int = 0,\n    acceptance: list[str] | None = None,\n    knowledge: list[str] | None = None,\n    difficulty: Literal[\"trivial\", \"simple\", \"standard\", \"hard\"] | None = None,\n    difficulty_source: Literal[\"declared\", \"inferred\"] | None = None,\n    complexity: Literal[\"trivial\", \"standard\", \"hard\"] | None = None,\n    account_providers: list[str] | None = None,\n    harness_model: HarnessModel | None = None,\n    executor_model: ExecutorModel | None = None,\n    harness_account: str | None = None,\n) -> dict:\n    \"\"\"Create a task. Workers may only create subtasks of a task they hold (set\n    parent_id; the project is inherited). Orchestrators create any task and must name\n    a project. `knowledge` pins pages the claiming agent should read. `difficulty`:\n    \"trivial\" (a copy change, a typo) or \"simple\" take the cheap Cursor executor\n    (composer-2.5), trivial first on the node's local model with the cloud as the\n    fallback; \"standard\" (the default) the Claude or Codex executor; \"hard\"\n    (architecture, data migration, security, several services) the strong model (Opus).\n    Omit it and Argus infers one conservatively from the title and spec.\n    `difficulty_source` is \"declared\" by default; send \"inferred\" when the level is\n    your suggestion (editable later). A failed attempt for context overflow or a\n    failed verification raises it one level. `complexity` is the deprecated name\n    (trivial | standard | hard) and is used only when `difficulty` is absent.\n    `account_providers` (e.g. [\"local\"]) restricts the task to those engine account\n    providers; leave it out for no restriction. `harness_model` ({engine: claude |\n    codex, model}) and `executor_model` ({executor: claude | codex | agent, model})\n    pin the engine/executor and its model for every attempt, with no fallback chain;\n    the task then only runs on that provider's accounts. Leave them out to follow\n    the model policy. `harness_account` (an account id or name, e.g. \"strata-local\"\n    or a custom OpenRouter account) pins the engine lease to that one account: the\n    task waits as awaiting_quota while it cannot serve and never runs on another.\n    Local and custom accounts bring their own model, so pair them with no\n    harness_model; a local (Strata) harness delegates only to the Cursor agent.\"\"\"\n    body: dict[str, Any] = {\n        \"title\": title,\n        \"project\": project,\n        \"spec\": spec,\n        \"kind\": kind,\n        \"parent_id\": parent_id,\n        \"depends_on\": depends_on or [],\n        \"priority\": priority,\n        \"acceptance\": acceptance or [],\n        \"knowledge\": knowledge or [],\n    }\n    if required_capabilities is not None:\n        body[\"required_capabilities\"] = required_capabilities\n    if difficulty is not None or complexity is not None:\n        body[\"difficulty\"] = difficulty or complexity\n    if difficulty_source is not None:\n        body[\"difficulty_source\"] = difficulty_source\n    if account_providers is not None:\n        body[\"account_providers\"] = account_providers\n    if harness_model is not None:\n        body[\"harness_model\"] = harness_model.model_dump()\n    if executor_model is not None:\n        body[\"executor_model\"] = executor_model.model_dump()\n    if harness_account is not None:\n        body[\"harness_account\"] = harness_account\n    return await _call(ctx, \"POST\", \"/tasks\", json=body)\n\n\n@tool(AGENTS)\nasync def upload_text_artifact(\n    ctx: Context,\n    task_id: str,\n    attempt: int,\n    name: str,\n    content: str,\n    media_type: str = \"text/plain\",\n    role: ArtifactRole | None = None,\n) -> dict:\n    \"\"\"Attach a text file (report, diff, log, notes) to the task you hold. Pass the\n    returned id in complete_task's `artifacts`. Names: letters, digits, . _ -\n    `role`: report (yours), delegate_report (a delegate's original), policy_snapshot,\n    qa_receipt, other.\"\"\"\n    return await _call(\n        ctx,\n        \"POST\",\n        f\"/tasks/{task_id}/artifacts\",\n        params={\"attempt\": attempt, \"name\": name, \"role\": role},\n        content=content.encode(),\n        headers={\"Content-Type\": media_type},\n    )\n\n\n@tool(MANAGERS)\nasync def attach_artifact(\n    ctx: Context,\n    task_id: str,\n    name: str,\n    content: str | None = None,\n    content_base64: str | None = None,\n    media_type: str = \"text/plain\",\n    role: ArtifactRole | None = None,\n    share_with_workers: bool = False,\n    expected_sha256: str | None = None,\n) -> dict:\n    \"\"\"Attach evidence to any task without a lease: pass text as `content` or binary\n    (screenshot, ZIP) as `content_base64`. Returns the artifact (id, name, media_type,\n    size, sha256, source \"attachment\"), never its bytes. Immutable; names: letters,\n    digits, . _ - Only orchestrators and admins can read attachments, unless\n    `share_with_workers` is true: then any worker leased on the task can list,\n    verify and read it as a task input. `expected_sha256` (64 lowercase hex): a\n    different hash of the decoded bytes is 422 integrity_mismatch and attaches\n    nothing. For small text only: upload anything you would have to transcribe\n    with scripts/attach_artifact.py instead.\"\"\"\n    if (content is None) == (content_base64 is None):\n        raise ToolError(\"pass exactly one of content or content_base64\")\n    data = _attachment_bytes(content, content_base64)\n    return await _call(\n        ctx,\n        \"POST\",\n        f\"/tasks/{task_id}/attachments\",\n        params={\n            \"name\": name,\n            \"role\": role,\n            \"worker_readable\": \"true\" if share_with_workers else None,\n            \"expected_sha256\": expected_sha256,\n        },\n        content=data,\n        headers={\"Content-Type\": media_type},\n    )\n\n\n@tool(MANAGERS)\nasync def list_task_inputs(ctx: Context, task_id: str) -> dict:\n    \"\"\"A task's inputs: attachments shared with workers, each with id, name, size,\n    sha256, attached_by and `receipts` (latest per attempt and state: materialized,\n    verified, consumed, failed with a reason). `unshared_attachments` counts\n    attachments workers cannot see. Metadata only, never content.\"\"\"\n    return await _call(ctx, \"GET\", f\"/tasks/{task_id}/inputs\")\n\n\ndef _attachment_bytes(content: str | None, content_base64: str | None) -> bytes:\n    \"\"\"Decode an attachment, checking the size before any encode or decode. Errors\n    never quote the content.\"\"\"\n    assert _app is not None\n    limit: int = _app.state.settings.artifact_max_bytes\n    too_large = ToolError(f\"413 too_large: artifact exceeds the {limit}-byte limit\")\n    if content is not None:\n        if len(content) > limit:  # every character is at least one UTF-8 byte\n            raise too_large\n        try:\n            data = content.encode()  # at most 4 * limit bytes\n        except UnicodeEncodeError:\n            raise ToolError(\"content is not valid UTF-8 text\") from None\n    else:\n        assert content_base64 is not None\n        if len(content_base64) > 4 * -(-limit // 3):  # longest base64 of `limit`\n            raise too_large\n        try:\n            data = b64decode(content_base64, validate=True)\n        except ValueError:\n            raise ToolError(\"content_base64 is not valid base64\") from None\n    if len(data) > limit:\n        raise too_large\n    return data\n\n\n@tool(AGENTS)\nasync def leave(ctx: Context) -> dict:\n    \"\"\"End your identity cleanly (when drained or shutting down). Any task you still\n    hold is released for someone else.\"\"\"\n    return await _call(ctx, \"POST\", \"/agents/me/leave\")\n\n\n# -- knowledge ---------------------------------------------------------------------------\n\n\n@tool(ANYONE)\nasync def search_knowledge(\n    ctx: Context, query: str, project: str | None = None, limit: int = 10\n) -> list[dict]:\n    \"\"\"Search the shared knowledge base (titles, summaries, bodies, tags). Stale pages\n    are marked and ranked last; verify them before relying on them.\"\"\"\n    return await _call(\n        ctx,\n        \"GET\",\n        \"/knowledge/search\",\n        params={\"q\": query, \"project\": project, \"limit\": limit},\n    )\n\n\n@tool(ANYONE)\nasync def get_knowledge_page(\n    ctx: Context, page_id: str, revision: int | None = None\n) -> dict:\n    \"\"\"Read a knowledge page (Markdown body). Keep `revision_id` if you plan to edit it.\"\"\"\n    return await _call(\n        ctx, \"GET\", f\"/knowledge/pages/{page_id}\", params={\"revision\": revision}\n    )\n\n\n@tool(ANYONE)\nasync def write_knowledge(\n    ctx: Context,\n    title: str,\n    body: str,\n    reason: str,\n    summary: str = \"\",\n    tags: list[str] | None = None,\n    project: str = \"global\",\n    page_id: str | None = None,\n    base_revision_id: str | None = None,\n) -> dict:\n    \"\"\"Record something others will need. Without page_id this creates a page; with\n    page_id and base_revision_id (from get_knowledge_page) it edits it, and fails with\n    knowledge_conflict if someone changed it meanwhile (re-read and retry). Depending\n    on settings, your change is published or proposed for review (see `status`).\"\"\"\n    content = {\n        \"title\": title,\n        \"body\": body,\n        \"summary\": summary,\n        \"tags\": tags or [],\n        \"reason\": reason,\n    }\n    if page_id is None:\n        return await _call(\n            ctx, \"POST\", \"/knowledge/pages\", json={**content, \"project\": project}\n        )\n    if base_revision_id is None:\n        raise ToolError(\"editing needs base_revision_id: read the page first\")\n    return await _call(\n        ctx,\n        \"POST\",\n        f\"/knowledge/pages/{page_id}/revisions\",\n        json={**content, \"base_revision_id\": base_revision_id},\n    )\n\n\n# -- provider accounts --------------------------------------------------------------------\n\n\n@tool(MANAGERS)\nasync def get_fleet_yield(ctx: Context, window_hours: int = 24) -> dict:\n    \"\"\"Fleet yield over `window_hours` (1-720): attempt success rate, measured vs\n    not-reported attempt coverage, and tokens/cost per succeeded task. Unknown\n    usage is never zero. The `yield` block of GET /api/fleet/health.\"\"\"\n    health = await _call(ctx, \"GET\", \"/fleet/health\", params={\"window\": window_hours})\n    return health.get(\"yield\", health)\n\n\n@tool(MANAGERS)\nasync def get_dead_session_recovery(ctx: Context, window_hours: int = 24) -> dict:\n    \"\"\"Dead-session recovery latency over `window_hours` (1-720): from each\n    `session_lost` fail (observed lost; not a death timestamp) to the task's next\n    `task.claim` by event id after a requeue. Coverage, denominator, outliers vs\n    the 5 min target, and percentiles only when enough measured samples exist\n    (never a fabricated median). `pending` (still waiting) and `pending_overdue`\n    (waiting at least the target; a lower bound, never in the percentiles) are\n    censored; `ended_unclaimed` were requeued but the task ended without a claim;\n    `anomalous` includes clock rollback. The `dead_session_recovery` block of\n    GET /api/fleet/health.\"\"\"\n    health = await _call(ctx, \"GET\", \"/fleet/health\", params={\"window\": window_hours})\n    return health.get(\"dead_session_recovery\", health)\n\n\n@tool(MANAGERS)\nasync def list_accounts(ctx: Context) -> dict:\n    \"\"\"Provider accounts with what each reports about its quota. Per account:\n    `quota` (provider windows: used_percent is the share USED, with reset and\n    observed_at), `credit` (money left on a key, in USD, never tokens),\n    `quota_status` (state known|stale|unknown, a `reason` code saying why a figure\n    is missing, the last probe's outcome and code) and token usage. A missing figure\n    is unknown, never zero. `last_accepted_at` / `last_rejected_at` are the latest\n    measured output and recorded authentication rejection (null when none).\n    Read-only; no credentials.\"\"\"\n    return {\"accounts\": await _call(ctx, \"GET\", \"/accounts\")}\n\n\n@tool(MANAGERS)\nasync def refresh_account_quota(ctx: Context, account_id: str) -> dict:\n    \"\"\"Read one account's quota from its provider now (a read-only request; at most\n    once per account per 5 minutes; never refreshes the login). Returns the outcome\n    (updated|skipped|rate_limited|failed, with a `code`), the stored windows and\n    credit, and the account's resulting `quota_status`.\"\"\"\n    return await _call(ctx, \"POST\", f\"/accounts/{account_id}/quota/refresh\")\n\n\n@tool(AGENTS)\nasync def lease_account(\n    ctx: Context,\n    runtime_providers: list[str],\n    task_id: str,\n    attempt: int,\n) -> dict:\n    \"\"\"Get a provider account for a currently claimed task.\n\n    `runtime_providers` is required and lists providers this runtime can apply;\n    `task_id` and `attempt` must identify your live task claim. The best eligible\n    account is selected by priority.\"\"\"\n    return await _call(\n        ctx,\n        \"POST\",\n        \"/accounts/lease\",\n        json={\n            \"runtime_providers\": runtime_providers,\n            \"task_id\": task_id,\n            \"attempt\": attempt,\n        },\n    )\n\n\n@tool(AGENTS)\nasync def report_account_exhausted(\n    ctx: Context,\n    account_id: str,\n    runtime_providers: list[str],\n    task_id: str,\n    attempt: int,\n    reason: str = \"\",\n    until: str | None = None,\n) -> dict:\n    \"\"\"Mark your leased account exhausted for a live claimed task.\n\n    Returns fallback account metadata only. Obtain any next credential with\n    `lease_account`; `runtime_providers` and the live claim are required.\n    `until` is the provider's reset time (ISO 8601), if known.\"\"\"\n    return await _call(\n        ctx,\n        \"POST\",\n        f\"/accounts/{account_id}/exhausted\",\n        json={\n            \"reason\": reason,\n            \"until\": until,\n            \"runtime_providers\": runtime_providers,\n            \"task_id\": task_id,\n            \"attempt\": attempt,\n        },\n    )\n\n\n# -- orchestration ---------------------------------------------------------------------------\n\n\n@tool(MANAGERS)\nasync def get_inbox(\n    ctx: Context,\n    project: str | None = None,\n    states: list[InboxState] | None = None,\n    decision_kinds: list[DecisionKindArg] | None = None,\n    blocking_only: bool = False,\n    order: Literal[\"age\", \"impact\"] = \"age\",\n    view: Literal[\"summary\", \"detail\", \"actionable\"] = \"summary\",\n    forge: bool = False,\n    limit: int = 25,\n    cursor: str | None = None,\n) -> dict:\n    \"\"\"What waits on you, oldest first (order=impact: most blocked tasks first): blocked, in-review and awaiting-approval\n    tasks with their open decision (id, kind, audience) and current artifact ids,\n    pending tasks stuck on a failed or cancelled dependency (`failed_dependencies`:\n    retry it or set_task_dependencies), plus open pool and knowledge decisions. Each row\n    has `blocks` (the tasks it holds up) and `impact`; `groups` count open decisions,\n    oldest age and stalled tasks per project/task. blocking_only=true keeps rows that\n    block a task. Totals by state and decision kind cover every match. view=detail\n    adds each task and decision in full. view=actionable adds `actionable` per row\n    (at most 25 rows, 64 KB): the question and spec excerpt (cut text names its\n    full read), authority (`caller_may_attempt` is not a grant; the real call is\n    re-checked), each option's effect, direct/transitive impact, checklist, WIP,\n    transfer and delivery evidence with `source` (worker_claim is unverified) and\n    `status`, and a `next` hint Argus never executes. forge=true adds up to 5 live\n    PR reads, after `snapshot_at` and outside it (`external`); a stored state they\n    contradict is `conflict`.\"\"\"\n    return await _call(\n        ctx,\n        \"GET\",\n        \"/inbox\",\n        params={\n            \"project\": project,\n            \"state\": states,\n            \"decision_kind\": decision_kinds,\n            \"blocking_only\": blocking_only,\n            \"order\": order,\n            \"view\": view,\n            \"forge\": forge or None,\n            \"limit\": limit,\n            \"cursor\": cursor,\n        },\n    )\n\n\n@tool(MANAGERS)\nasync def list_tasks(\n    ctx: Context,\n    states: list[TaskStateArg] | None = None,\n    project: str | None = None,\n    kind: str | None = None,\n    assignee: str | None = None,\n    view: ViewArg = \"summary\",\n    limit: int = 25,\n    cursor: str | None = None,\n    q: str | None = None,\n) -> dict:\n    \"\"\"List tasks, newest first, in pages (limit ≤ 100). Summary rows carry state\n    and ids (decisions, artifacts, dependencies), not the spec or result.\n    `assignee` (an agent id) narrows to the tasks that agent holds now.\n    Optional `q` is literal case-insensitive substring search over title and spec\n    (at most 8 whitespace-separated terms ≤ 64 chars); matching rows carry\n    `matches` snippets. Text match is not duplicate detection.\"\"\"\n    return await _call(\n        ctx,\n        \"GET\",\n        \"/tasks\",\n        params={\n            \"state\": states,\n            \"project\": project,\n            \"kind\": kind,\n            \"assignee\": assignee,\n            \"view\": view,\n            \"limit\": limit,\n            \"cursor\": cursor,\n            \"q\": q,\n        },\n    )\n\n\n@tool(MANAGERS)\nasync def edit_task(\n    ctx: Context, task_id: str, expected_version: str, changes: TaskChanges\n) -> dict:\n    \"\"\"Edit a task's definition: title, spec, acceptance, priority,\n    required_capabilities, knowledge (pinned page ids), depends_on,\n    account_providers, difficulty (trivial | simple | standard | hard; not clearable),\n    harness_model ({engine, model}), executor_model ({executor, model}) and\n    harness_account (an account id or name). `changes` is a partial patch: a field\n    you leave out is kept, null clears spec, acceptance, required_capabilities,\n    knowledge, depends_on, account_providers (no restriction), a model pin (back to\n    the policy) or the harness account pin (any account). Pass the task's `version` as\n    expected_version (409 stale_version carries the current one). The task's\n    `editable_fields` says what its state allows: ready, pending and\n    awaiting_approval tasks take everything; blocked, claimed and in_review only\n    priority; finished ones nothing (409 task_not_editable). Returns the task with\n    its new `version`. Nothing is written when any field is refused.\"\"\"\n    return await _call(\n        ctx,\n        \"PATCH\",\n        f\"/tasks/{task_id}\",\n        json={\n            \"expected_version\": expected_version,\n            \"changes\": changes.model_dump(mode=\"json\", exclude_unset=True),\n        },\n    )\n\n\n@tool(MANAGERS)\nasync def set_task_dependencies(\n    ctx: Context, task_id: str, depends_on: list[str], expected_version: str\n) -> dict:\n    \"\"\"Replace a waiting task's dependencies (pending, awaiting_approval or ready);\n    pass its `version` as expected_version. Drop a failed or cancelled dependency\n    to release a stuck task. Cycles are refused (422 dependency_cycle).\"\"\"\n    return await _call(\n        ctx,\n        \"PUT\",\n        f\"/tasks/{task_id}/dependencies\",\n        json={\"depends_on\": depends_on, \"expected_version\": expected_version},\n    )\n\n\n@tool(MANAGERS)\nasync def steer_task(ctx: Context, task_id: str, message: str) -> dict:\n    \"\"\"Send an instruction to the worker holding this claimed task. 409 not_claimed\n    if it is not claimed, 409 steer_unsupported if that worker does not report the\n    steer feature, 409 too_many_pending after 10 waiting steers, 429 rate_limited\n    more than once a second. If the attempt ends first, the steer expires, or becomes\n    unknown (it may have been delivered) when a heartbeat had carried it.\"\"\"\n    return await _call(\n        ctx, \"POST\", f\"/tasks/{task_id}/steers\", json={\"message\": message}\n    )\n\n\n@tool(MANAGERS)\nasync def list_task_steers(\n    ctx: Context, task_id: str, attempt: int | None = None\n) -> dict:\n    \"\"\"Steers for one attempt (the current one, when attempt is omitted), oldest first:\n    pending, delivered, cancelled, expired or unknown (sent to the worker, never\n    confirmed: it may have been delivered).\"\"\"\n    return await _call(\n        ctx, \"GET\", f\"/tasks/{task_id}/steers\", params={\"attempt\": attempt}\n    )\n\n\n@tool(MANAGERS)\nasync def cancel_steer(ctx: Context, task_id: str, steer_id: str) -> dict:\n    \"\"\"Cancel a pending steer (409 not_pending otherwise). A delivered steer cannot\n    be taken back; send another one.\"\"\"\n    return await _call(ctx, \"DELETE\", f\"/tasks/{task_id}/steers/{steer_id}\")\n\n\n@tool(MANAGERS)\nasync def unblock_task(ctx: Context, task_id: str) -> dict:\n    \"\"\"Return a blocked task to ready without answering its question (the question\n    is cancelled). To answer it, use answer_decision instead.\"\"\"\n    return await _call(ctx, \"POST\", f\"/tasks/{task_id}/unblock\")\n\n\n@tool(MANAGERS)\nasync def retry_task(ctx: Context, task_id: str) -> dict:\n    \"\"\"Give a failed task a fresh window of attempts (409 task_not_failed otherwise).\"\"\"\n    return await _call(ctx, \"POST\", f\"/tasks/{task_id}/retry\")\n\n\n@tool(MANAGERS)\nasync def release_task(\n    ctx: Context, task_id: str, reason: str, attempt: int | None = None\n) -> dict:\n    \"\"\"Take a claimed task back from its worker and requeue it without counting a\n    failed attempt (e.g. to free a worker for a recycle). `reason` is required;\n    pass `attempt` to release only that claim (409 stale_attempt otherwise). 409\n    task_not_claimed if it is not claimed.\"\"\"\n    body: dict = {\"reason\": reason}\n    if attempt is not None:\n        body[\"attempt\"] = attempt\n    return await _call(ctx, \"POST\", f\"/tasks/{task_id}/release\", json=body)\n\n\n@tool(MANAGERS)\nasync def cancel_task(ctx: Context, task_id: str) -> dict:\n    \"\"\"Cancel a task (orchestrators and admins).\"\"\"\n    return await _call(ctx, \"POST\", f\"/tasks/{task_id}/cancel\")\n\n\n@tool(MANAGERS)\nasync def list_agents(ctx: Context, state: str | None = None) -> list[dict]:\n    \"\"\"List agents (active, draining, gone, lost) and how many tasks each holds.\"\"\"\n    return await _call(ctx, \"GET\", \"/agents\", params={\"state\": state})\n\n\n@tool(MANAGERS)\nasync def get_agent_hygiene(ctx: Context) -> dict:\n    \"\"\"Lost and gone aggregates by pool and age, claim holders, and the lost spike.\"\"\"\n    return await _call(ctx, \"GET\", \"/agents/hygiene\")\n\n\n@tool(ADMINS)\nasync def archive_agents(\n    ctx: Context,\n    states: list[str],\n    older_than_days: int | None = None,\n    limit: int = 200,\n    dry_run: bool = False,\n) -> dict:\n    \"\"\"Archive lost/gone identities older than N days (admin). dry_run counts only.\n    With no older_than_days and no ARGUS_AGENT_ARCHIVE_AFTER_DAYS, returns 409.\"\"\"\n    body: dict = {\"states\": states, \"limit\": limit, \"dry_run\": dry_run}\n    if older_than_days is not None:\n        body[\"older_than_days\"] = older_than_days\n    return await _call(ctx, \"POST\", \"/agents/archive\", json=body)\n\n\n@tool(MANAGERS)\nasync def list_pools(ctx: Context) -> list[dict]:\n    \"\"\"List worker pools with desired/max replicas and live instances. `env` shows\n    keys only; values are write-only.\"\"\"\n    return await _call(ctx, \"GET\", \"/pools\")\n\n\n@tool(MANAGERS)\nasync def inspect_pool(ctx: Context, name: str) -> dict:\n    \"\"\"A pool with its live instances and agents, and per instance what is proven\n    about what runs: image, image_digest, worker_version, capabilities, engine,\n    executor, ready. Each fact has a `source` (configured < requested < started <\n    validated) or `unknown`: never read unknown as success.\"\"\"\n    return await _call(ctx, \"GET\", f\"/pools/{name}/inspect\")\n\n\n@tool(ADMINS)\nasync def update_pool(\n    ctx: Context,\n    name: str,\n    expected_version: str,\n    image: str | None = None,\n    capabilities: list[str] | None = None,\n    desired_replicas: int | None = None,\n    max_replicas: int | None = None,\n    agents_per_instance: int | None = None,\n    env: dict[str, str | None] | None = None,\n    cpus: float | None = None,\n    memory_mb: int | None = None,\n    docker: dict | None = None,\n    kubernetes: dict | None = None,\n    nanoclaw: dict | None = None,\n) -> dict:\n    \"\"\"Change some of a pool's options, keeping the rest (admin only). Pass the\n    pool's `version` as expected_version; 409 stale_version means it changed: read\n    it again. `env` merges (null removes a key). Name, target, runtime are fixed.\"\"\"\n    changes = {\n        \"image\": image,\n        \"capabilities\": capabilities,\n        \"desired_replicas\": desired_replicas,\n        \"max_replicas\": max_replicas,\n        \"agents_per_instance\": agents_per_instance,\n        \"env\": env,\n        \"cpus\": cpus,\n        \"memory_mb\": memory_mb,\n        \"docker\": docker,\n        \"kubernetes\": kubernetes,\n        \"nanoclaw\": nanoclaw,\n    }\n    body = {k: v for k, v in changes.items() if v is not None}\n    return await _call(\n        ctx,\n        \"PATCH\",\n        f\"/pools/{name}\",\n        json={\"expected_version\": expected_version, **body},\n    )\n\n\n@tool(MANAGERS)\nasync def get_instance(ctx: Context, instance_id: str) -> dict:\n    \"\"\"One instance: state, draining, image and digest, and its agents.\"\"\"\n    return await _call(ctx, \"GET\", f\"/instances/{instance_id}\")\n\n\n@tool(MANAGERS)\nasync def get_instance_logs(\n    ctx: Context, instance_id: str, tail: Annotated[int, Field(ge=1, le=500)] = 200\n) -> dict:\n    \"\"\"The last `tail` lines (max 500) of an instance's container output, read live\n    from its target.\"\"\"\n    logs = await _call(\n        ctx, \"GET\", f\"/instances/{instance_id}/logs\", params={\"tail\": tail}\n    )\n    return {\"logs\": logs}\n\n\n@tool(MANAGERS)\nasync def drain_agent(ctx: Context, agent_id: str) -> dict:\n    \"\"\"Let an agent finish its current task, then claim nothing new.\"\"\"\n    return await _call(ctx, \"POST\", f\"/agents/{agent_id}/drain\")\n\n\n@tool(MANAGERS)\nasync def recycle_instance(\n    ctx: Context, instance_id: str, requeue: bool = False\n) -> dict:\n    \"\"\"Replace a running instance: its agents drain, it stops once none holds a\n    claimed task, then a new one starts. By default work finishes first; with\n    `requeue` its claimed tasks are released now (no attempt counted) so it stops\n    on the next pass. Follow it with inspect_pool.\"\"\"\n    return await _call(\n        ctx, \"POST\", f\"/instances/{instance_id}/recycle\", json={\"requeue\": requeue}\n    )\n\n\n@tool(MANAGERS)\nasync def scale_pool(ctx: Context, name: str, desired_replicas: int) -> dict:\n    \"\"\"Set how many instances a pool should run. Above the pool's cap, a human is\n    asked to approve instead (the result carries a decision_id).\"\"\"\n    return await _call(\n        ctx, \"POST\", f\"/pools/{name}/scale\", json={\"desired_replicas\": desired_replicas}\n    )\n\n\n@tool(MANAGERS)\nasync def list_decisions(\n    ctx: Context,\n    state: Literal[\"open\", \"answered\", \"cancelled\"] = \"open\",\n    subject_id: str | None = None,\n    project: str | None = None,\n    kinds: list[DecisionKindArg] | None = None,\n    view: ViewArg = \"summary\",\n    limit: int = 25,\n    cursor: str | None = None,\n) -> dict:\n    \"\"\"Decisions (questions, approvals, reviews, policy, knowledge), oldest first, in\n    pages. Summary rows have options but not the question; view=detail adds it.\"\"\"\n    return await _call(\n        ctx,\n        \"GET\",\n        \"/decisions\",\n        params={\n            \"state\": state,\n            \"subject_id\": subject_id,\n            \"project\": project,\n            \"kind\": kinds,\n            \"view\": view,\n            \"limit\": limit,\n            \"cursor\": cursor,\n        },\n    )\n\n\n@tool(MANAGERS)\nasync def get_decision(ctx: Context, decision_id: str) -> dict:\n    \"\"\"Read one decision in full: question, options, payload, answer.\"\"\"\n    return await _call(ctx, \"GET\", f\"/decisions/{decision_id}\")\n\n\n@tool(MANAGERS)\nasync def preview_decision(\n    ctx: Context,\n    decision_id: str,\n    choice: str | None = None,\n    text: str = \"\",\n    request_id: str | None = None,\n) -> dict:\n    \"\"\"See what answering would do, before you answer: whether you may, whether the\n    choice is valid, the task transition and side effects, and stored observations\n    that contradict the decision's premise (for example a PR head that moved). Read-only\n    and advisory: it authorizes and executes nothing, and makes no live forge call. A\n    snapshot; answer_decision still checks everything itself.\"\"\"\n    return await _call(\n        ctx,\n        \"GET\",\n        f\"/decisions/{decision_id}/preview\",\n        params={\"choice\": choice, \"text\": text, \"request_id\": request_id},\n    )\n\n\n@tool(MANAGERS)\nasync def answer_decision(\n    ctx: Context,\n    decision_id: str,\n    choice: str | None = None,\n    text: str = \"\",\n    request_id: str | None = None,\n) -> dict:\n    \"\"\"Answer an open decision addressed to you: one of its options as `choice`\n    (e.g. approve/reject, accept/reject), and/or a text answer or notes. Pass a\n    fresh `request_id` so a retry returns the stored answer (`replayed`), not 409.\"\"\"\n    return await _call(\n        ctx,\n        \"POST\",\n        f\"/decisions/{decision_id}/answer\",\n        json={\"choice\": choice, \"text\": text, \"request_id\": request_id},\n    )\n\n\nclass Answer(BaseModel):\n    decision_id: str\n    choice: str | None = None\n    text: str = \"\"\n    request_id: str | None = None\n\n\n@tool(MANAGERS)\nasync def answer_decisions(ctx: Context, answers: list[Answer]) -> dict:\n    \"\"\"Answer up to 20 decisions at once, each with its own explicit answer (as in\n    answer_decision). Each is applied on its own: read `results[i].ok` and `error`\n    per item; one failure does not stop the others.\"\"\"\n    return await _call(\n        ctx,\n        \"POST\",\n        \"/decisions/answers\",\n        json={\"answers\": [a.model_dump() for a in answers]},\n    )\n\n\n@tool(MANAGERS)\nasync def wait_for_events(\n    ctx: Context,\n    after: int | None = None,\n    wait_s: Annotated[float, Field(ge=0, le=30)] = 20,\n    subject_type: str | None = None,\n    subject_id: str | None = None,\n    inbox: bool = False,\n) -> dict:\n    \"\"\"Wait for what happens next instead of polling: events after cursor `after`\n    (oldest first, ≤100), or up to wait_s seconds (max 30) for the first one.\n    Without `after`, waits from now. Pass back `next_cursor`; `timed_out` means\n    nothing happened. Filter by subject, e.g. (\"instance\", id) or (\"task\", id).\n    inbox=true wakes only on what adds a get_inbox row (a decision opened, a task\n    blocked/in review/awaiting approval, a dependency failed); then get_inbox.\"\"\"\n    return await _call(\n        ctx,\n        \"GET\",\n        \"/events/wait\",\n        params={\n            \"after\": after,\n            \"wait_s\": wait_s,\n            \"subject_type\": subject_type,\n            \"subject_id\": subject_id,\n            \"inbox\": inbox,\n        },\n    )\n\n\n@tool(MANAGERS)\nasync def get_fleet_capabilities(ctx: Context) -> dict:\n    \"\"\"What this node can actually run, measured now: each target's reachability,\n    OCI runtimes and resources, and per pool whether a worker can be launched\n    (`launchable`, `blockers`, per-check detail; ok=null means unverified).\"\"\"\n    return await _call(ctx, \"GET\", \"/fleet/capabilities\")\n\n\n@tool(MANAGERS)\nasync def launch_worker(\n    ctx: Context,\n    pool: str,\n    expected_desired_replicas: int | None = None,\n    unconditional: bool = False,\n) -> dict:\n    \"\"\"Request one more worker from a pool (adds 1 to its desired replicas, up to\n    its cap). The result means *requested*, not running: poll list_pools or\n    get_fleet_capabilities. Required: the pool's current desired_replicas as\n    expected_desired_replicas; a retry with the same value cannot launch twice\n    (409 stale_pool). unconditional=true instead skips that check and a retry can\n    add another worker. Neither, or both, is 422 and changes nothing.\"\"\"\n    return await _call(\n        ctx,\n        \"POST\",\n        f\"/pools/{pool}/launch\",\n        json={\n            \"expected_desired_replicas\": expected_desired_replicas,\n            \"unconditional\": unconditional,\n        },\n    )\n\n\n@tool(MANAGERS)\nasync def list_worker_templates(ctx: Context) -> dict:\n    \"\"\"The worker templates this node supports, per node: `ready`, or `missing`\n    (what to set up). Only a ready template can be created. Read-only. Defaults\n    (suggested pool name, quantity 1, cap) are in each template's `defaults`.\"\"\"\n    return await _call(ctx, \"GET\", \"/fleet/templates\")\n\n\n@tool(MANAGERS)\nasync def create_worker(\n    ctx: Context,\n    template: str,\n    name: str,\n    node: str = \"local\",\n    quantity: int = 1,\n    image: str | None = None,\n    advanced: dict | None = None,\n) -> dict:\n    \"\"\"Create a pool from a ready template and request `quantity` workers (default\n    1). `name` is required and is the idempotency key: repeating a call is 409\n    pool_exists, never a second worker (take a free name from `defaults.name` in\n    list_worker_templates). Image, runtime, and options come from the template; `image` is only for\n    argus-worker and must be one it offers. `advanced` (capabilities, env,\n    extra_hosts, max_replicas) is admin only. The result means *requested*, not running: follow\n    it with list_pools. A name that exists is 409 pool_exists (use launch_worker).\"\"\"\n    return await _call(\n        ctx,\n        \"POST\",\n        \"/fleet/workers\",\n        json={\n            \"template\": template,\n            \"node\": node,\n            \"name\": name,\n            \"quantity\": quantity,\n            \"image\": image,\n            \"advanced\": advanced,\n        },\n    )\n\n\n@tool(MANAGERS)\nasync def get_workspace_cleanup(ctx: Context) -> dict:\n    \"\"\"Cleanup of terminated NanoClaw instance directories: settings in effect,\n    last run, counts per status (eligible/preserved/blocked/cleaned/failed), bytes\n    estimated vs freed (approximate), and the latest blocked or failed rows.\"\"\"\n    return await _call(ctx, \"GET\", \"/fleet/workspace-cleanup\")\n\n\n@tool(MANAGERS)\nasync def list_workspace_cleanup(\n    ctx: Context,\n    status: Literal[\"eligible\", \"preserved\", \"blocked\", \"cleaned\", \"failed\"]\n    | None = None,\n    limit: Annotated[int, Field(ge=1, le=500)] = 100,\n    offset: Annotated[int, Field(ge=0)] = 0,\n) -> dict:\n    \"\"\"Per-directory workspace cleanup audit rows (reason codes, attempts, bytes,\n    archive path), most recently updated first, with a total.\"\"\"\n    return await _call(\n        ctx,\n        \"GET\",\n        \"/fleet/workspace-cleanup/instances\",\n        params={\"status\": status, \"limit\": limit, \"offset\": offset},\n    )\n\n\n@tool(MANAGERS)\nasync def run_workspace_cleanup(\n    ctx: Context,\n    dry_run: bool = True,\n    wait_s: Annotated[float, Field(ge=0, le=30)] = 5,\n) -> dict:\n    \"\"\"Start a workspace cleanup run now and wait up to wait_s for it. A dry run\n    (the default) only reports. dry_run=false deletes terminated instances'\n    directories after archiving their WIP: admin only, needs cleanup enabled.\"\"\"\n    return await _call(\n        ctx,\n        \"POST\",\n        \"/fleet/workspace-cleanup/run\",\n        json={\"dry_run\": dry_run, \"wait_s\": wait_s},\n    )\n\n\n# -- settings ---------------------------------------------------------------------------\n\n\n@tool(ANYONE)\nasync def get_settings(ctx: Context, project: str | None = None) -> dict:\n    \"\"\"Typed settings: global values, or effective values for a project (override, else\n    global, else default). Each entry has `key`, `value`, `source` (project | global |\n    default | env | file). `models` is the effective model policy; `review.independent`\n    gates code delivery with a different-model review.\"\"\"\n    path = f\"/projects/{project}/settings\" if project else \"/settings\"\n    return await _call(ctx, \"GET\", path)\n\n\n@tool(ADMINS)\nasync def set_setting(\n    ctx: Context, key: str, value: Any, project: str | None = None\n) -> dict:\n    \"\"\"Set a typed setting (admin only). `project` writes a project override; omit it\n    for the global value. Unknown keys and values that fail the key's schema are 422;\n    a key not settable at that scope is 422 scope_not_allowed.\"\"\"\n    path = f\"/projects/{project}/settings/{key}\" if project else f\"/settings/{key}\"\n    return await _call(ctx, \"PUT\", path, json={\"value\": value})\n\n\n@tool(ADMINS)\nasync def reset_setting(ctx: Context, key: str, project: str | None = None) -> dict:\n    \"\"\"Remove a stored setting so the inherited value applies (admin only). For global\n    `models` this restores the repository defaults; for a project it drops the override.\"\"\"\n    path = f\"/projects/{project}/settings/{key}\" if project else f\"/settings/{key}\"\n    return await _call(ctx, \"DELETE\", path)\n\n\n# -- routines ---------------------------------------------------------------------------\n\n\n@tool(ANYONE)\nasync def list_routines(ctx: Context, project: str) -> list[dict]:\n    \"\"\"A project's routines: schedule, timezone, template, findings mode, `enabled`,\n    `next_run_at` and `next_slots` (the next three slots, UTC, enabled or not).\"\"\"\n    return await _call(ctx, \"GET\", f\"/projects/{project}/routines\")\n\n\n@tool(ANYONE)\nasync def get_routine(ctx: Context, routine_id: str) -> dict:\n    \"\"\"One routine with its next three slots and its most recent run tasks.\"\"\"\n    return await _call(ctx, \"GET\", f\"/routines/{routine_id}\")\n\n\n@tool(MANAGERS)\nasync def upsert_routine(\n    ctx: Context,\n    project: str,\n    slug: str,\n    title: str,\n    schedule: str,\n    template: dict | None = None,\n    timezone: str = \"UTC\",\n    findings: Literal[\"off\", \"approval\", \"auto\"] = \"approval\",\n    enabled: bool = True,\n) -> dict:\n    \"\"\"Create or replace a routine. `schedule` is 5-field cron or @hourly, @daily,\n    @weekly in the IANA `timezone`. `template` holds task fields (kind, title, spec,\n    acceptance, input, required_capabilities, priority, review, difficulty,\n    harness_model, executor_model), checked with the task create rules; a bad one is\n    a 422 on save. `findings: auto`, or changing an auto routine, is admin only.\"\"\"\n    return await _call(\n        ctx,\n        \"PUT\",\n        f\"/projects/{project}/routines/{slug}\",\n        json={\n            \"title\": title,\n            \"schedule\": schedule,\n            \"timezone\": timezone,\n            \"template\": template or {},\n            \"findings\": findings,\n            \"enabled\": enabled,\n        },\n    )\n\n\n@tool(MANAGERS)\nasync def set_routine_enabled(\n    ctx: Context, project: str, slug: str, enabled: bool\n) -> dict:\n    \"\"\"Enable or disable a routine. Enabling recomputes `next_run_at` from now;\n    enabling an `auto` routine is admin only.\"\"\"\n    return await _call(\n        ctx,\n        \"PATCH\",\n        f\"/projects/{project}/routines/{slug}\",\n        json={\"enabled\": enabled},\n    )\n\n\n@tool(MANAGERS)\nasync def run_routine(ctx: Context, routine_id: str) -> dict:\n    \"\"\"Run a routine now, even while it is disabled or routines are paused. Returns\n    `task_id`, or `skipped: previous_running` (and no task) while its previous run\n    task is not terminal.\"\"\"\n    return await _call(ctx, \"POST\", f\"/routines/{routine_id}/run\")\n\n\n# -- preferred models -------------------------------------------------------------------\n\n\n@tool(ANYONE)\nasync def get_model_policy(ctx: Context) -> dict:\n    \"\"\"The effective model policy: `harness` and `implementation` maps (engine -> ordered\n    model chain), `revision`, `source` (env | file | defaults), and `env_overrides` (true\n    means ARGUS_MODEL_POLICY wins over saved edits). IDs are opaque; availability at the\n    provider is not checked.\"\"\"\n    return await _call(ctx, \"GET\", \"/models\")\n\n\n@tool(ADMINS)\nasync def set_model_policy(ctx: Context, harness: dict, implementation: dict) -> dict:\n    \"\"\"Replace the whole model policy (admin only). Both maps are required; each maps an\n    engine (codex, claude, opencode, agent) to a nonempty chain of at most 10 distinct\n    model IDs. A bad chain is a 422 naming it. New NanoClaw instances pick it up.\"\"\"\n    return await _call(\n        ctx,\n        \"PUT\",\n        \"/models\",\n        json={\"harness\": harness, \"implementation\": implementation},\n    )\n\n\n@tool(ADMINS)\nasync def reset_model_policy(ctx: Context) -> dict:\n    \"\"\"Remove the saved model policy so the shipped defaults apply again (admin only).\"\"\"\n    return await _call(ctx, \"DELETE\", \"/models\")\n\n\n# -- engines and the local model ---------------------------------------------------------\n\n\n@tool(ANYONE)\nasync def list_engines(ctx: Context) -> dict:\n    \"\"\"Engines (claude, codex, opencode, cursor-agent) and the local model. Each entry\n    lists its `layers`: the NanoClaw `harness` and the code `executor` (claude and codex\n    have both, cursor-agent and opencode only the executor). Every layer has its own\n    `readiness` (installed, authenticated, validated; ok=null is unknown), `accounts` and\n    `usable` (true only when all three hold). Validating one layer proves nothing about\n    the other. The top-level `readiness`, `accounts`, `usable` and `role` are the\n    deprecated single-layer view. Read-only.\"\"\"\n    return await _call(ctx, \"GET\", \"/engines\")\n\n\n@tool(MANAGERS)\nasync def route_task(\n    ctx: Context,\n    summary: str,\n    simple: bool = False,\n    low_risk: bool = False,\n    criteria_deterministic: bool = False,\n    multi_file: bool = False,\n    touches_sensitive: bool = False,\n    is_code: bool = False,\n    input_chars: int | None = None,\n    output_tokens: int = 512,\n    difficulty: Literal[\"trivial\", \"simple\", \"standard\", \"hard\"] | None = None,\n) -> dict:\n    \"\"\"Decide where a task should run: the local model, or codex/claude, and which code\n    executor and model do the work. `difficulty` (the task's, when it has one) replaces\n    `simple` (trivial and simple mean simple) and picks the executor chain: trivial and\n    simple Cursor with composer-2.5, standard Claude or Codex, hard the strong model;\n    an executor that is not usable is skipped, in chain order, with the reason.\n    The local model is chosen only if the task is simple, low risk, has deterministic acceptance criteria,\n    is not sensitive and, unless it is routed to the NanoClaw harness with the Cursor\n    executor (a `difficulty`, whose executor is `agent`), is not multi-file, and `input_chars` (everything the model would see:\n    instructions, tool schemas, history, inputs) provably fits. Unknown size never goes\n    local. Needs the orchestrator or admin scope. The decision and its reason are recorded.\"\"\"\n    return await _call(\n        ctx,\n        \"POST\",\n        \"/engines/route\",\n        json={\n            \"summary\": summary,\n            \"simple\": simple,\n            \"low_risk\": low_risk,\n            \"criteria_deterministic\": criteria_deterministic,\n            \"multi_file\": multi_file,\n            \"touches_sensitive\": touches_sensitive,\n            \"is_code\": is_code,\n            \"input_chars\": input_chars,\n            \"output_tokens\": output_tokens,\n            \"difficulty\": difficulty,\n        },\n    )\n\n\n@tool(ANYONE)\nasync def run_local(\n    ctx: Context,\n    prompt: str,\n    system: str | None = None,\n    criteria: dict | None = None,\n    max_output_tokens: int = 512,\n    max_attempts: int = 1,\n) -> dict:\n    \"\"\"Run one bounded completion on the local model (no tools, no side effects) and\n    check it against `criteria` ({json_schema, must_contain, equals, max_chars}).\n    `verdict` is `accepted` (use `text`) or `escalate`: then do the work with\n    `escalate_to` yourself. Cost is unknown (null), not zero. Use route_task first.\"\"\"\n    return await _call(\n        ctx,\n        \"POST\",\n        \"/engines/local/run\",\n        json={\n            \"prompt\": prompt,\n            \"system\": system,\n            \"criteria\": criteria or {},\n            \"max_output_tokens\": max_output_tokens,\n            \"max_attempts\": max_attempts,\n        },\n    )\n\n\n@tool(ANYONE)\nasync def get_project_runtime(ctx: Context, project: str) -> dict:\n    \"\"\"A project's declared runtime (approved components, test services), the gaps\n    it records, and every derived image: state (preparing, building, verifying,\n    ready, failed), the reason, probe evidence, the base image and the digest.\n    `ready` always means every probe passed; read `failed` reasons, never infer.\"\"\"\n    return await _call(ctx, \"GET\", f\"/projects/{project}/runtime\")\n\n\n@tool(ADMINS)\nasync def set_project_runtime(\n    ctx: Context,\n    project: str,\n    components: list[dict],\n    services: list[dict] | None = None,\n    codex_turn_timeout_s: int | None = None,\n) -> dict:\n    \"\"\"Declare what a project's tasks need in their image. `components` are\n    {id, version?, required?} from GET /runtime/catalog (python, pango, graft, psql,\n    postgres-server, valkey, node, git, chromium; pnpm, sops-age, minio, elasticsearch\n    are recorded as gaps with required=false). `services` are disposable test services\n    {kind: postgres|valkey, env: {VARIABLE: \"{url}\"}}. Never Dockerfile text: an\n    unapproved declaration is refused with every problem (422 runtime_invalid).\"\"\"\n    return await _call(\n        ctx,\n        \"PUT\",\n        f\"/projects/{project}/runtime\",\n        json={\n            \"components\": components,\n            \"services\": services or [],\n            \"codex_turn_timeout_s\": codex_turn_timeout_s,\n        },\n    )\n\n\n@tool(ADMINS)\nasync def rebuild_project_runtime(ctx: Context, project: str) -> dict:\n    \"\"\"Retry the failed derived-image builds of the project's current recipe and\n    return its runtime-held tasks to ready. A changed declaration does this itself.\"\"\"\n    return await _call(ctx, \"POST\", f\"/projects/{project}/runtime/rebuild\")\n","structuredPatch":[{"oldStart":1211,"oldLines":6,"newStart":1211,"newLines":86,"lines":[" "," "," @tool(MANAGERS)","+async def create_task_draft(ctx: Context, draft: TaskDraftBody) -> dict:","+    \"\"\"Save a task definition as a draft: nothing can claim, list or count it until","+    publish_task_drafts. `draft` takes create_task's fields (same rules) plus","+    depends_on_drafts (ids of other drafts; depends_on stays for existing tasks).","+    Title, spec, acceptance and project may be filled in later; publish requires","+    them. Returns the draft with its `version`.\"\"\"","+    return await _call(","+        ctx,","+        \"POST\",","+        \"/task-drafts\",","+        json=draft.model_dump(mode=\"json\", exclude_unset=True),","+    )","+","+","+@tool(MANAGERS)","+async def list_task_drafts(ctx: Context) -> dict:","+    \"\"\"Open drafts, oldest first ({items, total}; at most 200, always whole).\"\"\"","+    return await _call(ctx, \"GET\", \"/task-drafts\")","+","+","+@tool(MANAGERS)","+async def get_task_draft(ctx: Context, draft_id: str) -> dict:","+    \"\"\"One draft, open or published (then with published_task_id).\"\"\"","+    return await _call(ctx, \"GET\", f\"/task-drafts/{draft_id}\")","+","+","+@tool(MANAGERS)","+async def edit_task_draft(","+    ctx: Context, draft_id: str, expected_version: str, changes: dict[str, Any]","+) -> dict:","+    \"\"\"Patch an open draft's fields: a field you leave out is kept, null resets it.","+    Pass the draft's `version` as expected_version (409 stale_version carries the","+    current one); a published draft is 409 draft_published.\"\"\"","+    return await _call(","+        ctx,","+        \"PATCH\",","+        f\"/task-drafts/{draft_id}\",","+        json={\"expected_version\": expected_version, \"changes\": changes},","+    )","+","+","+@tool(MANAGERS)","+async def discard_task_draft(ctx: Context, draft_id: str, expected_version: str) -> str:","+    \"\"\"Delete an open draft (pass its `version`).\"\"\"","+    await _call(","+        ctx,","+        \"DELETE\",","+        f\"/task-drafts/{draft_id}\",","+        params={\"expected_version\": expected_version},","+    )","+    return \"discarded\"","+","+","+@tool(MANAGERS)","+async def publish_task_drafts(","+    ctx: Context,","+    idempotency_key: str,","+    drafts: list[PublishItem],","+    mode: Literal[\"atomic\", \"partial\"] = \"atomic\",","+) -> dict:","+    \"\"\"Publish up to 50 drafts ([{draft_id, expected_version}]) as tasks in one","+    transaction: depends_on_drafts become the new task ids, cycles are refused, and","+    each draft needs a project, spec, acceptance and capabilities some pool or agent","+    declares. mode \"atomic\" (default) publishes all or nothing (the error lists each","+    failing draft); \"partial\" publishes the valid ones and returns an outcome per","+    draft (published | rejected | skipped). Retrying with the same idempotency_key","+    and drafts returns the first answer (replayed: true) and creates nothing.\"\"\"","+    return await _call(","+        ctx,","+        \"POST\",","+        \"/task-drafts/publish\",","+        json={","+            \"idempotency_key\": idempotency_key,","+            \"mode\": mode,","+            \"drafts\": [d.model_dump() for d in drafts],","+        },","+    )","+","+","+@tool(MANAGERS)"," async def steer_task(ctx: Context, task_id: str, message: str) -> dict:","     \"\"\"Send an instruction to the worker holding this claimed task. 409 not_claimed","     if it is not claimed, 409 steer_unsupported if that worker does not report the"]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"tool_result_meta":[{"id":"toolu_015YYKE8mw6uLRSCZCLxXpFf","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgb9sPBHwdq9dVoRa5CXC","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_019D8tRT3JFZ4Qa5aeYBXLWT","name":"Bash","input":{"command":"python3 - <<'EOF'\nimport pathlib\np=pathlib.Path(\"apps/api/src/argus_api/mcp_server.py\"); t=p.read_text()\nt=t.replace(\"from argus_core.task_edit import TaskChanges\\n\",\"from argus_core.task_drafts import PublishItem, TaskDraftBody\\nfrom argus_core.task_edit import TaskChanges\\n\",1)\nt=t.replace(\"\"\"acceptance, priority, capabilities, pins or dependencies (pass its `version`). Lists\"\"\",\"\"\"acceptance, priority, capabilities, pins or dependencies (pass its `version`). To\nassemble related tasks before any worker can claim them, create_task_draft each one\n(depends_on_drafts links drafts) and publish_task_drafts them together. Lists\"\"\",1)\np.write_text(t)\nEOF\ngrep -n \"edit_task\\|set_task_dependencies\" apps/api/src/argus_api/skills/argus-orchestrator/SKILL.md"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2163,"cache_read_input_tokens":127188,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2163},"output_tokens":43,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"e60805ed-c36d-4e22-8274-acc0a44d64d1","uuid":"44b0fdcd-2678-4b9f-834b-eed3465324d0","timestamp":"2026-10-31T23:06:39.259Z","request_id":"req_011Cgb9sNapTdpZdxSZKdfxG","wire_tool_inputs":{"toolu_019D8tRT3JFZ4Qa5aeYBXLWT":{"command":"cd /workspace/agent/task-workspaces/030540ef-d69a-4c2c-839d-f4970e8c94d7 && python3 - <<'EOF'\nimport pathlib\np=pathlib.Path(\"apps/api/src/argus_api/mcp_server.py\"); t=p.read_text()\nt=t.replace(\"from argus_core.task_edit import TaskChanges\\n\",\"from argus_core.task_drafts import PublishItem, TaskDraftBody\\nfrom argus_core.task_edit import TaskChanges\\n\",1)\nt=t.replace(\"\"\"acceptance, priority, capabilities, pins or dependencies (pass its `version`). Lists\"\"\",\"\"\"acceptance, priority, capabilities, pins or dependencies (pass its `version`). To\nassemble related tasks before any worker can claim them, create_task_draft each one\n(depends_on_drafts links drafts) and publish_task_drafts them together. Lists\"\"\",1)\np.write_text(t)\nEOF\ngrep -n \"edit_task\\|set_task_dependencies\" apps/api/src/argus_api/skills/argus-orchestrator/SKILL.md"}},"wire_ingest_context":{"toolu_019D8tRT3JFZ4Qa5aeYBXLWT":{"cwd":"/workspace/agent/task-workspaces/030540ef-d69a-4c2c-839d-f4970e8c94d7"}}}
