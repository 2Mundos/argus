e openapi`).\nMakefile:102:\t$(UV) run python scripts/export_openapi.py --check\nMakefile:103:openapi-client-check: ## Fail if schema.d.ts does not match the committed openapi.json.\nMakefile:105:\t$(PNPM) --filter @argus/api-client exec openapi-typescript openapi.json -o \"$$tmp\" --silent --default-non-nullable false; \\\nMakefile:106:\tcmp -s \"$$tmp\" packages/api-client/src/schema.d.ts || { echo \"schema.d.ts is stale: run \\`make openapi\\`\"; exit 1; }\nMakefile:122:check: lint typecheck test openapi-check ## Everything CI runs, locally.\nscripts/export_openapi.py:2:\"\"\"Write the API's OpenAPI schema to packages/api-client/openapi.json.","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01C7QWRcbYsWmXsjmX4oC5zw","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
