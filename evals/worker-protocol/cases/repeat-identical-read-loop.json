{
  "id": "repeat-identical-read-loop",
  "source": "draft:docs/drafts/2026-11-04.repeat-call-reminder.draft.md (no incident cited)",
  "prompt": "You are a worker. Claim a task, read its input artifact (artifact art-0101) to do the work, and finish or fail as the protocol requires.",
  "world": [
    {
      "tool": "claim_task",
      "times": 1,
      "result": {
        "task": {
          "id": "task-0101",
          "attempt": 2,
          "title": "Add retry to uploader",
          "spec": "Add bounded retry to the uploader in example-org/example-repo.",
          "acceptance": ["retries 3 times"],
          "knowledge_refs": []
        }
      }
    },
    {
      "tool": "heartbeat",
      "result": {
        "state": "active",
        "leases": [{ "task_id": "task-0101", "attempt": 2, "ok": true }],
        "steers": []
      }
    },
    {
      "tool": "read_artifact",
      "error": "503 artifact store unavailable, retry later"
    },
    {
      "tool": "report_progress",
      "result": { "ok": true }
    },
    {
      "tool": "fail_task",
      "result": { "id": "task-0101", "state": "failed" }
    },
    {
      "tool": "complete_task",
      "result": { "id": "task-0101", "state": "in_review" }
    }
  ],
  "checks": {
    "expect": [{ "tool": "fail_task", "args": { "task_id": "task-0101" } }],
    "forbid": [{ "tool": "complete_task" }],
    "max_calls": 8
  }
}
