#!/bin/sh
# argus: run a single-node Argus with Docker (docs/specs/launcher.spec.md).
# POSIX sh; needs only docker and curl on the host. Anything more runs in the image.
set -eu

ARGUS_HOME=${ARGUS_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/argus}
CONF=$ARGUS_HOME/argus.env
KEY=$ARGUS_HOME/age-key.txt
LOCK=$ARGUS_HOME/lock
REPO=${ARGUS_REPO:-2Mundos/argus}
READY_TIMEOUT=${ARGUS_READY_TIMEOUT:-300}
POLL=${ARGUS_POLL_INTERVAL:-1}
SECRETS=/data/secrets.sops.yaml
TTY=${ARGUS_TTY:-/dev/tty} # where questions are read from (tests point it at a file)

# Local workers (docs/specs/local-workers.spec.md): the OneCLI gateway NanoClaw
# needs, pinned by digest (1.43+ drops the secret-assignment API the channel uses).
ONECLI_IMAGE=ghcr.io/onecli/onecli:1.42.0@sha256:8d4a3300e915259a2fcff13614ecd7394bfd35c75d6a64d69f28a28dd23f30fe
ONECLI_DB_IMAGE=postgres:18-alpine@sha256:10a5c69a83035ab5239f5620d708520e8b28f5aa1f2b20143e6024532edadfb5
GW=argus-onecli
GW_DB=argus-onecli-db
GW_NET=argus-onecli-control

# Backup and restore run in an Argus container as its user, so files keep the
# volume's ownership. Backups are named argus-<UTC timestamp>-<version>.db and
# sort oldest first; the newest 5 are kept, plus an optional protected name.
PY_BACKUP='
import glob, os, sqlite3, sys
dst = "/data/backups/" + sys.argv[1]
protect = sys.argv[2] if len(sys.argv) > 2 else ""
os.makedirs("/data/backups", exist_ok=True)
src = sqlite3.connect("/data/argus.db")
out = sqlite3.connect(dst + ".tmp")
src.backup(out)
out.close()
src.close()
os.replace(dst + ".tmp", dst)
for f in sorted(glob.glob("/data/backups/argus-*.db"))[:-5]:
    if os.path.basename(f) != protect:
        os.remove(f)
'
PY_RESTORE='
import os, shutil, sys
src = "/data/backups/" + sys.argv[1]
shutil.copyfile(src, "/data/argus.db.restore")
for suffix in ("-wal", "-shm"):
    try:
        os.remove("/data/argus.db" + suffix)
    except FileNotFoundError:
        pass
os.replace("/data/argus.db.restore", "/data/argus.db")
'
# What the volume holds, for `uninstall`: database bytes, secrets yes/no, backup names.
PY_SUMMARY='
import os
db, d = "/data/argus.db", "/data/backups"
print(os.path.getsize(db) if os.path.exists(db) else 0)
print("yes" if os.path.exists("/data/secrets.sops.yaml") else "no")
for f in sorted(os.listdir(d)) if os.path.isdir(d) else []:
    print(f)
'

say() { printf '%s\n' "$*"; }
have_tty() { (: <"$TTY") 2>/dev/null; }
self_path() { case $0 in */*) printf '%s' "$0" ;; *) command -v "$0" ;; esac; }

# run_step WHAT CMD...: run CMD with `set -e` in a subshell and set STEP_OK,
# so a failed step is reported and the caller carries on. (`set -e` is ignored
# inside `if` and `||`, so the subshell runs as a plain command.)
run_step() {
	what=$1
	shift
	set +e
	(
		set -e
		"$@"
	)
	rc=$?
	set -e
	STEP_OK=1
	if [ "$rc" != 0 ]; then
		STEP_OK=0
		printf 'argus: could not %s\n' "$what" >&2
	fi
}
die() {
	REPORTED=1
	printf 'argus: %s\n' "$*" >&2
	exit 1
}

# Every exit says why: `set -e` alone would stop without a word.
REPORTED=0
LOCK_OWNED=0
on_exit() {
	rc=$?
	[ "$LOCK_OWNED" = 0 ] || rm -rf "$LOCK"
	if [ "$rc" -ne 0 ] && [ "$REPORTED" = 0 ]; then
		printf 'argus: stopped after an unexpected error (exit %s); rerun with ARGUS_DEBUG=1 to trace it\n' "$rc" >&2
	fi
}
trap on_exit EXIT
trap 'exit 130' INT TERM
[ -z "${ARGUS_DEBUG:-}" ] || set -x

usage() {
	cat <<'EOF'
Usage: argus <command>

  up [--docker|--no-docker] [--port N] [--age-key FILE] [--version vX.Y.Z]
     [--workers|--no-workers]
                     start or apply config changes (--version, --workers: first run only;
                     the first run asks whether to set up workers)
  update [vX.Y.Z] [-y]
                     back up, upgrade to the newest (or given) release, roll back on failure
  backup             online backup of the database into the volume
  restore <name>     restore a backup and run the version it was taken under
  status             version, container state, readiness, backups
  token              print the generated admin token, if there is one
  logs [-f]          container logs
  down               stop and remove the container (never the volume)
  unlock             remove a stale lock left by a command that died
  worker setup [-y]  run workers on this machine: worker images, gateway, Docker access
  worker status      what `worker setup` set up
  worker remove [--purge]
                     undo `worker setup` (--purge also deletes gateway data and checkouts)
  uninstall [--keep-data] [-y]
                     remove everything the launcher created (--keep-data keeps
                     the volumes and config for a later `argus up`)

Config: $ARGUS_HOME (default ~/.config/argus). Spec: docs/specs/launcher.spec.md
EOF
}

# -- config --------------------------------------------------------------------

load_config() {
	ARGUS_IMAGE=ghcr.io/2mundos/argus
	ARGUS_VERSION=
	ARGUS_PORT=8000
	ARGUS_CONTAINER=argus
	ARGUS_VOLUME=argus-data
	ARGUS_DOCKER=0
	ARGUS_EXTRA_ENV=$ARGUS_HOME/extra.env
	ARGUS_WORKERS=0
	ARGUS_DATA_HOME=${XDG_DATA_HOME:-$HOME/.local/share}/argus
	HAVE_CONFIG=0
	if [ -f "$CONF" ]; then
		# shellcheck disable=SC1090
		. "$CONF"
		HAVE_CONFIG=1
	fi
}

save_config() {
	ensure_home
	tmp=$CONF.tmp.$$
	cat >"$tmp" <<EOF
# Written by argus (docs/specs/launcher.spec.md). Change the version with
# \`argus update\`; edit the rest by hand or with \`argus up\` flags.
ARGUS_IMAGE='$ARGUS_IMAGE'
ARGUS_VERSION='$ARGUS_VERSION'
ARGUS_PORT='$ARGUS_PORT'
ARGUS_CONTAINER='$ARGUS_CONTAINER'
ARGUS_VOLUME='$ARGUS_VOLUME'
ARGUS_DOCKER='$ARGUS_DOCKER'
ARGUS_EXTRA_ENV='$ARGUS_EXTRA_ENV'
ARGUS_WORKERS='$ARGUS_WORKERS'
ARGUS_DATA_HOME='$ARGUS_DATA_HOME'
EOF
	mv "$tmp" "$CONF"
	HAVE_CONFIG=1
}

ensure_home() {
	mkdir -p "$ARGUS_HOME"
	chmod 700 "$ARGUS_HOME"
}

image() { printf '%s:%s' "$ARGUS_IMAGE" "${1:-$ARGUS_VERSION}"; }

# -- lock (3.7) ----------------------------------------------------------------

take_lock() {
	ensure_home
	if [ "${ARGUS_LOCK_HELD:-}" = "$$" ] && [ "$(cat "$LOCK/pid" 2>/dev/null)" = "$$" ]; then
		: # inherited across `exec` by `update`
	elif ! mkdir "$LOCK" 2>/dev/null; then
		pid=$(cat "$LOCK/pid" 2>/dev/null || true)
		if [ -z "$pid" ] || kill -0 "$pid" 2>/dev/null; then
			die "another argus command is running (pid ${pid:-starting}); wait for it to finish"
		fi
		die "stale lock: pid $pid is not running. Check nothing is half-done, then run \`argus unlock\`"
	else
		echo "$$" >"$LOCK/pid"
	fi
	unset ARGUS_LOCK_HELD
	LOCK_OWNED=1
}

# -- docker helpers ------------------------------------------------------------

container_exists() { docker container inspect "$ARGUS_CONTAINER" >/dev/null 2>&1; }
volume_exists() { docker volume inspect "$ARGUS_VOLUME" >/dev/null 2>&1; }
running() {
	[ "$(docker container inspect -f '{{.State.Running}}' "$ARGUS_CONTAINER" 2>/dev/null)" = true ]
}

ensure_image() {
	docker image inspect "$1" >/dev/null 2>&1 || docker pull "$1" >/dev/null
}

# with_volume IMAGE ENTRYPOINT ARGS...: a one-off container with the volume at /data.
with_volume() {
	img=$1
	ep=$2
	shift 2
	docker run --rm -v "$ARGUS_VOLUME:/data" --entrypoint "$ep" "$img" "$@"
}

valid_version() {
	case $1 in
	v[0-9]*.[0-9]*.[0-9]*) case $1 in *[!v0-9.]*) return 1 ;; esac ;;
	*) return 1 ;;
	esac
}

# version_lt a b: a < b, numerically per component.
version_lt() {
	awk -v a="${1#v}" -v b="${2#v}" 'BEGIN {
		split(a, x, "."); split(b, y, ".")
		for (i = 1; i <= 3; i++) {
			if (x[i] + 0 < y[i] + 0) exit 0
			if (x[i] + 0 > y[i] + 0) exit 1
		}
		exit 1
	}'
}

latest_version() {
	v=$(curl -fsSI "https://github.com/$REPO/releases/latest" |
		tr -d '\r' | sed -n 's|^[Ll]ocation: .*/tag/\(v[0-9.]*\)$|\1|p')
	valid_version "$v" || die "could not find the newest release of $REPO"
	printf '%s' "$v"
}

stamp() { date -u +%Y%m%dT%H%M%SZ; }

backup_online() {
	name=argus-$(stamp)-$ARGUS_VERSION.db
	docker exec "$ARGUS_CONTAINER" python -c "$PY_BACKUP" "$name"
	printf '%s' "$name"
}

# backup_offline IMAGE VERSION [PROTECT]: the container must be stopped.
backup_offline() {
	name=argus-$(stamp)-$2.db
	with_volume "$1" python -c "$PY_BACKUP" "$name" ${3:+"$3"}
	printf '%s' "$name"
}

restore_offline() { with_volume "$1" python -c "$PY_RESTORE" "$2"; }

stop_and_remove() {
	if container_exists; then
		docker stop "$ARGUS_CONTAINER" >/dev/null
		docker rm "$ARGUS_CONTAINER" >/dev/null
	fi
}

recipient() {
	r=$(sed -n 's/^# public key: \(age1[0-9a-z]*\)$/\1/p' "$KEY")
	[ -n "$r" ] || r=$(docker run --rm -v "$KEY:/keys/age.txt:ro" --entrypoint age-keygen "$(image)" -y /keys/age.txt)
	printf '%s' "$r"
}

desktop_engine() { docker info --format '{{.OperatingSystem}}' 2>/dev/null | grep -qi 'docker desktop'; }
bridge_ip() { docker network inspect bridge --format '{{(index .IPAM.Config 0).Gateway}}'; }

# -- local workers (docs/specs/local-workers.spec.md) ---------------------------

worker_image() { printf '%s/argus-nanoclaw-%s:%s' "${ARGUS_IMAGE%/*}" "$1" "${2:-$ARGUS_VERSION}"; }
nc_root() { printf '%s/nanoclaw' "$ARGUS_DATA_HOME"; }
nc_src() { printf '%s/%s/src' "$(nc_root)" "$1"; }

# Prints why workers cannot run under ARGUS_DATA_HOME, if they cannot (3.2).
data_home_problem() {
	root=$(nc_root)
	[ "${#root}" -gt 54 ] || return 1
	printf 'the instances root %s/i is longer than 56 characters; set ARGUS_DATA_HOME in %s to a shorter path' "$root" "$CONF"
}

# Pull a version's worker images and put its checkout on the host (3.1, 3.2).
prepare_workers() {
	v=$1
	root=$(nc_root)
	! why=$(data_home_problem) || die "$why"
	for kind in host agent; do
		ref=$(worker_image "$kind" "$v")
		ensure_image "$ref" 2>/dev/null ||
			die "no worker image $ref (releases before local workers have none); \`argus update\` to a newer release, or \`argus worker remove\` to run $v without workers"
	done
	mkdir -p "$root/i"
	if [ ! -d "$(nc_src "$v")" ]; then
		say "Copying the NanoClaw checkout for $v to $root/$v..."
		part=$root/.$v.part.$$
		rm -rf "$part"
		mkdir -p "$part"
		cid=$(docker create "$(worker_image host "$v")")
		if ! docker cp "$cid:/opt/nanoclaw" "$part/src" >/dev/null; then
			docker rm "$cid" >/dev/null
			rm -rf "$part"
			die "could not copy the NanoClaw checkout out of $(worker_image host "$v")"
		fi
		docker rm "$cid" >/dev/null
		mv "$part" "$root/$v"
	fi
}

# Keep only this version's checkout, once it is the one in use.
prune_checkouts() {
	root=$(nc_root)
	[ -d "$root" ] || return 0
	for d in "$root"/v* "$root"/.v*; do
		[ -e "$d" ] || continue
		[ "$d" = "$root/$1" ] || rm -rf "$d"
	done
}

random_hex() { od -An -tx1 -N24 /dev/urandom | tr -d ' \n'; }

# The OneCLI gateway and its database (3.3). Idempotent.
gateway_up() {
	genv=$ARGUS_HOME/onecli.env
	if [ ! -s "$genv" ]; then
		pw=$(random_hex)
		part=$genv.part.$$
		(
			umask 077
			printf '%s\n' "POSTGRES_USER=onecli" "POSTGRES_DB=onecli" "POSTGRES_PASSWORD=$pw" \
				"DATABASE_URL=postgresql://onecli:$pw@$GW_DB:5432/onecli" \
				"NEXTAUTH_SECRET=$(random_hex)" >"$part"
		)
		mv "$part" "$genv"
	fi
	docker network inspect "$GW_NET" >/dev/null 2>&1 || docker network create "$GW_NET" >/dev/null
	if ! docker container inspect "$GW_DB" >/dev/null 2>&1; then
		docker run -d --name "$GW_DB" --restart unless-stopped --network "$GW_NET" \
			-v argus-onecli-pg:/var/lib/postgresql --env-file "$genv" "$ONECLI_DB_IMAGE" >/dev/null
	fi
	start=$(date +%s)
	until docker exec "$GW_DB" pg_isready -U onecli >/dev/null 2>&1; do
		[ $(($(date +%s) - start)) -lt "$READY_TIMEOUT" ] ||
			die "the gateway database did not start; see \`docker logs $GW_DB\`"
		sleep "$POLL"
	done
	if ! docker container inspect "$GW" >/dev/null 2>&1; then
		# The management API (10254) stays on loopback and the private network;
		# agents reach the proxy (10255) as host.docker.internal (runbook 3).
		# The alias is the private Docker name Argus accepts for the admin API
		# (http://onecli:10254 on a user-defined network).
		set -- run -d --name "$GW" --restart unless-stopped --network "$GW_NET" \
			--network-alias onecli --add-host host.docker.internal:host-gateway \
			-p 127.0.0.1:10254:10254 -p 127.0.0.1:10255:10255 \
			-v argus-onecli-data:/app/data --env-file "$genv" \
			-e APP_URL=http://127.0.0.1:10254 -e GATEWAY_API_URL=http://127.0.0.1:10255 \
			-e INTERNAL_API_URL=http://localhost:10254
		desktop_engine || set -- "$@" -p "$(bridge_ip):10255:10255"
		docker "$@" "$ONECLI_IMAGE" >/dev/null
	fi
}

# Everything `worker setup` needs for a version: images, checkout, gateway.
worker_steps() {
	prepare_workers "$1"
	say "Starting the gateway..."
	gateway_up
}

explain_workers() {
	cat <<EOF
Workers run coding agents in Docker on this machine:
  - Argus gets the Docker socket: ROOT-EQUIVALENT on this Docker host.
  - Pulls the worker images for $ARGUS_VERSION (about 7 GB) and starts the
    OneCLI gateway ($GW, $GW_DB) on loopback and a private network.
EOF
}

gateway_down() {
	for c in "$GW" "$GW_DB"; do
		if docker container inspect "$c" >/dev/null 2>&1; then
			docker stop "$c" >/dev/null
			docker rm "$c" >/dev/null
		fi
	done
	! docker network inspect "$GW_NET" >/dev/null 2>&1 || docker network rm "$GW_NET" >/dev/null
}

# (Re)start Argus from the config and wait for it.
restart_argus() {
	stop_and_remove
	start_container
	if ! wait_ready; then
		print_failure
		exit 1
	fi
	print_access
}

# Start the container from the config (3.3).
start_container() {
	img=$(image)
	set -- run -d --name "$ARGUS_CONTAINER" --restart unless-stopped \
		--label io.argus.launcher=1 -e ARGUS_LAUNCHER=1 \
		-p "127.0.0.1:$ARGUS_PORT:8000" -v "$ARGUS_VOLUME:/data" \
		-v "$KEY:/keys/age.txt:ro" -e SOPS_AGE_KEY_FILE=/keys/age.txt \
		-e "SOPS_AGE_RECIPIENTS=$(recipient)"
	if [ -s "$ARGUS_EXTRA_ENV" ]; then
		set -- "$@" --env-file "$ARGUS_EXTRA_ENV"
	fi
	if [ "$ARGUS_DOCKER" = 1 ]; then
		gid=$(docker run --rm -v /var/run/docker.sock:/var/run/docker.sock \
			--entrypoint stat "$img" -c %g /var/run/docker.sock)
		set -- "$@" -v /var/run/docker.sock:/var/run/docker.sock --group-add "$gid" \
			--add-host host.docker.internal:host-gateway \
			-e "ARGUS_PUBLIC_URL=http://host.docker.internal:$ARGUS_PORT"
		if ! desktop_engine; then
			set -- "$@" -p "$(bridge_ip):$ARGUS_PORT:8000"
		fi
		if [ "$ARGUS_WORKERS" = 1 ]; then
			# The settings provision.sh prints, for this version's images and checkout.
			root=$(nc_root)
			set -- "$@" -v "$root:$root" \
				-e "ARGUS_NANOCLAW_INSTALL_DIR=$(nc_src "$ARGUS_VERSION")" \
				-e "ARGUS_NANOCLAW_INSTANCES_ROOT=$root/i" \
				-e "ARGUS_NANOCLAW_HOST_IMAGE=$(worker_image host)" \
				-e "ARGUS_NANOCLAW_AGENT_IMAGE=$(worker_image agent)" \
				-e "ARGUS_NANOCLAW_ONECLI_URL=http://onecli:10254" \
				-e "ARGUS_NANOCLAW_NETWORK=$GW_NET" \
				-e ARGUS_NANOCLAW_ALLOW_DOCKER_SOCKET=true \
				-e ARGUS_NANOCLAW_DOCKER_SOCKET=/var/run/docker.sock \
				-e "ARGUS_NANOCLAW_USER=$(id -u):$(id -g)" \
				-e "ARGUS_NANOCLAW_GROUP_ADD=$gid"
		fi
	fi
	say "Starting Argus $ARGUS_VERSION..."
	docker "$@" "$img" >/dev/null
	say "Waiting for it to be ready (first start can take a minute)..."
}

# Wait for /readyz (3.3); never for the admin-token file.
wait_ready() {
	start=$(date +%s)
	while :; do
		if curl -fsS -o /dev/null "http://127.0.0.1:$ARGUS_PORT/readyz" 2>/dev/null; then
			return 0
		fi
		running || return 1
		[ $(($(date +%s) - start)) -lt "$READY_TIMEOUT" ] || return 1
		sleep "$POLL"
	done
}

print_failure() {
	REPORTED=1
	say "Argus $ARGUS_VERSION did not become ready. Last log lines:" >&2
	docker logs --tail 50 "$ARGUS_CONTAINER" >&2 2>&1 || true
}

print_access() {
	say "Argus $ARGUS_VERSION is ready: http://127.0.0.1:$ARGUS_PORT"
	if t=$(docker exec "$ARGUS_CONTAINER" cat /data/admin-token 2>/dev/null) && [ -n "$t" ]; then
		say "Admin token: $t"
	else
		say "Sign in with your existing or preset (ARGUS_ADMIN_TOKEN) admin token."
	fi
}

# -- age key -------------------------------------------------------------------

install_key() {
	part=$KEY.part.$$
	cat "$1" >"$part"
	chmod 644 "$part" # readable by the container's user; $ARGUS_HOME is 0700
	mv "$part" "$KEY"
}

# Images before the launcher have no age-keygen; use the newest release's then.
gen_key() {
	docker run --rm --entrypoint age-keygen "$(image)" 2>/dev/null && return 0
	newest=$(image "$(latest_version)")
	ensure_image "$newest"
	docker run --rm --entrypoint age-keygen "$newest" 2>/dev/null
}

ensure_key() {
	if [ -n "${1:-}" ]; then
		[ -s "$1" ] || die "--age-key: $1 is empty or missing"
		install_key "$1"
	elif [ ! -s "$KEY" ]; then
		if volume_exists && with_volume "$(image)" test -e "$SECRETS"; then
			die "the volume already has encrypted provider credentials; pass the age key that encrypts them with --age-key FILE"
		fi
		tmp=$KEY.new.$$
		if ! gen_key >"$tmp" || [ ! -s "$tmp" ]; then
			rm -f "$tmp"
			die "could not create an age key; create one with age-keygen and pass it with --age-key FILE"
		fi
		install_key "$tmp"
		rm -f "$tmp"
		say "Created an age key at $KEY; keep a copy, it decrypts provider credentials."
	fi
}

# -- adoption (3.8) ------------------------------------------------------------

# Refuse to adopt a container with settings the config would drop.
check_adoptable() {
	docker_ok=$1
	key_given=$2
	img_id=$(docker container inspect -f '{{.Image}}' "$ARGUS_CONTAINER")
	base=$(docker image inspect -f '{{range .Config.Env}}{{println .}}{{end}}' "$img_id" | sed -n 's/=.*//p')
	allowed=" $(printf '%s' "$base" | tr '\n' ' ') "
	if [ -s "$ARGUS_EXTRA_ENV" ]; then
		allowed="$allowed $(sed -n 's/^\([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p' "$ARGUS_EXTRA_ENV" | tr '\n' ' ') "
	fi
	[ "$docker_ok" = 1 ] && allowed="$allowed ARGUS_PUBLIC_URL "
	[ "$key_given" = 1 ] && allowed="$allowed SOPS_AGE_KEY_FILE SOPS_AGE_RECIPIENTS SOPS_AGE_KEY "
	extra=
	for name in $(docker container inspect -f '{{range .Config.Env}}{{println .}}{{end}}' "$ARGUS_CONTAINER" | sed -n 's/=.*//p'); do
		case $allowed in *" $name "*) ;; *) extra="$extra env:$name" ;; esac
	done
	keyfile=$(docker container inspect -f '{{range .Config.Env}}{{println .}}{{end}}' "$ARGUS_CONTAINER" |
		sed -n 's/^SOPS_AGE_KEY_FILE=//p')
	volume=
	for m in $(docker container inspect -f '{{range .Mounts}}{{.Type}}:{{.Name}}:{{.Destination}}{{println}}{{end}}' "$ARGUS_CONTAINER"); do
		dest=${m##*:}
		case $m in
		volume:*:/data)
			volume=${m#volume:}
			volume=${volume%:/data}
			;;
		*:/var/run/docker.sock) [ "$docker_ok" = 1 ] || extra="$extra mount:$dest" ;;
		*)
			if [ "$key_given" = 1 ] && [ -n "$keyfile" ] &&
				{ [ "$dest" = "$keyfile" ] || case $keyfile in "$dest"/*) true ;; *) false ;; esac; }; then
				:
			else
				extra="$extra mount:$dest"
			fi
			;;
		esac
	done
	[ -n "$volume" ] || extra="$extra no-named-volume-at:/data"
	if [ -n "$extra" ]; then
		die "not adopting container $ARGUS_CONTAINER: it has settings the launcher would drop:$extra
Move them into the config (--age-key FILE, --docker, or $ARGUS_EXTRA_ENV) and run \`argus up\` again."
	fi
	ARGUS_VOLUME=$volume
	v=$(docker container inspect -f '{{index .Config.Labels "org.opencontainers.image.version"}}' "$ARGUS_CONTAINER")
	valid_version "$v" ||
		die "not adopting container $ARGUS_CONTAINER: its image has no release version (got '${v:-none}'); run \`argus up --version vX.Y.Z\` with the release it runs"
	ARGUS_VERSION=$v
}

# -- commands ------------------------------------------------------------------

cmd_up() {
	want_docker=
	want_port=
	key_src=
	want_version=
	want_workers=
	while [ $# -gt 0 ]; do
		case $1 in
		--workers) want_workers=1 ;;
		--no-workers) want_workers=0 ;;
		--docker) want_docker=1 ;;
		--no-docker) want_docker=0 ;;
		--port) want_port=${2:?--port needs a value} && shift ;;
		--age-key) key_src=${2:?--age-key needs a file} && shift ;;
		--version) want_version=${2:?--version needs vX.Y.Z} && shift ;;
		*) die "up: unknown option $1" ;;
		esac
		shift
	done
	[ -z "$want_version" ] || valid_version "$want_version" || die "--version must look like vX.Y.Z"
	[ "$want_workers" != 1 ] || [ "$want_docker" != 0 ] || die "--workers needs Docker access; drop --no-docker"
	take_lock
	load_config
	first_run=$((1 - HAVE_CONFIG))
	if [ "$first_run" = 0 ]; then
		case $want_workers in
		1) die "workers are set up on the first run only; run \`argus worker setup\`" ;;
		0) die "workers are set up on the first run only; run \`argus worker remove\`" ;;
		esac
	fi
	[ -z "$want_port" ] || ARGUS_PORT=$want_port
	[ -z "$want_docker" ] || ARGUS_DOCKER=$want_docker
	[ "$ARGUS_WORKERS" != 1 ] || [ "$ARGUS_DOCKER" = 1 ] ||
		die "workers need Docker access; run \`argus worker remove\` first"
	adopt=0
	if [ "$HAVE_CONFIG" = 1 ]; then
		[ -z "$want_version" ] || die "this install runs $ARGUS_VERSION; change versions with \`argus update\`"
	elif container_exists; then
		[ -z "$want_version" ] || die "container $ARGUS_CONTAINER exists; it is adopted at its own version, change it later with \`argus update\`"
		check_adoptable "$ARGUS_DOCKER" "$([ -n "$key_src" ] && echo 1 || echo 0)"
		say "Adopting container $ARGUS_CONTAINER (Argus $ARGUS_VERSION, volume $ARGUS_VOLUME)."
		adopt=1
	elif volume_exists; then
		[ -n "$want_version" ] ||
			die "volume $ARGUS_VOLUME exists without a container; pass --version with the release that last ran on it"
		ARGUS_VERSION=$want_version
		adopt=1
	else
		ARGUS_VERSION=${want_version:-$(latest_version)}
	fi
	# The first run decides whether this machine runs workers, before it pulls
	# or starts anything (local workers 3.7).
	if [ "$first_run" = 1 ]; then
		if [ "$want_docker" = 0 ]; then
			want_workers=0
		elif why=$(data_home_problem); then
			[ "$want_workers" != 1 ] || die "$why"
			say "Workers cannot run here: $why."
			want_workers=0
		elif [ -z "$want_workers" ] && have_tty; then
			explain_workers
			printf 'Set up workers? [Y/n] '
			read -r ans <"$TTY" || ans=n
			case $ans in "" | y | Y | yes) want_workers=1 ;; *) want_workers=0 ;; esac
		fi
		want_workers=${want_workers:-0}
	fi
	ensure_image "$(image)"
	ensure_key "$key_src"
	if [ "$adopt" = 1 ]; then
		# Adopting starts a new container on existing data: keep a way back.
		if container_exists; then
			img_id=$(docker container inspect -f '{{.Image}}' "$ARGUS_CONTAINER")
			docker stop "$ARGUS_CONTAINER" >/dev/null
		else
			img_id=$(image)
		fi
		name=$(backup_offline "$img_id" "$ARGUS_VERSION")
		say "Backed up the database before adopting it: $name"
	fi
	workers_failed=0
	if [ "$want_workers" = 1 ]; then
		run_step "set up workers" worker_steps "$ARGUS_VERSION"
		if [ "$STEP_OK" = 1 ]; then
			ARGUS_DOCKER=1
			ARGUS_WORKERS=1
		else
			workers_failed=1
		fi
	elif [ "$ARGUS_WORKERS" = 1 ]; then
		worker_steps "$ARGUS_VERSION"
	fi
	save_config
	restart_argus
	if newest=$(latest_version 2>/dev/null) && version_lt "$ARGUS_VERSION" "$newest"; then
		say "Argus $newest is available: run \`argus update\`."
	fi
	if [ "$workers_failed" = 1 ]; then
		REPORTED=1
		say "Argus runs without workers because their setup failed (above); fix that and run \`argus worker setup\`." >&2
		exit 1
	elif [ "$want_workers" = 1 ]; then
		say "Workers are set up. In the dashboard: Agents > New worker > \"NanoClaw, host Docker socket\"."
	elif [ "$want_workers" = 0 ]; then
		say "Workers are not set up, so tasks cannot run yet: run \`argus worker setup\` when you want them."
	fi
}

cmd_update() {
	assume_yes=0
	target=
	for a in "$@"; do
		case $a in
		-y | --yes) assume_yes=1 ;;
		v*) target=$a ;;
		*) die "update: unknown argument $a" ;;
		esac
	done
	take_lock
	load_config
	[ "$HAVE_CONFIG" = 1 ] || die "no install found at $ARGUS_HOME; run \`argus up\` first"
	current=$ARGUS_VERSION
	[ -n "$target" ] || target=$(latest_version)
	valid_version "$target" || die "update: $target is not vX.Y.Z"
	if [ "$target" = "$current" ]; then
		say "Already on $current."
		return 0
	fi
	if version_lt "$target" "$current"; then
		die "refusing to downgrade $current to $target: migrations are one-way. Use \`argus restore\` with a backup taken under $target."
	fi
	docker pull "$(image "$target")" >/dev/null
	say "Upgrading Argus $current -> $target. Release notes:"
	docker run --rm --entrypoint sh "$(image "$target")" -c \
		'for f in /app/releases/*.ref.md; do echo "@@@ $f"; cat "$f"; done' |
		awk -v cur="${current#v}" -v tgt="${target#v}" '
			function key(v,  p) { split(v, p, "."); return p[1] * 1000000 + p[2] * 1000 + p[3] }
			/^@@@ / {
				v = $2; sub(/.*\.v/, "", v); sub(/\.ref\.md$/, "", v); gsub(/-/, ".", v)
				show = key(v) > key(cur) && key(v) <= key(tgt); inup = 0
				if (show) print "\n== v" v; next
			}
			show && /^## Upgrading/ { inup = 1; next }
			show && inup && /^(## |Specs added)/ { inup = 0 }
			show && inup { print }
		'
	if [ "$assume_yes" != 1 ]; then
		have_tty || die "no terminal to confirm on; rerun with -y after reading the notes"
		printf '\nBack up, stop Argus and upgrade to %s? [y/N] ' "$target"
		read -r ans <"$TTY"
		case $ans in y | Y | yes) ;; *) die "cancelled" ;; esac
	fi
	# Run the rest with the target's launcher (3.4 step 4), keeping the lock.
	self=$(self_path)
	tmp=$self.new.$$
	docker run --rm --entrypoint cat "$(image "$target")" /app/bin/argus >"$tmp"
	sh -n "$tmp" || {
		rm -f "$tmp"
		die "the launcher in $target does not parse; nothing was changed"
	}
	chmod 755 "$tmp"
	cp "$self" "$self.prev"
	mv "$tmp" "$self"
	trap - EXIT
	ARGUS_LOCK_HELD=$$ exec "$self" __apply-update "$target"
}

# Internal: steps 5-7 of 3.4, run by the target version's launcher.
cmd_apply_update() {
	target=$1
	take_lock
	load_config
	self=$(self_path)
	current=$ARGUS_VERSION
	# Worker images and checkout first: a missing one stops here, before any change.
	[ "$ARGUS_WORKERS" != 1 ] || prepare_workers "$target"
	if container_exists; then
		old_image=$(docker container inspect -f '{{.Image}}' "$ARGUS_CONTAINER")
	else
		old_image=$(image)
	fi
	stop_and_remove
	backup=$(backup_offline "$old_image" "$current")
	say "Backed up the database: $backup"
	ARGUS_VERSION=$target
	save_config
	start_container
	if wait_ready; then
		rm -f "$self.prev"
		[ "$ARGUS_WORKERS" != 1 ] || prune_checkouts "$target"
		print_access
		return 0
	fi
	print_failure
	say "Rolling back to $current." >&2
	stop_and_remove
	restore_offline "$old_image" "$backup"
	ARGUS_VERSION=$current
	save_config
	start_container
	[ ! -f "$self.prev" ] || mv "$self.prev" "$self"
	if wait_ready; then
		say "Rolled back: Argus $current is running on the database from before the upgrade." >&2
	else
		say "Rollback did not become ready either. The pre-upgrade backup is $backup." >&2
	fi
	exit 1
}

cmd_backup() {
	take_lock
	load_config
	running || die "Argus is not running; \`argus up\` first"
	name=$(backup_online)
	say "Backed up: $name (in $ARGUS_VOLUME:/data/backups)"
}

cmd_restore() {
	name=${1:?usage: argus restore <name>}
	case $name in argus-*-v*.db) ;; *) die "restore: expected a backup name like argus-20261103T120000Z-v0.8.0.db" ;; esac
	case $name in */*) die "restore: give the backup name, not a path" ;; esac
	version=${name##*-}
	version=${version%.db}
	valid_version "$version" || die "restore: no version in $name"
	take_lock
	load_config
	[ "$HAVE_CONFIG" = 1 ] || die "no install found at $ARGUS_HOME; run \`argus up\` first"
	if container_exists; then
		cur_image=$(docker container inspect -f '{{.Image}}' "$ARGUS_CONTAINER")
	else
		cur_image=$(image)
	fi
	with_volume "$cur_image" test -f "/data/backups/$name" || die "restore: no backup $name in $ARGUS_VOLUME"
	ensure_image "$(image "$version")"
	[ "$ARGUS_WORKERS" != 1 ] || prepare_workers "$version"
	stop_and_remove
	before=$(backup_offline "$cur_image" "$ARGUS_VERSION" "$name")
	say "Backed up the current database first: $before"
	restore_offline "$cur_image" "$name"
	ARGUS_VERSION=$version
	save_config
	start_container
	if ! wait_ready; then
		print_failure
		exit 1
	fi
	print_access
}

cmd_worker() {
	sub=${1:-}
	[ $# -eq 0 ] || shift
	case $sub in
	setup) worker_setup "$@" ;;
	status) worker_status ;;
	remove) worker_remove "$@" ;;
	*) die "usage: argus worker setup [-y] | status | remove [--purge]" ;;
	esac
}

worker_setup() {
	assume_yes=0
	for a in "$@"; do
		case $a in -y | --yes) assume_yes=1 ;; *) die "worker setup: unknown argument $a" ;; esac
	done
	take_lock
	load_config
	[ "$HAVE_CONFIG" = 1 ] || die "no install found at $ARGUS_HOME; run \`argus up\` first"
	if [ "$assume_yes" != 1 ]; then
		have_tty || die "no terminal to confirm on; rerun with -y"
		explain_workers
		printf 'Continue? [y/N] '
		read -r ans <"$TTY"
		case $ans in y | Y | yes) ;; *) die "cancelled" ;; esac
	fi
	worker_steps "$ARGUS_VERSION"
	ARGUS_DOCKER=1
	ARGUS_WORKERS=1
	save_config
	restart_argus
	say "Workers are set up. In the dashboard: Agents > New worker > \"NanoClaw, host Docker socket\"."
}

worker_status() {
	load_config
	if [ "$ARGUS_WORKERS" != 1 ]; then
		say "Workers are not set up; run \`argus worker setup\`."
		return 0
	fi
	say "Worker images: $(worker_image host) $(worker_image agent)"
	src=$(nc_src "$ARGUS_VERSION")
	[ -d "$src" ] && say "Checkout:      $src" || say "Checkout:      missing ($src); run \`argus up\`"
	for c in "$GW" "$GW_DB"; do
		state=$(docker container inspect -f '{{.State.Status}}' "$c" 2>/dev/null || echo missing)
		say "Gateway:       $c $state"
	done
}

worker_remove() {
	purge=0
	for a in "$@"; do
		case $a in --purge) purge=1 ;; *) die "worker remove: unknown argument $a" ;; esac
	done
	take_lock
	load_config
	[ "$HAVE_CONFIG" = 1 ] || die "no install found at $ARGUS_HOME"
	gateway_down
	ARGUS_WORKERS=0
	save_config
	restart_argus
	if [ "$purge" = 1 ]; then
		for vol in argus-onecli-data argus-onecli-pg; do
			! docker volume inspect "$vol" >/dev/null 2>&1 || docker volume rm "$vol" >/dev/null
		done
		rm -rf "$(nc_root)" "$ARGUS_HOME/onecli.env"
		say "Removed the workers, the gateway data and the NanoClaw checkouts."
	else
		say "Removed the workers. Gateway data and checkouts stay for a later setup (--purge deletes them)."
	fi
}

# -- uninstall (3.9) -----------------------------------------------------------

digest_ref() { printf '%s@%s' "${1%%:*}" "${1#*@}"; } # name:tag@digest -> name@digest

remove_containers() {
	gateway_down
	stop_and_remove
}

cmd_uninstall() {
	keep=0
	assume_yes=0
	for a in "$@"; do
		case $a in
		--keep-data) keep=1 ;;
		-y | --yes) assume_yes=1 ;;
		*) die "uninstall: unknown argument $a" ;;
		esac
	done
	take_lock
	load_config
	self=$(self_path)
	[ "$HAVE_CONFIG" = 1 ] || die "no install found at $ARGUS_HOME; only the launcher is left: rm $self"

	# Only what exists, and only names the launcher wrote or derives (3.6).
	containers=
	for c in "$GW" "$GW_DB" "$ARGUS_CONTAINER"; do
		if docker container inspect "$c" >/dev/null 2>&1; then containers="$containers $c"; fi
	done
	network=
	if docker network inspect "$GW_NET" >/dev/null 2>&1; then network=$GW_NET; fi
	summary=
	if volume_exists && docker image inspect "$(image)" >/dev/null 2>&1; then
		summary=$(with_volume "$(image)" python -c "$PY_SUMMARY" 2>/dev/null) || summary=
	fi
	versions=$ARGUS_VERSION
	for v in $(printf '%s\n' "$summary" | sed -n 's/^argus-.*-\(v[0-9.]*\)\.db$/\1/p' | sort -u); do
		case " $versions " in *" $v "*) ;; *) versions="$versions $v" ;; esac
	done
	refs="$(digest_ref "$ONECLI_IMAGE") $(digest_ref "$ONECLI_DB_IMAGE")"
	for v in $versions; do
		refs="$refs $(image "$v") $(worker_image host "$v") $(worker_image agent "$v")"
	done
	images=
	for ref in $refs; do
		if docker image inspect "$ref" >/dev/null 2>&1; then images="$images $ref"; fi
	done
	root=$(nc_root)
	volumes=
	if [ "$keep" = 0 ]; then
		for vol in "$ARGUS_VOLUME" argus-onecli-data argus-onecli-pg; do
			if docker volume inspect "$vol" >/dev/null 2>&1; then volumes="$volumes $vol"; fi
		done
	fi

	say "This removes:"
	[ -z "$containers" ] || say "  containers:$containers"
	[ -z "$network" ] || say "  network: $network"
	for i in $images; do say "  image: $i"; done
	[ ! -d "$root" ] || say "  worker checkouts: $root"
	for vol in $volumes; do
		if [ "$vol" = "$ARGUS_VOLUME" ] && [ -n "$summary" ]; then
			size=$(printf '%s\n' "$summary" | sed -n 1p | awk '{ printf "%.1f MB", $1 / 1048576 }')
			count=$(printf '%s\n' "$summary" | grep -c '^argus-' || true)
			secrets=$(printf '%s\n' "$summary" | sed -n 2p)
			say "  volume: $vol (database $size, $count backups, encrypted credentials: $secrets)"
		else
			say "  volume: $vol"
		fi
	done
	if [ "$keep" = 0 ]; then
		say "  config: $ARGUS_HOME (argus.env, the age key, gateway secrets)"
	fi
	say "  launcher: $self"
	if [ "$keep" = 0 ]; then
		say ""
		say "The backups inside $ARGUS_VOLUME and the age key go with it; \`argus backup\` cannot"
		say "save them. Copy a backup and $KEY out first, or rerun with --keep-data."
	else
		say "Kept (--keep-data): the volumes and $ARGUS_HOME."
	fi
	if [ "$assume_yes" != 1 ]; then
		have_tty || die "no terminal to confirm on; rerun with -y"
		printf 'Uninstall Argus? [y/N] '
		read -r ans <"$TTY"
		case $ans in y | Y | yes) ;; *) die "cancelled" ;; esac
	fi

	left=0
	if [ -n "$containers$network" ]; then
		run_step "remove the containers" remove_containers
		[ "$STEP_OK" = 1 ] || left=$((left + 1))
	fi
	for i in $images; do
		if ! docker rmi "$i" >/dev/null 2>&1; then
			say "argus: left image $i: a container still uses it, or Docker refused" >&2
			left=$((left + 1))
		fi
	done
	if [ -d "$root" ]; then
		run_step "remove $root" rm -rf "$root"
		[ "$STEP_OK" = 1 ] || left=$((left + 1))
	fi
	for vol in $volumes; do
		if ! docker volume rm "$vol" >/dev/null 2>&1; then
			say "argus: could not remove volume $vol" >&2
			left=$((left + 1))
		fi
	done
	# The config and the launcher go last, and only when the rest went: a second
	# `argus uninstall` needs them to finish the job.
	if [ "$left" != 0 ]; then
		die "uninstall left $left item(s) behind (above); kept $ARGUS_HOME and the launcher, so fix that and run \`argus uninstall\` again"
	fi
	if [ "$keep" = 0 ]; then
		rm -rf "$ARGUS_HOME"
		LOCK_OWNED=0
	fi
	rm -f "$self" "$self.prev"
	if [ "$keep" = 0 ]; then
		say "Uninstalled Argus."
	else
		say "Uninstalled Argus; the data stays. Run the install line and \`argus up\` to start it again."
	fi
}

cmd_status() {
	load_config
	[ "$HAVE_CONFIG" = 1 ] || {
		say "No install at $ARGUS_HOME; run \`argus up\`."
		return 0
	}
	say "Version:   $ARGUS_VERSION ($(image))"
	say "Config:    $CONF"
	if running; then
		ready=no
		curl -fsS -o /dev/null "http://127.0.0.1:$ARGUS_PORT/readyz" 2>/dev/null && ready=yes
		say "Container: $ARGUS_CONTAINER running, ready: $ready, http://127.0.0.1:$ARGUS_PORT"
		say "Backups:"
		docker exec "$ARGUS_CONTAINER" sh -c 'ls -1 /data/backups 2>/dev/null | tail -n 5' | sed 's/^/  /'
	else
		say "Container: $ARGUS_CONTAINER not running (\`argus up\`)"
	fi
	[ ! -d "$LOCK" ] || say "Lock:      held by pid $(cat "$LOCK/pid" 2>/dev/null || echo '?')"
}

cmd_token() {
	load_config
	[ "$HAVE_CONFIG" = 1 ] || die "no install found at $ARGUS_HOME; run \`argus up\` first"
	running || die "Argus is not running; run \`argus up\`"
	if t=$(docker exec "$ARGUS_CONTAINER" cat /data/admin-token 2>/dev/null) && [ -n "$t" ]; then
		say "$t"
	else
		die "no generated admin token; sign in with your existing or preset admin token"
	fi
}

cmd_unlock() {
	[ -d "$LOCK" ] || {
		say "Not locked."
		return 0
	}
	pid=$(cat "$LOCK/pid" 2>/dev/null || true)
	if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
		die "pid $pid is still running; not unlocking"
	fi
	rm -rf "$LOCK"
	say "Removed the stale lock (pid ${pid:-unknown})."
}

cmd=${1:-help}
[ $# -eq 0 ] || shift
case $cmd in
up) cmd_up "$@" ;;
update) cmd_update "$@" ;;
__apply-update) cmd_apply_update "$@" ;;
backup) cmd_backup ;;
restore) cmd_restore "$@" ;;
status) cmd_status ;;
token) cmd_token ;;
logs) load_config && exec docker logs "$@" "$ARGUS_CONTAINER" ;;
down)
	take_lock
	load_config
	stop_and_remove
	say "Stopped and removed $ARGUS_CONTAINER; data stays in volume $ARGUS_VOLUME."
	;;
unlock) cmd_unlock ;;
uninstall) cmd_uninstall "$@" ;;
worker) cmd_worker "$@" ;;
help | -h | --help) usage ;;
*)
	usage >&2
	exit 2
	;;
esac
