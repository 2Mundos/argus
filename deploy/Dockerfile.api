FROM node:22-slim AS dashboard
WORKDIR /src
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc tsconfig.base.json ./
COPY packages/api-client/package.json packages/api-client/
COPY apps/dashboard/package.json apps/dashboard/
RUN pnpm install --frozen-lockfile --filter "@argus/dashboard..."
COPY packages/api-client packages/api-client
COPY apps/dashboard apps/dashboard
RUN pnpm --filter @argus/dashboard build

FROM ghcr.io/astral-sh/uv:0.11.7-python3.12-trixie-slim AS build
WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
COPY pyproject.toml uv.lock ./
COPY apps/api apps/api
COPY packages/core packages/core
RUN uv sync --frozen --no-dev --package argus-api

FROM python:3.12-slim-trixie
WORKDIR /app
COPY --from=litestream/litestream:0.5.17 /usr/local/bin/litestream /usr/local/bin/litestream
# sops decrypts/encrypts the credentials file (age support is built in).
ADD --chmod=755 --checksum=sha256:e5bec3346a873ae91d871550f3e698c1aad962aff462a080e40f25fde17fef6b \
    https://github.com/getsops/sops/releases/download/v3.13.3/sops-v3.13.3.linux.amd64 \
    /usr/local/bin/sops
COPY deploy/litestream.yml /etc/litestream.yml
COPY deploy/entrypoint.sh /usr/local/bin/argus-entrypoint
COPY --from=build /app /app
COPY --from=dashboard /src/apps/dashboard/dist /app/dashboard
# Created in the image so a fresh named volume inherits nobody's ownership.
RUN mkdir /data && chown nobody:nogroup /data
ENV PATH="/app/.venv/bin:$PATH" ARGUS_DATA_DIR=/data ARGUS_DASHBOARD_DIR=/app/dashboard
VOLUME /data
USER nobody
EXPOSE 8000
ENTRYPOINT ["argus-entrypoint"]
CMD ["uvicorn", "argus_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
