FROM node:22-slim AS dashboard
WORKDIR /src
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc tsconfig.base.json ./
COPY packages/api-client/package.json packages/api-client/
COPY apps/dashboard/package.json apps/dashboard/
RUN pnpm install --frozen-lockfile --filter "@argus/dashboard..."
COPY packages/api-client packages/api-client
COPY apps/dashboard apps/dashboard
RUN pnpm --filter @argus/dashboard build

FROM ghcr.io/astral-sh/uv:0.11.7-python3.12-trixie-slim AS build
WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
COPY pyproject.toml uv.lock ./
COPY apps/api apps/api
COPY packages/core packages/core
RUN uv sync --frozen --no-dev --package argus-api

# One stage per architecture so each download keeps its own pinned checksum;
# `sops` below picks the one for the platform being built.
FROM scratch AS sops-amd64
ADD --checksum=sha256:e5bec3346a873ae91d871550f3e698c1aad962aff462a080e40f25fde17fef6b \
    https://github.com/getsops/sops/releases/download/v3.13.3/sops-v3.13.3.linux.amd64 /sops

FROM scratch AS sops-arm64
ADD --checksum=sha256:53b0abacd38ef1b12a66d6c100956691b9cefce018d91f81e73ddf7438b94d77 \
    https://github.com/getsops/sops/releases/download/v3.13.3/sops-v3.13.3.linux.arm64 /sops

ARG TARGETARCH
FROM sops-${TARGETARCH} AS sops

FROM python:3.12-slim-trixie
WORKDIR /app
COPY --from=litestream/litestream:0.5.17 /usr/local/bin/litestream /usr/local/bin/litestream
# sops decrypts/encrypts the credentials file (age support is built in); the
# binary matching the build platform comes from the stage selected below.
COPY --from=sops --chmod=755 /sops /usr/local/bin/sops
COPY deploy/litestream.yml /etc/litestream.yml
COPY deploy/entrypoint.sh /usr/local/bin/argus-entrypoint
COPY --from=build /app /app
COPY integrations/nanoclaw/engines/model-policy.defaults.json /app/integrations/nanoclaw/engines/
COPY --from=dashboard /src/apps/dashboard/dist /app/dashboard
# ssh: remote Docker targets (DOCKER_HOST=ssh://…). The data dir is created in the
# image so a fresh named volume inherits nobody's ownership.
RUN apt-get update && apt-get install -y --no-install-recommends openssh-client \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir /data && chown nobody:nogroup /data
# Set by the release workflow (docs/specs/releases.spec.md); last, so it never
# invalidates the layers above.
ARG ARGUS_VERSION=0.0.0+dev
ENV PATH="/app/.venv/bin:$PATH" ARGUS_DATA_DIR=/data ARGUS_DASHBOARD_DIR=/app/dashboard \
    ARGUS_VERSION=$ARGUS_VERSION
VOLUME /data
USER nobody
# Inside the container 0.0.0.0 is required for published ports to reach it; who can
# connect is decided by the publish address (`-p 127.0.0.1:8000:8000`), not here.
# uvicorn reads UVICORN_HOST, so the CMD stays plain argv (the Litestream entrypoint
# re-joins it into one string). Argus speaks plain HTTP: terminate TLS at a reverse
# proxy in front of it.
ENV UVICORN_HOST=0.0.0.0
EXPOSE 8000
ENTRYPOINT ["argus-entrypoint"]
CMD ["uvicorn", "argus_api.main:app", "--port", "8000"]
