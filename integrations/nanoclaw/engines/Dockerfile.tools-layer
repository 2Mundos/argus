# Argus tools layer for the NanoClaw agent image. The image built by NanoClaw is
# node:22-slim plus chromium: it has no ssh/rsync (so a worker cannot clone over
# ssh or sync files) and no Python toolchain (so a worker cannot run the gates of
# a Python repo, which is what makes a worker able to prove its own work instead
# of handing unverified code back). This layer adds both, carries the Argus bin
# assets (argus-delegate and its model policy) so an image built from any BASE
# gets the current ones, and fails the build if a required binary is missing.
# Built by apply-tools-layer.sh.
ARG BASE
FROM ${BASE}
USER root
RUN mkdir -p /etc/claude-code /usr/local/lib/argus/bin /usr/local/lib/argus/git-hooks /usr/local/lib/argus/pycpu \
 && chmod 755 /etc/claude-code /usr/local/lib/argus /usr/local/lib/argus/bin /usr/local/lib/argus/git-hooks /usr/local/lib/argus/pycpu
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      openssh-client rsync python3 python3-venv make ca-certificates curl \
 && rm -rf /var/lib/apt/lists/* \
 && for b in ssh ssh-keygen ssh-keyscan rsync git python3 make; do command -v "$b" || exit 1; done
# kubectl, pinned and checksum verified (integrations spec 3.6): the client for a
# task's opted-in Kubernetes integration. No kubeconfig ships in the image.
COPY --chmod=0755 install-kubectl.sh /tmp/install-kubectl.sh
RUN sh /tmp/install-kubectl.sh && rm -f /tmp/install-kubectl.sh && command -v kubectl
# uv as a standalone binary: no pip, no PEP 668 workarounds, same version for every image.
RUN curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR=/usr/local/bin UV_NO_MODIFY_PATH=1 sh \
 && command -v uv && uv --version
COPY --chmod=0644 anthropic-redirect.mjs /usr/local/bin/anthropic-redirect.mjs
COPY --chmod=0755 argus-delegate.mjs /usr/local/bin/argus-delegate
COPY --chmod=0644 account-settings.mjs model-policy.mjs model-policy.defaults.json milestones.mjs livelog.mjs changes.mjs usage.mjs gitea-api.mjs github-api.mjs /usr/local/bin/
COPY --chmod=0755 gitea-api.mjs /usr/local/bin/argus-gitea-api
COPY --chmod=0755 github-api.mjs /usr/local/bin/argus-github-api
# argus-task (docs/specs/task-helpers.spec.md) imports gitea-api.mjs and github-api.mjs beside it.
COPY --chmod=0755 argus-task.mjs /usr/local/bin/argus-task
# Command guard (docs/specs/command-guard.spec.md): a Claude Code PreToolUse hook
# registered in managed settings, which a project's own .claude settings cannot
# remove. The smoke fails the build if the guard does not block a known-bad command.
COPY --chmod=0644 command_guard.py commit_attribution.py repeat_guard.py /usr/local/lib/argus/
COPY --chmod=0644 claude-managed-settings.json /etc/claude-code/managed-settings.json
COPY --chmod=0755 probe-managed-settings.sh /usr/local/lib/argus/probe-managed-settings.sh
# The worker checks this file for the command guard hook before it starts a Claude task.
ENV ARGUS_CLAUDE_MANAGED_SETTINGS=/etc/claude-code/managed-settings.json
COPY --chmod=0755 argus-git /usr/local/lib/argus/bin/git
COPY --chmod=0755 git-hooks/commit-msg /usr/local/lib/argus/git-hooks/commit-msg
RUN echo '{"tool_name":"Bash","tool_input":{"command":"rm -rf /"}}' \
      | python3 /usr/local/lib/argus/command_guard.py | grep -q '"deny"' \
 && python3 /usr/local/lib/argus/commit_attribution.py validate-msg /etc/claude-code/managed-settings.json \
 && test -r /etc/claude-code/managed-settings.json \
 && test "$ARGUS_CLAUDE_MANAGED_SETTINGS" = /etc/claude-code/managed-settings.json \
 && /usr/local/lib/argus/probe-managed-settings.sh "$ARGUS_CLAUDE_MANAGED_SETTINGS" \
 && test -x /usr/local/lib/argus/bin/git \
 && test -x /usr/local/lib/argus/git-hooks/commit-msg
# Resource hygiene (docs/specs/agent-resource-hygiene.spec.md): BASH_ENV / CLAUDE_ENV_FILE shim for the
# harness's command shells, wired by patch-agent-resource-hygiene.py. pycpu/ is the PYTHONPATH directory.
COPY --chmod=0644 argus-oom-priority.sh argus-cpu-count.sh argus-cpu-count.cjs /usr/local/lib/argus/
COPY --chmod=0644 argus-cpu-count-sitecustomize.py /usr/local/lib/argus/pycpu/sitecustomize.py
USER node
LABEL dev.argus.tools-layer="openssh-client rsync python3 uv make kubectl argus-delegate model-policy command-guard argus-task"
