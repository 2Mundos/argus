      "post": {
        "operationId": "revoke_admin_token_admin_tokens__token_id__revoke_post",
        "parameters": [
          {
            "in": "path",
            "name": "token_id",
            "required": true,
            "schema": {
              "title": "Token Id",
              "type": "string"
            }
