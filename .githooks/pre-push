#!/usr/bin/env bash
# Local mirror of the Quality jobs, narrowed to what the push changed
# (`make check-changed`, full `make check` + `make build` when the merge base with
# origin/main is unknown or a lock file changed), plus the secret scan. CI still
# runs everything. Enable with `make hooks`; bypass with `git push --no-verify`.
#
# The checks run on the working tree, so it must be exactly the commit being pushed
# (clean, at HEAD). check-changed skips a rerun on the files that last passed; the
# secret scan runs on every push.
set -uo pipefail

zero=0000000000000000000000000000000000000000
head="$(git rev-parse HEAD)"
need=0
while read -r _ sha _ _; do
  [ "$sha" = "$zero" ] && continue # deleting a remote branch
  sha="$(git rev-parse "$sha^{commit}")" # an annotated tag counts as its commit
  if [ "$sha" != "$head" ] || [ -n "$(git status --porcelain)" ]; then
    echo "pre-push: checks run on the working tree; check out the pushed commit with a clean tree, or push with --no-verify" >&2
    exit 1
  fi
  need=1
done
[ "$need" = 1 ] || exit 0

failed=()
run() { echo "pre-push: $*"; "$@" || failed+=("$*"); }

run make check-changed
if command -v gitleaks >/dev/null; then
  run make secret-scan
else
  echo "pre-push: gitleaks not installed, skipping secret scan" >&2
fi

if [ "${#failed[@]}" -gt 0 ]; then
  printf 'pre-push: FAILED -> %s\n' "${failed[@]}" >&2
  exit 1
fi
