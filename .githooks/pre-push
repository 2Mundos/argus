#!/usr/bin/env bash
# Fast local mirror of the deterministic Quality jobs. Enable with `make hooks`;
# bypass with `git push --no-verify`.
set -uo pipefail
failed=()
run() { echo "pre-push: $*"; "$@" || failed+=("$*"); }

run make lint
if command -v gitleaks >/dev/null; then
  run make secret-scan
else
  echo "pre-push: gitleaks not installed, skipping secret scan" >&2
fi

if [ "${#failed[@]}" -gt 0 ]; then
  printf 'pre-push: FAILED -> %s\n' "${failed[@]}" >&2
  exit 1
fi
