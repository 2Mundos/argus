#!/usr/bin/env bash
# Local mirror of the Quality jobs, narrowed to what the push changed
# (`make check-changed`, full `make check` + `make build` when the merge base with
# origin/main is unknown or a lock file changed), plus the secret scan. CI still
# runs everything. Enable with `make hooks`; bypass with `git push --no-verify`.
#
# The checks run on the working tree, so it must be exactly the commit being pushed
# (clean, at HEAD). check-changed skips a rerun on the files that last passed; the
# secret scan runs on every push.
set -uo pipefail

zero=0000000000000000000000000000000000000000
head="$(git rev-parse HEAD)"
need=0
lang_ranges=()
while read -r _ sha _ remote_sha; do
  [ "$sha" = "$zero" ] && continue # deleting a remote branch
  sha="$(git rev-parse "$sha^{commit}")" # an annotated tag counts as its commit
  if [ "$sha" != "$head" ] || [ -n "$(git status --porcelain)" ]; then
    echo "pre-push: checks run on the working tree; check out the pushed commit with a clean tree, or push with --no-verify" >&2
    exit 1
  fi
  if [ "$remote_sha" = "$zero" ] || ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    remote_sha="$(git merge-base "$sha" origin/main 2>/dev/null || true)"
  fi
  if [ -z "$remote_sha" ]; then
    # No usable base (new branch, no origin/main): check the tip commit
    # rather than silently skipping the language gate.
    echo "pre-push: no base for the language gate on $sha; checking the last commit only" >&2
    remote_sha="$(git rev-parse "$sha~1" 2>/dev/null || true)"
  fi
  [ -n "$remote_sha" ] && lang_ranges+=(--range "$remote_sha..$sha")
  need=1
done
[ "$need" = 1 ] || exit 0

# Git exports GIT_DIR (and in a worktree GIT_INDEX_FILE and more) to hooks. Left
# set, every `git` a check runs, a test's `git init` in a temp dir included, acts
# on this repository (docs/postmortems/2026-11-04.pre-push-git-env.ref.md).
# shellcheck disable=SC2046
unset $(git rev-parse --local-env-vars)

failed=()
run() { echo "pre-push: $*"; "$@" || failed+=("$*"); }

# Commit messages are not in the changed-file list, so the language gate runs
# unconditionally over the push ranges (like the secret scan below).
if [ "${#lang_ranges[@]}" -gt 0 ]; then
  run python3 scripts/validate_language.py "${lang_ranges[@]}"
fi
run make check-changed
if command -v gitleaks >/dev/null; then
  run make secret-scan
else
  echo "pre-push: gitleaks not installed, skipping secret scan" >&2
fi

if [ "${#failed[@]}" -gt 0 ]; then
  printf 'pre-push: FAILED -> %s\n' "${failed[@]}" >&2
  exit 1
fi
